{
  "$id": "https://porta.dev/contracts/policies/policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conditions": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "enum": [
                  "probability",
                  "confidence",
                  "baseline_deviation_factor"
                ]
              },
              "op": {
                "enum": [
                  ">",
                  ">=",
                  "<",
                  "<=",
                  "=="
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "operator": {
          "enum": [
            "AND",
            "OR"
          ]
        }
      },
      "required": [
        "operator",
        "conditions"
      ],
      "type": "object"
    },
    "contract_name": {
      "const": "RegulationPolicy"
    },
    "cooldown_seconds": {
      "maximum": 86400,
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    },
    "created_by": {
      "$ref": "../shared/common-defs.schema.json#/$defs/nonEmptyString"
    },
    "dwell_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "fleet_scope": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "boolean"
        },
        "machine_ids": {
          "items": {
            "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
          },
          "maxItems": 5000,
          "type": "array",
          "uniqueItems": true
        },
        "tags": {
          "items": {
            "pattern": "^[a-z0-9_.-]{1,64}$",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "all",
        "machine_ids",
        "tags"
      ],
      "type": "object"
    },
    "hysteresis_config": {
      "additionalProperties": false,
      "properties": {
        "activate_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "deactivate_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "flap_window_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        },
        "max_flaps_per_window": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "activate_threshold",
        "deactivate_threshold",
        "flap_window_seconds",
        "max_flaps_per_window"
      ],
      "type": "object"
    },
    "interventions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "level": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          },
          "max_duration_seconds": {
            "maximum": 86400,
            "minimum": 1,
            "type": "integer"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object"
          },
          "type": {
            "enum": [
              "notify",
              "reduce_load",
              "restart_service",
              "isolate_component",
              "escalate_to_human",
              "pause_agent"
            ]
          }
        },
        "required": [
          "type",
          "level",
          "max_duration_seconds",
          "parameters"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "override_permissions": {
      "items": {
        "enum": [
          "owner",
          "admin",
          "operator",
          "analyst",
          "viewer"
        ]
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "policy_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "policy_name": {
      "$ref": "../shared/common-defs.schema.json#/$defs/nonEmptyString"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9+/=._-]{32,4096}$",
      "type": "string"
    },
    "target_state": {
      "enum": [
        "stable",
        "elevated_risk",
        "degrading",
        "critical",
        "recovering"
      ]
    },
    "version": {
      "$ref": "../shared/common-defs.schema.json#/$defs/semver"
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "policy_id",
    "policy_name",
    "version",
    "target_state",
    "conditions",
    "interventions",
    "hysteresis_config",
    "cooldown_seconds",
    "dwell_seconds",
    "override_permissions",
    "fleet_scope",
    "created_by",
    "created_at",
    "signature"
  ],
  "title": "RegulationPolicy",
  "type": "object"
}
