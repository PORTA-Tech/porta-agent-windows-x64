<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.2.155</Version>
    <AssemblyVersion>1.2.155.0</AssemblyVersion>
    <FileVersion>1.2.155.0</FileVersion>
    <InformationalVersion>1.2.155</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!--
      CS8509 = a switch expression does not handle every NAMED enum value. Promoted to an ERROR so
      that adding a UserCheckInKind cannot silently fall through a `_` arm into another card's
      per-day mute class (see UserCheckInScheduler.MuteClassFor). The project had no CS8509 warnings
      when this was turned on, so it costs nothing today and catches a real bug tomorrow.

      CS8524 is the sibling warning for values OUTSIDE the named set — an arbitrary int cast to the
      enum. Suppressed, because the only way to silence it is to add back the `_` arm, and that arm
      is precisely the bug being removed: with a `_` present, CS8509 can never fire again.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Porta.Agent.Common\Porta.Agent.Common.csproj" />
    <ProjectReference Include="..\Porta.Agent.LocalApi\Porta.Agent.LocalApi.csproj" />
    <ProjectReference Include="..\Porta.Agent.Runtime\Porta.Agent.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

</Project>
