                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="WhyDrawerBackdrop"
              Grid.ColumnSpan="2"
              Grid.RowSpan="2"
              Background="#6B020617"
              Visibility="Collapsed"
              Panel.ZIndex="190"
              MouseLeftButtonDown="WhyDrawerBackdrop_MouseLeftButtonDown" />

        <Border x:Name="WhyDrawerPanel"
                Grid.Column="1"
                Grid.RowSpan="2"
                Width="300"
                HorizontalAlignment="Right"
                Margin="0,8,8,8"
                Padding="12"
                Background="#15181C"
                BorderBrush="#303743"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed"
                Panel.ZIndex="200"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right"
                                Content="&#x2715;"
                                MinWidth="32"
                                Width="32"
                                Height="32"
                                Padding="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                Foreground="#94A3B8"
                                BorderBrush="{DynamicResource PortaCardBorderBrush}"
                                BorderThickness="1"
                                ToolTip="Close"
                                Click="WhyDrawerCloseButton_Click" />
                        <TextBox Style="{StaticResource SelectableText}" Text="What's pushing your pressure?"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PortaTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>

                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerStateText"
                               Text="State: Not available"
                               Foreground="#94A3B8"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerConfidenceText"
                               Text=""
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Border BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerFivText"
                               Text=""
                               Foreground="#94A3B8"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerContributorsText"
                               Text=""
                               Foreground="#94A3B8"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <!-- Keep these hidden - needed for code compatibility -->
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerTitleText" Visibility="Collapsed" Text="" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerPolicyText" Visibility="Collapsed" Text="" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerCooldownText" Visibility="Collapsed" Text="" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerActionStateText" Visibility="Collapsed" Text="" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerContributorsSummaryText" Visibility="Collapsed" Text="" />
                    <TextBox Style="{StaticResource SelectableText}" x:Name="WhyDrawerWhySummaryText" Visibility="Collapsed" Text="" />
                </StackPanel>
            </ScrollViewer>

        </Border>

        <Grid x:Name="OnboardingOverlay"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Background="#CC020617"
              Visibility="Collapsed"
              Panel.ZIndex="170">
            <Grid>
                <Border Width="920"
                        MaxWidth="920"
                        Padding="24"
                        CornerRadius="16"
                        Background="#111827"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox Style="{StaticResource SelectableText}" Text="Ari Runs In The Background"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <TextBox Style="{StaticResource SelectableText}" Text="Control Center is optional. Ari keeps tracking, evaluating, and regulating after you close this window, as long as the background service and desktop session stay connected."
                                       Foreground="#CBD5E1"
                                       Margin="0,0,0,18"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#0B1220"
                                        BorderBrush="#1F2937"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" Text="How Ari works on this PC"
                                                   Foreground="#93C5FD"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="- Background runtime: AriAgent service + the live desktop session agent keep tracking active in the background."
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="- Today shows Work today, Last focus session, and Pressure."
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="- Tracking explains privacy, controls, and what improves tracking quality."
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="- Confidence tells you how sure Ari is. Tracking quality tells you how complete today's signals are."
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="- System is where you check service, desktop session, recovery, and last errors."
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="- Reopen Ari: Start Menu > Ari, the desktop shortcut, or the Ari tray icon."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#0B1220"
                                        BorderBrush="#1F2937"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" Text="What Ari sees right now"
                                                   Foreground="#93C5FD"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10" />
                                        <TextBox Style="{StaticResource SelectableText}" x:Name="OnboardingCurrentStatusText"
                                                   Text="Checking background tracking..."
                                                   Foreground="{DynamicResource PortaTextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <TextBox Style="{StaticResource SelectableText}" x:Name="OnboardingCurrentSystemText"
                                                   Text="System check: waiting for the service, desktop session, and current tracking status."
                                                   Foreground="#CBD5E1"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />
                                        <TextBox Style="{StaticResource SelectableText}" x:Name="OnboardingCurrentGuidanceText"
                                                   Text="If tracking quality looks limited, Ari keeps trying to recover in the background. Open Tracking to review quality, or System if recovery stays stuck."
                                                   Foreground="#FCA5A5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{DynamicResource PortaSurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource PortaCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="If tracking quality looks limited"
                                               Foreground="#FCA5A5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Keep using the keyboard or mouse for a few seconds while Ari retries."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Open Tracking to review consent, privacy, and what improves tracking quality."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- If Today still stays at zero, open System and check the Service, Desktop session, and Last error cards."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- If the desktop session does not recover, sign out and back in to Windows."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <WrapPanel>
                                <Button Content="Open System"
                                        Padding="14,8"
                                        Margin="0,0,10,0"
                                        Click="OnboardingOpenSystemButton_Click" />
                                <Button Content="Got it"
                                        Padding="14,8"
                                        Click="OnboardingDismissButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="UpdateOverlay"
              Grid.Row="1"
              Grid.Column="1"
              Background="Transparent"
              Visibility="Collapsed"
              Panel.ZIndex="180"
              IsHitTestVisible="False">
            <Border Width="300"
                    MaxWidth="300"
                    MaxHeight="340"
                    Padding="18"
                    CornerRadius="12"
                    Background="#F4111825"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,74,16,0"
                    IsHitTestVisible="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBox Style="{StaticResource SelectableText}" x:Name="UpdateOverlayTitleText" Text="Ari update ready" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource SelectableText}" x:Name="UpdateOverlayVersionText" Text="Current version Not available" Foreground="#93C5FD" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource SelectableText}" x:Name="UpdateOverlaySummaryText" Text="A newer Windows build is available for this machine." Foreground="#E5E7EB" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource SelectableText}" x:Name="UpdateOverlayStatusText" Text="App updates are checked automatically when a release is published." Foreground="#94A3B8" Margin="0,0,0,14" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="UpdateOverlayInstallButton"
                                    Content="Download and install"
                                    Padding="14,8"
                                    Margin="0,0,8,8"
                                    Click="AccountInstallUpdateButton_Click" />
                            <Button x:Name="UpdateOverlayLaterButton"
                                    Content="Later"
                                    Padding="12,8"
                                    Margin="0,0,0,8"
                                    Click="AccountDismissUpdateButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="ConsentOverlay"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#CC020617"
                Visibility="Collapsed">
            <Grid>
                <Border Width="820" Padding="24" CornerRadius="12" Background="#111827" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBox Style="{StaticResource SelectableText}" Text="PORTA Needs Consent" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox Style="{StaticResource SelectableText}" Text="Collection, inference, and regulation are OFF until you click I Agree." Foreground="#FCA5A5" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Collected (aggregated only)" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Keystroke timing intervals (events/min)" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Mouse acceleration index" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Scroll velocity index" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Focus switch frequency" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Idle fragmentation" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Notification reaction latency" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Never Collected" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Typed text" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Clipboard content" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Screenshots" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Files and file contents" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Messages" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="- Network content" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBox Style="{StaticResource SelectableText}" Text="Retention window: 90 days local SQLite (configurable in later settings)." Margin="0,0,0,14" />
                        <WrapPanel>
                            <Button Content="I Agree" Padding="14,8" Margin="0,0,10,0" Click="AgreeConsentButton_Click" />
                            <Button Content="Pause" Padding="12,8" Margin="0,0,10,0" Click="PauseButton_Click" />
                            <Button Content="Revoke" Padding="12,8" Margin="0,0,10,0" Click="RevokeConsentButton_Click" />
                            <Button Content="Export Data" Padding="12,8" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                            <Button Content="Delete Local Data" Padding="12,8" Click="DeleteLocalDataButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>



















