                                <TextBlock x:Name="AccountStatusText" Text="Sign in to view your account, workspace, and devices." Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Border x:Name="AccountUpdateBanner" Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="AccountUpdateTitleText" Text="Ari update ready" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6" />
                                        <TextBlock x:Name="AccountUpdateBodyText" Text="A new Windows build is available for this PC." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock x:Name="AccountUpdateStatusText" Text="App updates are checked automatically when a release is published." Foreground="#94A3B8" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="AccountInstallUpdateButton"
