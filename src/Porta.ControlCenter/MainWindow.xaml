                                    CornerRadius="10"
                                    Padding="16,14,16,14"
                                    Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="WORK TODAY"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#94A3B8" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowOverloadValueText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PortaTextPrimaryBrush}" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowOverloadActiveText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowOverloadTrustText" Text="" Margin="0,3,0,0" Visibility="Collapsed"
                                               FontSize="12" Foreground="#94A3B8" />
                                    <Border x:Name="WorkTodayTrack" Height="4" CornerRadius="2" Background="{DynamicResource PortaDividerBrush}" Margin="0,8,0,6">
                                        <Border x:Name="WorkTodayProgressFill" Background="#475569" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <!-- View History link — bottom-right, only interactive element -->
                                    <DockPanel LastChildFill="False">
                                        <TextBox Style="{StaticResource SelectableText}" DockPanel.Dock="Right"
                                                   Text="View History →"
                                                   FontSize="11" Foreground="#94A3B8"
                                                   Cursor="Hand"
                                                   MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                                   Tag="today-work" />
                                    </DockPanel>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowOverloadSummaryText" Visibility="Collapsed"
                                               Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Focus Score — no link, no click -->
                            <Border x:Name="NowFocusCard"
                                    Background="{DynamicResource PortaCardBrush}"
                                    BorderBrush="#6616C784"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14,16,14"
                                    Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="FOCUS SCORE"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#16C784" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowFocusStreakValueText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#16C784" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowDeepWorkStreakText" Text="" Margin="0,5,0,0"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#16C784" Visibility="Collapsed" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowFocusChoppinessText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#94A3B8" Visibility="Collapsed" />
                                    <Border x:Name="FocusScoreTrack" Height="4" CornerRadius="2" Background="{DynamicResource PortaDividerBrush}" Margin="0,8,0,0">
                                        <Border x:Name="FocusScoreProgressFill" Background="#16C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowFocusSummaryText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowFocusFootnoteText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowFocusStatusText" Visibility="Collapsed" Text="" Foreground="{DynamicResource PortaWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Pressure — no link, no click -->
                            <Border x:Name="NowCalibrationCard"
                                    Background="{DynamicResource PortaCardBrush}"
                                    BorderBrush="#66F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14,16,14"
                                    Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="PRESSURE"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#F59E0B" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowCalibrationStatusText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#16C784" />
                                    <!-- NowCalibrationProgressText hidden — "Regulation · normal" is developer text -->
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowCalibrationProgressText" Text="" Visibility="Collapsed"
                                               FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowCalibrationQualityText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#94A3B8" />
                                    <Border x:Name="PressureTrack" Height="4" CornerRadius="2" Background="{DynamicResource PortaDividerBrush}" Margin="0,8,0,0">
                                        <Border x:Name="PressureProgressFill" Background="#94A3B8" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowCalibrationColdStartText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowCalibrationSummaryText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="NowCalibrationTrustCapText" Visibility="Collapsed" Text="Analysis catching up." Foreground="{DynamicResource PortaWarningBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <!-- Supporting cards hidden — only 3 metric cards shown -->
                        <StackPanel Visibility="Collapsed">
                            <Border x:Name="CurrentSessionCard">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="CurrentSessionValueText" Text="—" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="CurrentSessionSubText" Text="" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DistractionsCard">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="DistractionsValueText" Text="—" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="DistractionsSubText" Text="" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Session timeline -->
                        <TextBox Style="{StaticResource SelectableText}" Text="SESSION TIMELINE — TODAY"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,16" />
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="0,0,0,20">
                            <StackPanel>
                                <Grid x:Name="SessionTimelineBar" Height="22">
                                    <Border Background="#252535" CornerRadius="4" />
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Border CornerRadius="4" Background="#1416C784" BorderBrush="#2216C784" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBox Style="{StaticResource SelectableText}" Text="Focus" Foreground="#16C784" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#148B5CF6" BorderBrush="#228B5CF6" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBox Style="{StaticResource SelectableText}" Text="Distraction" Foreground="#8B5CF6" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#143B82F6" BorderBrush="#223B82F6" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBox Style="{StaticResource SelectableText}" Text="Away" Foreground="#3B82F6" FontSize="11" />
                                    </Border>
                                                                    </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- Quick action buttons -->
                        <WrapPanel Margin="0,24,0,24">
                            <Border CornerRadius="6" Background="Transparent" BorderBrush="#334155" BorderThickness="1"
                                    Padding="10,7" Margin="0,0,10,0" Cursor="Hand"
                                    MouseLeftButtonUp="WhyDrawerToggleButton_Click">
                                <TextBox Style="{StaticResource SelectableText}" Text="What's pushing my pressure? ↗" FontSize="13" FontWeight="Medium" Foreground="#94A3B8" /></Border>
                        </WrapPanel>
                        <TextBox Style="{StaticResource SelectableText}" x:Name="NowWaitingDataText"
                                   Text="Waiting for service data"
                                   Foreground="#9AA4B2"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                        <Border x:Name="NowRecoveryBannerBorder"
                                Background="#102019"
                                BorderBrush="{DynamicResource PortaCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="NowRecoveryDismissButton"
                                        DockPanel.Dock="Right"
                                        Content="Dismiss"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        MinHeight="28"
                                        Click="NowRecoveryDismissButton_Click" />
                                <TextBox Style="{StaticResource SelectableText}" x:Name="NowRecoveryBannerText"
                                           Text=""
                                           Foreground="#7FD1A3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBox Style="{StaticResource SelectableText}" x:Name="UpdatedValue" Margin="0,10,0,0" Foreground="#94A3B8" Text="" Visibility="Collapsed" />
                        <TextBox Style="{StaticResource SelectableText}" x:Name="DebugFooterText" Margin="0,6,0,0" Foreground="#F59E0B" FontFamily="Consolas" FontSize="11" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="InputsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              IsManipulationEnabled="True" PanningMode="VerticalOnly">
                    <StackPanel Margin="20,20,20,32">
                        <!-- hidden compat -->
                        <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingCollectionSummaryText" Visibility="Collapsed" Text="" />

                        <!-- Page header -->
                        <TextBox Style="{StaticResource SelectableText}" Text="Tracking" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PortaTextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource SelectableText}" Text="See exactly what Ari monitors and how your data is protected."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,0,0,24" />

                        <!-- ══ SECTION 1: What Ari observes (open by default) ══ -->
                        <Border x:Name="TrackingNavObserves"
                                Style="{StaticResource ClickableAccordionStyle}"
                                Padding="12,12,0,12" Margin="0"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Observes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#1216C784"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zm11 5a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableText}" Text="What Ari observes" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Keyboard, mouse and app activity signals" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingChevronObserves" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentObserves"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="16,0,0,12" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zm4 3h1m3 0h1m3 0h1m3 0h1M6 13h12"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Keyboard rhythm" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="How active typing is — never what you typed" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M12 3c3.3 0 6 2.7 6 6v6c0 3.3-2.7 6-6 6s-6-2.7-6-6V9c0-3.3 2.7-6 6-6zm0 3v5"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Mouse movement" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Movement, scrolling and pace — never screen content" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M4 4h6v8H4zm10 0h6v4h-6zm0 8h6v8h-6zM4 16h6v4H4z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="App switching" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Which apps are active — identifiers hashed before storage" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M6 5h2v14H6zm10 0h2v14h-2z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Activity gaps" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="When you step away or pause — not why" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <!-- ══ SECTION 2: What Ari never collects ══ -->
                        <Border x:Name="TrackingNavNeverCollects"
                                Style="{StaticResource ClickableAccordionStyle}"
                                Padding="12,12,0,12" Margin="0"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="NeverCollects">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#12EF4444"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M18 6L6 18M6 6l12 12"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableText}" Text="What Ari never collects" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Your messages, screenshots and personal content" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingChevronNeverCollects" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentNeverCollects"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="8,0,8,4" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Border BorderBrush="Transparent" BorderThickness="0" Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBox Style="{StaticResource SelectableText}" Text="Typed words or message content" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="Transparent" BorderThickness="0" Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBox Style="{StaticResource SelectableText}" Text="Screenshots or screen recordings" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="Transparent" BorderThickness="0" Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBox Style="{StaticResource SelectableText}" Text="Clipboard contents" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBox Style="{StaticResource SelectableText}" Text="Microphone or camera data" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ══ SECTION 3: Tracking quality ══ -->
                        <Border x:Name="TrackingNavQuality"
                                Style="{StaticResource ClickableAccordionStyle}"
                                Padding="12,12,0,12" Margin="0"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Quality">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#126366F1"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#6366F1" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M18 20V10M12 20V4M6 20v-6"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableText}" Text="Tracking quality" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="How accurately Ari understands your patterns" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingChevronQuality" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentQuality"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="16,0,0,12" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <!-- Quality bar — no orange pill -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Signal quality" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingQualityChipText" Grid.Column="1"
                                               Text="" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="6" CornerRadius="3" Background="#252535" Margin="0,0,0,14">
                                    <Border x:Name="TrackingQualityProgressFill" Background="#6366F1" CornerRadius="3"
                                            HorizontalAlignment="Left" Width="60" Height="6"/>
                                </Border>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingQualityHeadlineText"
                                           Text="Tracking quality is updating."
                                           FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}" FontSize="14" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingQualitySummaryText"
                                           Text="Ari needs a little more recent activity before it can describe your patterns clearly."
                                           Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingQualityHelpText"
                                           Text="Best results come from a normal signed-in desktop session with a few seconds of keyboard or mouse activity."
                                           Foreground="#94A3B8" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Stay in your session" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Tracking works best when Ari is attached to your signed-in desktop session." Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0" Margin="8,0">
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Give it a few seconds" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="A short stretch of keyboard or mouse activity helps Ari confirm the current session." Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" BorderThickness="0" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Keep consent on" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="If consent is revoked or tracking is paused, Ari stops collecting until you turn it back on." Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- ══ SECTION 4: Privacy control ══ -->
                        <Border x:Name="TrackingNavPrivacy"
                                Style="{StaticResource ClickableAccordionStyle}"
                                Padding="12,12,0,12" Margin="0"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Privacy">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#128B5CF6"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#8B5CF6" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm3-8V7a4 4 0 0 0-8 0v3"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableText}" Text="Privacy control" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Consent, privacy mode and active controls" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingChevronPrivacy" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentPrivacy"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="16,0,0,12" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Style="{StaticResource SelectableText}" Grid.Row="0" Grid.Column="0" Text="Consent" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingConsentValue" Grid.Row="0" Grid.Column="1" Text="Not available" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                    <TextBox Style="{StaticResource SelectableText}" Grid.Row="1" Grid.Column="0" Text="Privacy mode" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingPrivacyValue" Grid.Row="1" Grid.Column="1" Text="Not available" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBox Style="{StaticResource SelectableText}" Grid.Row="2" Grid.Column="0" Text="Active controls" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingControlsValue" Grid.Row="2" Grid.Column="1" Text="Not available" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Open Settings" Padding="12,7" Margin="0,0,10,0" Click="SettingsNavButton_Click"/>
                                    <Button x:Name="TrackingPauseResumeButton" Content="Pause tracking" Padding="12,7" Margin="0,0,10,0" Click="QuickPauseResumeButton_Click"/>
                                    <Button Content="Revoke consent" Padding="12,7" Click="RevokeConsentFromSettingsButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ══ SECTION 5: Your data ══ -->
                        <Border x:Name="TrackingNavData"
                                Style="{StaticResource ClickableAccordionStyle}"
                                Padding="12,12,0,12" Margin="0"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Data">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#123B82F6"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#3B82F6" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M4 6h16M4 10h16M4 14h10"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableText}" Text="Your data" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="Storage, retention and export options" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TrackingChevronData" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentData"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="16,0,0,12" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="RetentionWindowValue" Text="Stored on this device: Not available" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource SelectableText}" x:Name="RetentionSizeValue" Text="Local storage used: Not available" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,16"/>
                                <WrapPanel>
                                    <Button Content="Export Data" Padding="12,7" Margin="0,0,10,0" Click="ExportDataButton_Click"/>
                                    <Button Content="Delete Local Data" Padding="12,7" Click="DeleteLocalDataButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InterventionsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              IsManipulationEnabled="True"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="20,20,20,32">

                        <TextBox Style="{StaticResource SelectableText}" Text="Ari's actions" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PortaTextPrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Three summary cards -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="{DynamicResource PortaCardBrush}" BorderBrush="#666366F1" BorderThickness="1" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="SUGGESTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsCardSuggestionsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,4,0,0" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsCardSuggestionsRecent" Text="None yet" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8" />
                                    <Border x:Name="ActionsCardSuggestionsTrack" Height="3" CornerRadius="2" Background="#252535">
                                        <Border x:Name="ActionsCardSuggestionsBarFill" Background="#6366F1" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="3" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PortaCardBrush}" BorderBrush="#6616C784" BorderThickness="1" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="ACTIONS TAKEN" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsCardActionsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#16C784" Margin="0,4,0,0" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsCardActionsRecent" Text="None yet" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8" />
                                    <Border x:Name="ActionsCardActionsTrack" Height="3" CornerRadius="2" Background="#252535">
                                        <Border x:Name="ActionsCardActionsBarFill" Background="#16C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="3" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PortaCardBrush}" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="10" Padding="16,14,16,14">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="ALERTS" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsCardAlertsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                    <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsCardAlertsRecent" Text="None yet" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8" />
                                    <Border x:Name="ActionsCardAlertsTrack" Height="3" CornerRadius="2" Background="#252535">
                                        <Border x:Name="ActionsCardAlertsBarFill" Background="#F59E0B" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="3" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Unified event feed -->
                        <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsEmptyState"
                                   Text="Ari hasn't taken any actions yet."
                                   FontSize="13" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="ActionsUnifiedFeed" />

                        <!-- LEGACY ELEMENTS — code-behind compat, never visible -->
                        <StackPanel Visibility="Collapsed">
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsSummaryLeadText" Text="" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsTotalCountText" Text="0" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ActionsLastSeenText" Text="" />
