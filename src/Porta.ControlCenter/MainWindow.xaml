                                        Padding="12"
                                        Background="#0F1319"
                                        BorderBrush="#2E3641"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" Text="Versions"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PortaTextSecondaryBrush}"
                                                   Margin="0,0,0,10" />
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SelectableText}" Text="Agent"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                                <TextBox Style="{StaticResource SelectableText}" x:Name="AgentVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SelectableText}" Text="UI"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                                <TextBox Style="{StaticResource SelectableText}" x:Name="UiVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SelectableText}" Text="Schema"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                                <TextBox Style="{StaticResource SelectableText}" x:Name="SchemaVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPanel"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              IsManipulationEnabled="True"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="OverviewPanel_PreviewMouseWheel">
                    <StackPanel Margin="20,24,20,0">
                        <!-- Greeting row hidden — Ari bubble replaces it; state chip removed as redundant with widget -->
                        <StackPanel Visibility="Collapsed">
                            <TextBox Style="{StaticResource SelectableText}" x:Name="TodayGreetingText" Text="Good morning" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="TodayDateText" />
                            <Border x:Name="TodayStateChipBorder">
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TodayStateChipText" Text="● Focused now" />
                            </Border>
                        </StackPanel>
                        <!-- Ari bubble -->
                        <Border Background="{DynamicResource PortaBubbleBrush}"
                                BorderBrush="{DynamicResource PortaDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBox Style="{StaticResource SelectableText}" Text="● ARI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#16C784"
                                           Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource SelectableText}" x:Name="TodaySummaryText"
                                           Text="Today keeps work, last focus session, and pressure synced with the widget."
