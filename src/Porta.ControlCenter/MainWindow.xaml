                                            <TextBox Style="{StaticResource SelectableText}" Text="ENGINE HEALTH" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
