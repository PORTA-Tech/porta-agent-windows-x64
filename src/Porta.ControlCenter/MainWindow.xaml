                                    MinWidth="102"
                                    ToolTip="Agent, UI, and schema versions"
                                    Click="VersionsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource SelectableText}" Text="Versions"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="&#xE70D;"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="VersionsPopup"
                                   PlacementTarget="{Binding ElementName=VersionsButton}"
