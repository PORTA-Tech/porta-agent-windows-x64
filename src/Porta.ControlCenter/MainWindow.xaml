                                <Border x:Name="AccountSubscriptionSectionPanel" Grid.Column="0" Background="Transparent" BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,0,0,16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SUBSCRIPTION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,12" />
                                        <TextBlock x:Name="AccountPlanTierValue" Visibility="Collapsed" />
                                        <TextBlock x:Name="AccountSubscriptionStatusValue" Visibility="Collapsed" />
