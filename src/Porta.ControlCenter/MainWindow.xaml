
<Window x:Class="Porta.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PORTA"
        Height="750"
        Width="1100"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F1114"
        Foreground="#E6E9ED"
        FontFamily="Segoe UI Variable, Segoe UI, Inter">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PortaSurfaceBaseBrush" Color="#15181C" />
        <SolidColorBrush x:Key="PortaSurfaceElevatedBrush" Color="#1B1F25" />
        <SolidColorBrush x:Key="PortaSurfaceHoverBrush" Color="#1D232A" />
        <SolidColorBrush x:Key="PortaBorderBrush" Color="#262B33" />
        <SolidColorBrush x:Key="PortaBorderHoverBrush" Color="#3A4656" />
        <SolidColorBrush x:Key="PortaTextPrimaryBrush" Color="#E6E9ED" />
        <SolidColorBrush x:Key="PortaTextSecondaryBrush" Color="#9AA4B2" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PortaTextPrimaryBrush}" />
            <Setter Property="Background" Value="#1A1F26" />
            <Setter Property="BorderBrush" Value="{StaticResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#161B22" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1D2127" />
            <Setter Property="BorderBrush" Value="#2A3038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E6E9ED" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QuietHoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PortaSurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietHoverSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietHoverSubCardCompactStyle" TargetType="Border" BasedOn="{StaticResource QuietHoverSubCardStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="RoundedInputChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PortaTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="#12161B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A61E2E" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#821625" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0B0E12" BorderBrush="#20252D" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBarRoot" MouseLeftButtonDown="TitleBarRoot_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="172" Height="28" CornerRadius="7" ClipToBounds="True" BorderBrush="#1F3A46" BorderThickness="1" Background="#081014" Margin="0,0,12,0">
                        <Image Source="Assets/PortaBrandBanner.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="PORTA"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PortaTextPrimaryBrush}" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TitleBarMinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMinimizeButton_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMaximizeButton_Click">
                        <TextBlock x:Name="TitleBarMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarCloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="TitleBarCloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#0C0E11" BorderBrush="#262B33" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <Border Height="96" Margin="0,0,0,20" CornerRadius="14" ClipToBounds="True" BorderBrush="#1F3A46" BorderThickness="1" Background="#081014">
                    <Image Source="Assets/PortaBrandBanner.png" Stretch="UniformToFill" />
                </Border>
                <Button x:Name="OverviewNavButton" Content="Now" Margin="0,0,0,8" Padding="10,8" Click="OverviewNavButton_Click" />
                <Button x:Name="TimelineNavButton" Content="History" Margin="0,0,0,8" Padding="10,8" Click="TimelineNavButton_Click" />
                <Button x:Name="InterventionsNavButton" Content="Actions" Margin="0,0,0,8" Padding="10,8" Click="InterventionsNavButton_Click" />
                <Button x:Name="InputsNavButton" Content="What I Track" Margin="0,0,0,8" Padding="10,8" Click="InputsNavButton_Click" />
                <Button x:Name="StatesNavButton" Content="How It Decides" Margin="0,0,0,8" Padding="10,8" Click="StatesNavButton_Click" />
                <Button x:Name="SettingsNavButton" Content="Controls" Margin="0,0,0,8" Padding="10,8" Click="SettingsNavButton_Click" />
                <Button x:Name="AccountNavButton" Content="Account" Margin="0,0,0,8" Padding="10,8" Click="AccountNavButton_Click" />
                <Button x:Name="DiagnosticsNavButton" Content="Health" Margin="0,0,0,0" Padding="10,8" Click="DiagnosticsNavButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#15181C" BorderBrush="#262B33" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False" Margin="16,10">
                    <TextBlock x:Name="SectionTitleText" Text="Now" DockPanel.Dock="Left" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Border x:Name="StatusPillBorder" CornerRadius="12" Background="#1D4ED8" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="StatusPillText" Text="Running" FontWeight="Bold" />
                    </Border>
                    <Border x:Name="ConsentBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="ConsentBadgeText" Text="Consent: Needed" />
                    </Border>
                    <Border x:Name="CalibrationBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="CalibrationBadgeText" Text="Calibration: Bootstrapping" />
                    </Border>
                    <Border x:Name="TrustBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TrustBadgeText" Text="Trust: Low" />
                    </Border>
                    <Button x:Name="WhyDrawerToggleButton" Content="Why" Padding="12,6" Margin="0,0,10,0" Click="WhyDrawerToggleButton_Click" />
                    <Button x:Name="QuickPauseResumeButton" Content="Pause" Padding="12,6" Margin="0,0,10,0" Click="QuickPauseResumeButton_Click" />
                    <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6" Margin="0,0,10,0" Click="RefreshButton_Click" />
                    <Menu Background="Transparent" Foreground="#E2E8F0" VerticalAlignment="Center">
                        <MenuItem Header="Versions">
                            <MenuItem x:Name="AgentVersionMenuItem" Header="Agent: Not available" IsEnabled="False" />
                            <MenuItem x:Name="UiVersionMenuItem" Header="UI: Not available" IsEnabled="False" />
                            <MenuItem x:Name="SchemaVersionMenuItem" Header="Schema: Not available" IsEnabled="False" />
                        </MenuItem>
                    </Menu>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="What's happening, how sure are you, and why?"
                                   Foreground="#9AA4B2"
                                   FontSize="13"
                                   Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Overload" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowOverloadValueText" Text="Overload: Not available" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="NowOverloadActiveText" Text="Active: Not available" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowOverloadTrustText" Text="Trust level: Not available" Margin="0,4,0,8" />
                                    <Expander Header="Why?" Margin="0,4,0,0" Foreground="#E2E8F0">
                                        <Border Background="#1B1F25" BorderBrush="#262B33" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Signals behind overload" FontSize="12" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBlock x:Name="NowOverloadFivText" Text="Explain not available (backend field missing)." TextWrapping="Wrap" Foreground="#E2E8F0" />
                                                <TextBlock x:Name="NowOverloadTopReasonsText" Text="Top reasons: Not available" TextWrapping="Wrap" Foreground="#CBD5E1" Margin="0,8,0,0" />
                                                <TextBlock x:Name="NowOverloadQualityAgreementText" Text="Quality: Not available | Agreement: Not available" Foreground="#CBD5E1" Margin="0,8,0,0" />
                                                <TextBlock Text="Turns ON after 60s above 72%" Margin="0,8,0,0" Foreground="#93C5FD" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Focus streak" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowFocusStreakValueText" Text="Focused time: Not available" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="NowDeepWorkStreakText"
                                               Text=""
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource PortaTextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="NowFocusChoppinessText" Text="Choppiness: Not available" Margin="0,8,0,0" />
                                    <TextBlock x:Name="NowFocusFootnoteText" Text="Short pauses and quick app checks do not break the streak." Margin="0,8,0,0" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusStatusText" Text="" Margin="0,6,0,0" Foreground="#F59E0B" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Calibration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowCalibrationStatusText" Text="Bootstrapping" FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="NowCalibrationProgressText" Text="Progress: Not available" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowCalibrationQualityText" Text="Recent data quality: Not available (last 2 min)" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCalibrationColdStartText" Text="Stage: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCalibrationTrustCapText" Text="Trust is capped until enough baseline data accumulates." Foreground="#FB923C" Margin="0,8,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Data quality" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowDataQualityScoreText" Text="Quality score: Not available" FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="NowDataQualityPartialText" Text="Partial data: Not available" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowDataQualityMissingText" Text="" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Engine health" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowEngineStatusText" Text="Status: Not available" FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="NowEngineServiceText" Text="Service: Not available" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowEngineDatabaseText" Text="Database: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowEngineSnapshotText" Text="Snapshot: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowEnginePolicyText" Text="Policy: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowEngineWarningText"
                                               Text="Engine status unavailable."
                                               Margin="0,8,0,0"
                                               Foreground="#F59E0B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Capture health" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowCaptureStatusText" Text="Status: Not available" FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="NowCaptureContextText" Text="Context: Not available" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowCaptureKeyboardText" Text="Keyboard signal: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCaptureMouseText" Text="Mouse signal: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCaptureLastInputText" Text="Last input: Not available" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCaptureWarningText"
                                               Text="Capture status unavailable."
                                               Margin="0,8,0,0"
                                               Foreground="#F59E0B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Last action" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock x:Name="NowLastActionTitleText" Text="No actions recently" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock x:Name="NowLastActionTimeText" Text="Time: Not available" Margin="0,6,0,8" />
                                <Button x:Name="NowOpenActionsButton" Content="Open Actions" Padding="10,6" Width="130" Click="NowOpenActionsButton_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What PORTA is doing" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock x:Name="NowWhatPortaDoingText" Text="Not available" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="NowWaitingDataText"
                                   Text="Waiting for service data"
                                   Foreground="#9AA4B2"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                        <Border x:Name="NowRecoveryBannerBorder"
                                Background="#102019"
                                BorderBrush="#2A3038"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="NowRecoveryDismissButton"
                                        DockPanel.Dock="Right"
                                        Content="Dismiss"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        MinHeight="28"
                                        Click="NowRecoveryDismissButton_Click" />
                                <TextBlock x:Name="NowRecoveryBannerText"
                                           Text=""
                                           Foreground="#7FD1A3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <WrapPanel Margin="0,0,0,12" Visibility="Collapsed">
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="FocusCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Focus" /><TextBlock x:Name="FocusCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="FocusCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="FocusCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="OverloadCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Overload" /><TextBlock x:Name="OverloadCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="OverloadCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="OverloadCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="FatigueCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Fatigue" /><TextBlock x:Name="FatigueCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="FatigueCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="FatigueCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="StabilityCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Stability" /><TextBlock x:Name="StabilityCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="StabilityCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="StabilityCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                        </WrapPanel>
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel x:Name="RecentActionsPanel"><TextBlock Text="No recent actions yet." /></StackPanel>
                        </Border>
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
