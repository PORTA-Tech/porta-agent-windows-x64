
<Window x:Class="Porta.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PORTA"
        Icon="Assets/PortaAppIcon.png"
        Height="820"
        Width="1280"
        MinHeight="580"
        MinWidth="920"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F1114"
        Foreground="#E6E9ED"
        FontFamily="Segoe UI Variable, Segoe UI, Inter">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarItemInfo" Description="PORTA" />
    </Window.TaskbarItemInfo>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PortaSurfaceBaseBrush" Color="#15181C" />
        <SolidColorBrush x:Key="PortaSurfaceElevatedBrush" Color="#1B1F25" />
        <SolidColorBrush x:Key="PortaSurfaceHoverBrush" Color="#1D232A" />
        <SolidColorBrush x:Key="PortaBorderBrush" Color="#262B33" />
        <SolidColorBrush x:Key="PortaBorderHoverBrush" Color="#3A4656" />
        <SolidColorBrush x:Key="PortaTextPrimaryBrush" Color="#E6E9ED" />
        <SolidColorBrush x:Key="PortaTextSecondaryBrush" Color="#9AA4B2" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PortaTextPrimaryBrush}" />
            <Setter Property="Background" Value="#1A1F26" />
            <Setter Property="BorderBrush" Value="{StaticResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#161B22" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1D2127" />
            <Setter Property="BorderBrush" Value="#2A3038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E6E9ED" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QuietHoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PortaSurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietHoverSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietHoverSubCardCompactStyle" TargetType="Border" BasedOn="{StaticResource QuietHoverSubCardStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="RoundedInputChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PortaTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="#12161B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A61E2E" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#821625" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0B0E12" BorderBrush="#20252D" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBarRoot" MouseLeftButtonDown="TitleBarRoot_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/PortaSymbolWhite.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,5,0"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />
                    <TextBlock Text="PORTA"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PortaTextPrimaryBrush}" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TitleBarMinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMinimizeButton_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMaximizeButton_Click">
                        <TextBlock x:Name="TitleBarMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarCloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="TitleBarCloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#0C0E11" BorderBrush="#262B33" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <Button x:Name="OverviewNavButton" Content="Today" Margin="0,0,0,8" Padding="10,8" Click="OverviewNavButton_Click" />
                <Button x:Name="TimelineNavButton" Content="History" Margin="0,0,0,8" Padding="10,8" Click="TimelineNavButton_Click" />
                <Button x:Name="InterventionsNavButton" Content="Actions" Margin="0,0,0,8" Padding="10,8" Click="InterventionsNavButton_Click" />
                <Button x:Name="InputsNavButton" Content="Tracking" Margin="0,0,0,8" Padding="10,8" Click="InputsNavButton_Click" />
                <Button x:Name="StatesNavButton" Content="Advanced" Margin="0,0,0,8" Padding="10,8" Click="StatesNavButton_Click" Visibility="Collapsed" />
                <Button x:Name="SettingsNavButton" Content="Settings" Margin="0,0,0,8" Padding="10,8" Click="SettingsNavButton_Click" />
                <Button x:Name="AccountNavButton" Margin="0,0,0,8" Padding="10,8" Click="AccountNavButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Account"
                                   VerticalAlignment="Center" />
                        <Border x:Name="AccountNavUpdateBadgeBorder"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Background="#C1121F"
                                BorderBrush="#F87171"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="AccountNavUpdateBadgeText"
                                       Text="1"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="DiagnosticsNavButton" Content="System" Margin="0,0,0,0" Padding="10,8" Click="DiagnosticsNavButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#15181C"
                    BorderBrush="#262B33"
                    BorderThickness="0,0,0,1"
                    MinHeight="64"
                    ClipToBounds="True">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock x:Name="SectionTitleText"
                                   Text="Today"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <WrapPanel VerticalAlignment="Center">
                            <Border x:Name="StatusPillBorder" CornerRadius="12" Background="#1D4ED8" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="StatusPillText" Text="Running" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="ConsentBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="ConsentBadgeText" Text="Consent: Needed" />
                            </Border>
                            <Border x:Name="CalibrationBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="CalibrationBadgeText" Text="Learning your pattern: Bootstrapping" />
                            </Border>
                            <Border x:Name="TrustBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="TrustBadgeText" Text="Confidence: Low" />
                            </Border>
                            <Button x:Name="GlobalUpdateButton"
                                    Padding="12,6"
                                    Margin="0,0,10,8"
                                    Visibility="Collapsed"
                                    ToolTip="Open update details"
                                    Click="GlobalUpdateButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GlobalUpdateButtonText"
                                               Text="Update ready"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Border x:Name="GlobalUpdateButtonBadgeBorder"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Background="#C1121F"
                                            BorderBrush="#F87171"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="GlobalUpdateButtonBadgeText"
                                                   Text="1"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="WhyDrawerToggleButton" Content="Why" Padding="12,6" Margin="0,0,10,0" Click="WhyDrawerToggleButton_Click" />
                        <Button x:Name="QuickPauseResumeButton" Content="Pause" Padding="12,6" Margin="0,0,10,0" Click="QuickPauseResumeButton_Click" />
                        <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6" Margin="0,0,10,0" Click="RefreshButton_Click" />
                        <Grid VerticalAlignment="Center">
                            <Button x:Name="VersionsButton"
                                    Padding="12,6"
                                    MinWidth="102"
                                    ToolTip="Agent, UI, and schema versions"
                                    Click="VersionsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Versions"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="&#xE70D;"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="VersionsPopup"
                                   PlacementTarget="{Binding ElementName=VersionsButton}"
                                   Placement="Bottom"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Width="236"
                                        Padding="12"
                                        Background="#0F1319"
                                        BorderBrush="#2E3641"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="Versions"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PortaTextSecondaryBrush}"
                                                   Margin="0,0,0,10" />
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Agent"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="AgentVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="UI"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="UiVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Schema"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="SchemaVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="TodaySummaryText"
                                   Text="Today keeps work, last focus session, pressure, and status in one place."
                                   Foreground="#9AA4B2"
                                   FontSize="13"
                                   Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NowOverloadCard"
                                    Grid.Column="0"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                    Tag="today-work"
                                    ToolTip="Open History for today's work map">
                                <StackPanel>
                                    <TextBlock Text="Work today" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowOverloadValueText" Text="Work today: Updating" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowOverloadActiveText" Text="History status: Updating" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowOverloadTrustText" Text="Confidence: Not available" Margin="0,4,0,8" Visibility="Collapsed" />
                                    <TextBlock x:Name="NowOverloadSummaryText"
                                               Text="Open History to see today's focus map hour by hour."
                                               Margin="0,0,0,8"
                                               Foreground="#93C5FD"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="NowFocusCard"
                                    Grid.Column="1"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                    Tag="last-focus"
                                    ToolTip="Open History for last focus details">
                                <StackPanel>
                                    <TextBlock Text="Last focus session" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowFocusStreakValueText" Text="Last focus session: Not available" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowDeepWorkStreakText"
                                               Text=""
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource PortaTextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="NowFocusChoppinessText" Text="Live activity: Not available" Margin="0,8,0,0" />
                                    <TextBlock x:Name="NowFocusSummaryText"
                                               Text="This follows the same focus-timer definition used in the widget."
                                               Margin="0,8,0,0"
                                               Foreground="#93C5FD"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusFootnoteText" Text="Short pauses do not immediately clear the current focus episode." Margin="0,8,0,0" Foreground="#94A3B8" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock x:Name="NowFocusStatusText" Text="" Margin="0,6,0,0" Foreground="#F59E0B" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NowCalibrationCard"
                                    Grid.Column="0"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                    Tag="today-overload"
                                    ToolTip="Open Why for overload details">
                                <StackPanel>
                                    <TextBlock Text="Pressure" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowCalibrationStatusText" Text="Pressure: Updating" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowCalibrationProgressText" Text="Regulation: Updating" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowCalibrationQualityText" Text="Today peak: Updating" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCalibrationColdStartText" Text="Confidence: Updating" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCalibrationSummaryText"
                                               Text="Open Why to inspect Ari's current pressure reasoning."
                                               Margin="0,8,0,0"
                                               Foreground="#93C5FD"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowCalibrationTrustCapText" Text="Analysis is still catching up for overload details." Foreground="#FB923C" Margin="0,8,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="NowDataQualityCard"
                                    Grid.Column="1"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                    Tag="current-status"
                                    ToolTip="Open Actions for recommendations and recent changes">
                                <StackPanel>
                                    <TextBlock Text="Current status" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowDataQualityScoreText" Text="Current status: Not available" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowDataQualityPartialText" Text="Next recommendation: Not available" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowDataQualitySummaryText"
                                               Text="Open Actions for full recommendation and action history."
                                               Margin="0,8,0,0"
                                               Foreground="#93C5FD"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowDataQualityMissingText" Text="" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="NowWaitingDataText"
                                   Text="Waiting for service data"
                                   Foreground="#9AA4B2"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                        <Border x:Name="NowRecoveryBannerBorder"
                                Background="#102019"
                                BorderBrush="#2A3038"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="NowRecoveryDismissButton"
                                        DockPanel.Dock="Right"
                                        Content="Dismiss"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        MinHeight="28"
                                        Click="NowRecoveryDismissButton_Click" />
                                <TextBlock x:Name="NowRecoveryBannerText"
                                           Text=""
                                           Foreground="#7FD1A3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="UpdatedValue" Margin="0,10,0,0" Foreground="#94A3B8" Text="Last refresh: Not available" />
                        <TextBlock x:Name="DebugFooterText" Margin="0,6,0,0" Foreground="#F59E0B" FontFamily="Consolas" FontSize="11" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="InputsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Tracking" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="See what Ari observes, what it never collects, and how to keep tracking useful." Foreground="#CBD5E1" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What Ari tracks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="TrackingCollectionSummaryText"
                                           Text="Ari observes pattern-level activity in your signed-in Windows session."
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="Keyboard rhythm" FontWeight="SemiBold" />
                                            <TextBlock Text="How active typing is, never what you typed." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Mouse movement" FontWeight="SemiBold" />
                                            <TextBlock Text="Movement, scrolling, and pace, never screen content." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="App switching" FontWeight="SemiBold" />
                                            <TextBlock Text="Which apps or windows are active, with identifiers hashed before storage." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Activity gaps" FontWeight="SemiBold" />
                                            <TextBlock Text="When you step away or pause, not why you did." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What Ari never tracks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="- Typed words or message content" Margin="0,0,0,6" />
                                <TextBlock Text="- Screenshots or screen recordings" Margin="0,0,0,6" />
                                <TextBlock Text="- Clipboard contents" Margin="0,0,0,6" />
                                <TextBlock Text="- Microphone or camera data" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What improves tracking quality" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="TrackingQualityHeadlineText"
                                           Text="Tracking quality is updating."
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock x:Name="TrackingQualitySummaryText"
                                           Text="Ari needs a little more recent activity before it can describe your patterns clearly."
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="TrackingQualityHelpText"
                                           Text="Best results come from a normal signed-in desktop session with a few seconds of keyboard or mouse activity."
                                           Foreground="#94A3B8"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Stay in your session" FontWeight="SemiBold" />
                                            <TextBlock Text="Tracking works best when Ari is attached to your signed-in desktop session." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Give it a few seconds" FontWeight="SemiBold" />
                                            <TextBlock Text="A short stretch of normal keyboard or mouse activity helps Ari confirm the current session." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Keep consent on" FontWeight="SemiBold" />
                                            <TextBlock Text="If consent is revoked or tracking is paused, Ari stops collecting until you turn it back on." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Privacy and controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Consent" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="TrackingConsentValue" Grid.Row="0" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Privacy mode" Foreground="#CBD5E1" Margin="0,8,0,0" />
                                    <TextBlock x:Name="TrackingPrivacyValue" Grid.Row="1" Grid.Column="1" Text="Not available" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Active controls" Foreground="#CBD5E1" Margin="0,8,0,0" />
                                    <TextBlock x:Name="TrackingControlsValue" Grid.Row="2" Grid.Column="1" Text="Not available" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Open Settings" Padding="12,6" Margin="0,0,10,0" Click="SettingsNavButton_Click" />
                                    <Button x:Name="TrackingPauseResumeButton" Content="Pause tracking" Padding="12,6" Margin="0,0,10,0" Click="QuickPauseResumeButton_Click" />
                                    <Button Content="Revoke consent" Padding="12,6" Click="RevokeConsentFromSettingsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Your data" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock x:Name="RetentionWindowValue" Text="Stored on this device: Not available" />
                                <TextBlock x:Name="RetentionSizeValue" Text="Local storage used: Not available" Margin="0,6,0,10" />
                                <WrapPanel>
                                    <Button Content="Export Data" Padding="12,6" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                                    <Button Content="Delete Local Data" Padding="12,6" Click="DeleteLocalDataButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InterventionsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              IsManipulationEnabled="True"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="20,20,20,32">
                            <TextBlock Text="Actions" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="See what Ari recommended, what it changed, and why it mattered." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <TextBlock x:Name="ActionsSummaryLeadText"
                                       Text="Recommendations and recent actions appear here in plain language so you can understand what Ari did and why."
                                       Foreground="#93C5FD"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Recommendations" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="SuggestionsCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#DBEAFE" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Recent actions" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="ChangesCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#DCFCE7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Total" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="ActionsTotalCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#E6E9ED" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Latest activity" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="ActionsLastSeenText" Text="No recent actions" FontSize="13" FontWeight="SemiBold" Foreground="#E6E9ED" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Recent timeline" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Text="Newest activity on the right. Hover any point to see what Ari suggested or changed." Foreground="#94A3B8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ActionsTimelineEmptyText" Text="No recent actions yet." Foreground="#CBD5E1" Visibility="Collapsed" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="ActionsTimelineStripPanel" Orientation="Horizontal" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Category mix" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Text="Share of recent actions by type." Foreground="#94A3B8" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Breaks" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#243042" BorderThickness="1" CornerRadius="999" Height="10" Margin="10,0,10,0">
                                                <Border x:Name="ActionCategoryBreakFill" Background="#3B82F6" CornerRadius="999" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                            <TextBlock x:Name="ActionCategoryBreakValue" Grid.Column="2" Text="0%" Foreground="#DBEAFE" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Focus" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#243042" BorderThickness="1" CornerRadius="999" Height="10" Margin="10,0,10,0">
                                                <Border x:Name="ActionCategoryFocusFill" Background="#22C55E" CornerRadius="999" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                            <TextBlock x:Name="ActionCategoryFocusValue" Grid.Column="2" Text="0%" Foreground="#DCFCE7" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Alerts" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#243042" BorderThickness="1" CornerRadius="999" Height="10" Margin="10,0,10,0">
                                                <Border x:Name="ActionCategoryNotificationsFill" Background="#F59E0B" CornerRadius="999" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                            <TextBlock x:Name="ActionCategoryNotificationsValue" Grid.Column="2" Text="0%" Foreground="#FDE68A" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Protection" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#243042" BorderThickness="1" CornerRadius="999" Height="10" Margin="10,0,10,0">
                                                <Border x:Name="ActionCategoryProtectionFill" Background="#A855F7" CornerRadius="999" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                            <TextBlock x:Name="ActionCategoryProtectionValue" Grid.Column="2" Text="0%" Foreground="#E9D5FF" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Other" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#243042" BorderThickness="1" CornerRadius="999" Height="10" Margin="10,0,10,0">
                                                <Border x:Name="ActionCategoryOtherFill" Background="#64748B" CornerRadius="999" HorizontalAlignment="Left" Width="0" />
                                            </Border>
                                            <TextBlock x:Name="ActionCategoryOtherValue" Grid.Column="2" Text="0%" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Keep these hidden toggles for existing settings/undo wiring. -->
                            <StackPanel Visibility="Collapsed">
                                <CheckBox x:Name="InterventionNotificationToggle" Content="Allow notification reduction (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionFocusModeToggle" Content="Allow focus mode nudge (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionAnimationToggle" Content="Allow animation reduction (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionAppRestrictionToggle" Content="Allow temporary app restriction (auto)" Click="InterventionCategoryToggle_Click" />
                            </StackPanel>

                            <TextBlock Text="Pick a row to see what Ari suggested or changed and why it mattered." Foreground="#94A3B8" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="ActionsSuggestionsTabButton" Content="Recommendations" Padding="12,6" Margin="0,0,8,0" Click="ActionsSuggestionsTabButton_Click" />
                                <Button x:Name="ActionsChangesTabButton" Content="Recent actions" Padding="12,6" Click="ActionsChangesTabButton_Click" />
                            </WrapPanel>
                            <Border Style="{StaticResource QuietHoverCardStyle}" Padding="10" MinHeight="420" MaxHeight="560">
                                <Grid>
                                    <Grid x:Name="SuggestionsTabContent" Margin="4">
                                        <TextBlock x:Name="SuggestionsEmptyStateText"
                                                   Text="No recommendations yet. Keep working and Ari will surface the next useful suggestion here."
                                                   Foreground="#CBD5E1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                        <ListView x:Name="SuggestionsListView"
                                                  SelectionChanged="SuggestionsListView_SelectionChanged"
                                                  PreviewMouseWheel="SuggestionsListView_PreviewMouseWheel"
                                                  Background="#0B1220"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#1F2937"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="False">
                                            <ListView.Resources>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#111827" />
                                                    <Setter Property="BorderBrush" Value="#1F2937" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#171B20" />
                                                            <Setter Property="BorderBrush" Value="#303743" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1B222B" />
                                                            <Setter Property="BorderBrush" Value="#3B4655" />
                                                            <Setter Property="Foreground" Value="#E6E9ED" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="{x:Type ScrollBar}">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Background" Value="#0F172A" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                <Grid Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
                                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                          Background="Transparent"
                                                                                          BorderThickness="0"
                                                                                          Opacity="0" />
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.Thumb>
                                                                            <Thumb x:Name="ScrollThumb"
                                                                                   Background="#526079"
                                                                                   BorderBrush="#64748B"
                                                                                   BorderThickness="1" />
                                                                        </Track.Thumb>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                          Background="Transparent"
                                                                                          BorderThickness="0"
                                                                                          Opacity="0" />
                                                                        </Track.IncreaseRepeatButton>
                                                                    </Track>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ScrollThumb" Property="Background" Value="#64748B" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Background}"
                                                            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="#3B82F6" CornerRadius="12,0,0,12" />
                                                            <StackPanel Grid.Column="1" Margin="12">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                                    <Border Grid.Column="1" Background="#151B23" BorderBrush="#2B3441" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding Time}" Foreground="#CBD5E1" FontSize="11" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Text="Why it mattered" Foreground="#93C5FD" FontSize="11" Margin="0,0,0,4" />
                                                                <TextBlock Text="{Binding Why}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                    <Grid x:Name="ChangesTabContent" Margin="4" Visibility="Collapsed">
                                        <TextBlock x:Name="ChangesEmptyStateText"
                                                   Text="No recent actions yet. When Ari changes something for you, it will show up here."
                                                   Foreground="#CBD5E1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                        <ListView x:Name="ChangesListView"
                                                  SelectionChanged="ChangesListView_SelectionChanged"
                                                  PreviewMouseWheel="ChangesListView_PreviewMouseWheel"
                                                  Background="#0B1220"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#1F2937"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="False">
                                            <ListView.Resources>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#111827" />
                                                    <Setter Property="BorderBrush" Value="#1F2937" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#171B20" />
                                                            <Setter Property="BorderBrush" Value="#303743" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1B222B" />
                                                            <Setter Property="BorderBrush" Value="#3B4655" />
                                                            <Setter Property="Foreground" Value="#E6E9ED" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Background}"
                                                            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="#22C55E" CornerRadius="12,0,0,12" />
                                                            <StackPanel Grid.Column="1" Margin="12">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding WhatChanged}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                                    <Border Grid.Column="1" Background="#151B23" BorderBrush="#2B3441" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding When}" Foreground="#CBD5E1" FontSize="11" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Text="Why it mattered" Foreground="#93C5FD" FontSize="11" Margin="0,0,0,4" />
                                                                <TextBlock Text="{Binding Why}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Border>
                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,12,0,24">
                            <ScrollViewer x:Name="ActionDetailsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          PreviewMouseWheel="ActionDetailsScrollViewer_PreviewMouseWheel"
                                          IsManipulationEnabled="True"
                                          PanningMode="VerticalOnly">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="10" />
                                        <Setter Property="Background" Value="#0F172A" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Grid Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb x:Name="ScrollThumb"
                                                                       Background="#526079"
                                                                       BorderBrush="#64748B"
                                                                       BorderThickness="1" />
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ScrollThumb" Property="Background" Value="#64748B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="Selected recommendation or action" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="This panel explains what Ari suggested or changed, when it happened, and why it mattered. Technical decision details stay in System." Foreground="#94A3B8" Margin="0,0,0,12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ActionDrawerTitle" Text="Choose a recommendation or recent action" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="ActionDrawerWhen" Text="When it happened: Not available" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerClassification" Text="Type: Not available" Margin="0,0,0,6" Foreground="#FDE68A" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerDecisionState" Text="Decision: Not available" Margin="0,0,0,6" Foreground="#93C5FD" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerExecutionState" Text="Execution: Not available" Margin="0,0,0,6" Foreground="#93C5FD" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerCooldown" Text="Cooldown remaining: Not available" Margin="0,0,0,6" Foreground="#CBD5E1" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerUndo" Text="How to undo: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerShortWhy" Text="Why it mattered: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#E2E8F0" />
                                            <TextBlock x:Name="ActionDrawerRepeat" Text="" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerWhatChanged" Text="What Ari recommended or changed: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#E2E8F0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Raw details" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,4" Visibility="Collapsed" />
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Visibility="Collapsed">
                                        <ScrollViewer VerticalScrollBarVisibility="Disabled" Height="190">
                                            <TextBlock x:Name="ActionDrawerWhyJson" Text="Not available" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                        </ScrollViewer>
                                    </Border>
                                    <Button x:Name="ActionDrawerUndoButton" Content="Undo change" Padding="12,6" Margin="0,10,0,0" Click="ActionDrawerUndoButton_Click" IsEnabled="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#E2E8F0" />
                        </Style>
                        <Style TargetType="{x:Type CheckBox}">
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="#E2E8F0" />
                            <Setter Property="BorderBrush" Value="#334155" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style TargetType="{x:Type DatePicker}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style x:Key="ReadableSettingsComboItemStyle" TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Padding" Value="6,4" />
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE" />
                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Adjust behavior without overwhelming settings." Foreground="#CBD5E1" Margin="0,0,0,12" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="A) Main controls" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <TextBlock Text="Intensity" />
                                <Slider x:Name="IntensitySlider" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="IntensitySlider_ValueChanged" Margin="0,4,0,0" />
                                <TextBlock x:Name="IntensityValueText" Text="Balanced" Margin="0,6,0,10" />
                                <TextBlock Text="Privacy mode" />
                                <Border Style="{StaticResource RoundedInputChromeStyle}" Width="240" Margin="0,4,0,0">
                                    <ComboBox x:Name="PrivacyLevelComboBox"
                                              SelectionChanged="PrivacyLevelComboBox_SelectionChanged"
                                              ItemContainerStyle="{StaticResource ReadableSettingsComboItemStyle}"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <ComboBoxItem Content="Minimal" Foreground="#111827" Background="#F8FAFC" />
                                        <ComboBoxItem Content="Standard" Foreground="#111827" Background="#F8FAFC" />
                                        <ComboBoxItem Content="Detailed" Foreground="#111827" Background="#F8FAFC" />
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="B) Collection controls" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Pause now" Padding="12,6" Margin="0,0,10,0" Click="PauseButton_Click" />
                                    <Button Content="Revoke consent" Padding="12,6" Click="RevokeConsentFromSettingsButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="Pause until" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Width="160" Margin="0,0,8,0">
                                        <DatePicker x:Name="PauseUntilDatePicker" Background="Transparent" BorderThickness="0" />
                                    </Border>
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Width="110" Margin="0,0,8,0">
                                        <ComboBox x:Name="PauseUntilTimeComboBox"
                                                  ItemContainerStyle="{StaticResource ReadableSettingsComboItemStyle}"
                                                  Foreground="#111827"
                                                  Background="Transparent"
                                                  BorderThickness="0" />
                                    </Border>
                                    <Button Content="Pause until selected time" Padding="12,6" Click="PauseUntilSelectedButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="C) Calibration controls" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <Button Content="Recalibrate baseline" Padding="12,6" Width="180" HorizontalAlignment="Left" Click="RecalibrateBaselineButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="D) Safety toggles" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                    <CheckBox x:Name="SettingsSuggestionsOnlyToggle" Content="Suggestions only (no system changes)" Click="SettingsSuggestionsOnlyToggle_Click" Margin="0" />
                                </Border>
                                <TextBlock Text="Categories" Foreground="#94A3B8" Margin="0,0,0,6" />
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,6">
                                    <CheckBox x:Name="SettingsNotificationToggle" Content="Notification reduction" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,6">
                                    <CheckBox x:Name="SettingsFocusModeToggle" Content="Focus mode nudge" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,6">
                                    <CheckBox x:Name="SettingsAnimationToggle" Content="Animation reduction" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                    <CheckBox x:Name="SettingsAppRestrictionToggle" Content="Temporary app restriction" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Apply controls" Padding="12,6" Margin="0,0,10,0" Click="SaveSettingsButton_Click" />
                            <Button Content="Resume now" Padding="12,6" Click="ResumeFromSettingsButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SettingsStatusText" Text="Settings status: Not available" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="StatesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Advanced moved into System" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Open System and scroll to the Advanced section." Foreground="#CBD5E1" Margin="0,0,0,12" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TimelinePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,32">
                            <TextBlock Text="History" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="See when focus stayed steady, when distraction crept in, and where Ari stepped in." Foreground="#CBD5E1" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <TextBlock x:Name="HistorySummaryLeadText"
                                       Text="History highlights your focus episodes, distraction segments, patterns, and action markers."
                                       Foreground="#93C5FD"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="HistoryRange1hButton" Content="Last 1h" Padding="10,4" Margin="0,0,8,0" Click="HistoryRange1hButton_Click" />
                                <Button x:Name="HistoryRange4hButton" Content="Last 4h" Padding="10,4" Margin="0,0,8,0" Click="HistoryRange4hButton_Click" />
                                <Button x:Name="HistoryRangeTodayButton" Content="Today" Padding="10,4" Margin="0,0,8,0" Click="HistoryRangeTodayButton_Click" />
                                <Button x:Name="HistoryRangeAllTimeButton" Content="All time" Padding="10,4" Margin="0,0,14,0" Click="HistoryRangeAllTimeButton_Click" />
                                <CheckBox x:Name="HistoryExplainModeCheckBox" Content="Advanced" VerticalAlignment="Center" Foreground="#E5E7EB" Checked="HistoryExplainModeCheckBox_Changed" Unchecked="HistoryExplainModeCheckBox_Changed" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Tracked time" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="HistoryRangeSummaryText" Text="No data yet" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Focused time" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="HistoryFocusSummaryText" Text="No data yet" Foreground="#DCFCE7" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Best hour" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="HistoryOverloadSummaryText" Text="No data yet" Foreground="#FECACA" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Actions in this range" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock x:Name="HistoryTrustSummaryText" Text="No data yet" Foreground="#DBEAFE" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="HistoryActionsSummaryText" Text="No data yet" Foreground="#CBD5E1" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                                <TextBlock x:Name="HistoryGuideText"
                                           Text="Each column is a day and each row is an hour. Darker cells mean more focused time in that hour."
                                           Foreground="#CBD5E1"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Focus hours by day" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Hours run top to bottom and days run left to right. Each cell shows how much focused time Ari mapped in that hour. Click a cell for details." Foreground="#94A3B8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <Border Background="#123524" BorderBrush="#1B6B3A" BorderThickness="1" CornerRadius="999" Padding="8,3" Margin="0,0,6,6">
                                            <TextBlock Text="More focused time" Foreground="#86EFAC" FontSize="11" />
                                        </Border>
                                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="999" Padding="8,3" Margin="0,0,6,6">
                                            <TextBlock Text="Tracked, low focus" Foreground="#CBD5E1" FontSize="11" />
                                        </Border>
                                        <Border Background="#0B1220" BorderBrush="#243042" BorderThickness="1" CornerRadius="999" Padding="8,3" Margin="0,0,6,6">
                                            <TextBlock Text="No tracked time" Foreground="#94A3B8" FontSize="11" />
                                        </Border>
                                    </WrapPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel x:Name="HistoryHourLabelsPanel" Grid.Column="0" Grid.Row="0" VerticalAlignment="Top" Margin="0,0,8,0" />

                                        <Grid Grid.Column="1" Grid.Row="0">
                                            <Border Background="#0B1220" BorderBrush="#243042" BorderThickness="1" CornerRadius="12">
                                                <ScrollViewer x:Name="HistoryCoordinateScrollViewer"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled">
                                                    <Canvas x:Name="HistoryCoordinateCanvas" Height="592" />
                                                </ScrollViewer>
                                            </Border>
                                            <TextBlock x:Name="HistoryCoordinateEmptyText"
                                                       Text="No tracked focus episodes are available in this range yet."
                                                       Foreground="#CBD5E1"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="1"
                                                   x:Name="HistoryCoordinateXAxisText"
                                                   Text="Days run left to right"
                                                   Foreground="#94A3B8"
                                                   Margin="6,8,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Action markers in this range" FontWeight="SemiBold" />
                            <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineInterventionsScrollViewer" Height="36" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineInterventionTrackPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Border>

                            <StackPanel x:Name="HistoryAdvancedMetricsPanel" Visibility="Collapsed">
                                <TextBlock Text="Pressure" FontWeight="SemiBold" />
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                    <ScrollViewer x:Name="TimelineOverloadScrollViewer" Height="56" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="TimelineOverloadTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="Confidence" FontWeight="SemiBold" />
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                    <ScrollViewer x:Name="TimelineTrustScrollViewer" Height="56" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="TimelineTrustTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ScrollViewer>
                                </Border>

                                    <TextBlock Text="Focus episode at each snapshot" FontWeight="SemiBold" />
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                    <ScrollViewer x:Name="TimelineFocusScrollViewer" Height="72" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="TimelineFocusTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="Overload-active windows" FontWeight="SemiBold" />
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                    <ScrollViewer x:Name="TimelineOverloadActiveScrollViewer" Height="24" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="TimelineOverloadActiveOverlayPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Selected detail" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Click a heatmap hour or an action marker to inspect that part of the day in plain language. Turn on Advanced for raw details." Foreground="#94A3B8" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <TextBlock x:Name="TimelineDetailTimestamp" Text="Hour: Select a heatmap cell or action marker to inspect a block of time." Margin="0,0,0,6" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                <TextBlock x:Name="TimelineDetailOverload" Text="Tracked time in that hour: This will appear after you select a heatmap cell." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailTrust" Text="Confidence in that hour: This will appear after you select a heatmap cell." Margin="0,0,0,6" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                <TextBlock x:Name="TimelineDetailFocus" Text="Focus episode in that hour: This will appear after you select a heatmap cell." Margin="0,0,0,6" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                <TextBlock x:Name="TimelineDetailClassification" Text="What happened here: Select a heatmap hour to see what Ari understood about that block." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FDE68A" />
                                <TextBlock x:Name="TimelineDetailExecution" Text="Action around this moment: Select an action marker to see what Ari suggested or changed." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#93C5FD" />
                                <TextBlock x:Name="TimelineDetailWhyHeader" Text="What Ari saw in that hour" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#93C5FD" />
                                <TextBlock x:Name="TimelineDetailWhyFiv" Text="Focus / pressure / movement: Ari will explain this after you select an hour." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailWhyReasons" Text="Main signals: Ari will list the strongest signals after you select an hour." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailWhyQuality" Text="Tracking quality: This will appear with the selected hour." TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFFFFF" FontSize="13" />
