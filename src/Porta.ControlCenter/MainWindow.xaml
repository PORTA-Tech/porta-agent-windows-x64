                            <TextBox Style="{StaticResource SelectableText}" x:Name="TrayRunningValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ConsentActiveValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="BackendConnectedValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="FocusStrengthValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="OverloadValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="LastActionValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="LastEventValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="PolicyVersionValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="SchemaVersionValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="AgentVersionValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ApiReachableValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ApiPortValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ConsentVersionValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ConsentTimestampValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="ConsentHashValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="LastErrorValue" Text="None" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="SnapshotConfidenceValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="OverloadActiveValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="SustainedAttentionValue" Text="Not available" />
                            <TextBox Style="{StaticResource SelectableText}" x:Name="IdleFragmentationValue" Text="Not available" />
