                                                    Content="Later"
                                                    Margin="0,0,0,8"
                                                    Padding="12,6"
                                                    Click="AccountDismissUpdateButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="AccountSignedOutPanel">
                                    <TextBlock Text="Sign in to view your workspace access and devices." FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                    <TextBlock Text="Email or user ID" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,4">
                                        <TextBox x:Name="AccountUserIdTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                    </Border>
                                    <TextBlock x:Name="AccountUserIdHelpText" Text="Use the email or user ID your workspace gave you." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <TextBlock Text="Password" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,4">
                                        <PasswordBox x:Name="AccountPasswordBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                    </Border>
                                    <TextBlock x:Name="AccountPasswordHelpText" Text="Use the password set for your workspace account." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <CheckBox x:Name="AccountRememberSignInCheckBox" Content="Remember on this PC" IsChecked="True" Foreground="#E6E9ED" VerticalAlignment="Center" />
                                        <Button x:Name="AccountForgetRememberedSignInButton"
                                                Content="Forget saved sign-in"
                                                Margin="12,0,0,0"
                                                Padding="10,4"
                                                MinHeight="30"
                                                Click="AccountForgetRememberedSignInButton_Click"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="AccountRememberedSignInHelpText" Text="Keep this checked if you want PORTA to remember this email and password on this Windows account only." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <Button x:Name="AccountSignInButton" Content="Sign in" Padding="12,6" Width="140" HorizontalAlignment="Left" Click="AccountSignInButton_Click" />

                                    <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Need an account?" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6" />
                                            <TextBlock x:Name="AccountCreateHelpText" Text="Use your existing account, or create one here if your workspace allows self-service sign-up." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                            <StackPanel x:Name="AccountRegistrationPanel">
                                                <TextBlock Text="Display name" Margin="0,0,0,4" />
                                                <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                    <TextBox x:Name="AccountRegisterDisplayNameTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                </Border>
                                                <TextBlock x:Name="AccountCreateDisplayNameHelpText" Text="Use the name you want to see in your account and on linked devices." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBlock Text="Email or user ID" Margin="0,0,0,4" />
                                                <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                    <TextBox x:Name="AccountRegisterUserIdTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                </Border>
                                                <TextBlock x:Name="AccountCreateUserIdHelpText" Text="This becomes how you sign in later. Most people use their work email." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBlock Text="Password" Margin="0,0,0,4" />
                                                <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                    <PasswordBox x:Name="AccountRegisterPasswordBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                </Border>
                                                <TextBlock x:Name="AccountCreatePasswordHelpText" Text="Create the password you want to use when you sign in on this PC." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <StackPanel x:Name="AccountSignupCodePanel" Visibility="Collapsed">
                                                    <TextBlock Text="Sign-up code" Margin="0,0,0,4" />
                                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                        <TextBox x:Name="AccountRegisterSignupCodeTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                    </Border>
                                                    <TextBlock x:Name="AccountSignupCodeHelpText" Text="Only fill this if your admin gave you a sign-up code." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button x:Name="AccountCreateAccountButton" Content="Create account" Padding="12,6" Width="150" HorizontalAlignment="Left" Click="AccountCreateAccountButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="AccountSignedInPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                        <TextBlock x:Name="AccountSignedInSummaryText" Text="Use the menu below to open your profile, workspace, subscription, devices, or privacy." TextWrapping="Wrap" Foreground="#CBD5E1" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AccountSummarySectionPanel" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Signed in as" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountSignedInAsValue" Grid.Row="0" Grid.Column="1" Text="Not signed in" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountEmailValue" Grid.Row="1" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Signed in until" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountSessionExpiryValue" Grid.Row="2" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />
                                </Grid>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,12,0,0">
                                    <TextBlock Text="This section shows who is signed in on this PC. Open Workspace or Devices to change how this machine uses your account." TextWrapping="Wrap" Foreground="#CBD5E1" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <WrapPanel>
                                <Button x:Name="AccountSummaryMenuButton" Content="Signed in as" Margin="0,0,8,8" Tag="summary" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountManageMenuButton" Content="Manage account" Margin="0,0,8,8" Tag="manage" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountWorkspaceMenuButton" Content="Workspace" Margin="0,0,8,8" Tag="workspace" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountSubscriptionMenuButton" Content="Subscription" Margin="0,0,8,8" Tag="subscription" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountDevicesMenuButton" Content="Devices" Margin="0,0,8,8" Tag="devices" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountPrivacyMenuButton" Content="Privacy &amp; consent" Margin="0,0,8,8" Tag="privacy" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountSignOutMenuButton" Content="Sign out" Margin="0,0,0,8" Tag="signout" Click="AccountSectionMenuButton_Click" />
                            </WrapPanel>
                        </Border>

                        <Grid x:Name="AccountPrimarySectionsGrid" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccountManageSectionPanel" Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Manage account" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="Display name" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                        <TextBox x:Name="AccountDisplayNameTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                    </Border>
                                    <TextBlock Text="Email" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountReadOnlyEmailValue" Text="Not available" Margin="0,4,0,10" TextWrapping="Wrap" />
                                    <Button x:Name="AccountSaveProfileButton" Content="Save display name" Padding="12,6" HorizontalAlignment="Left" Click="AccountSaveProfileButton_Click" />
                                    <TextBlock x:Name="AccountProfileStatusText" Text="Sign in to change your display name." Margin="0,8,0,0" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="AccountWorkspaceSectionPanel" Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Workspace" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="Workspace" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                        <ComboBox x:Name="AccountWorkspaceComboBox"
                                                  SelectionChanged="AccountWorkspaceComboBox_SelectionChanged"
                                                  Foreground="#111827"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="4" />
                                    </Border>
                                    <TextBlock Text="Organization" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountWorkspaceNameValue" Text="No workspace linked" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Role" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountWorkspaceRoleValue" Text="Not available" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="This device" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountWorkspaceLinkValue" Text="Device identity unavailable" Margin="0,4,0,10" TextWrapping="Wrap" />
                                    <Button x:Name="AccountLinkWorkspaceButton" Content="Link current device to workspace" Padding="12,6" HorizontalAlignment="Left" Click="AccountLinkWorkspaceButton_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="AccountSecondarySectionsGrid" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccountSubscriptionSectionPanel" Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Subscription" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="Plan tier" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountPlanTierValue" Text="Not available" Margin="0,4,0,8" />
                                    <TextBlock x:Name="AccountSubscriptionStatusValue" Text="Sign in to see plan details." Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="AccountDevicesSectionPanel" Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="Current device" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountCurrentDeviceNameValue" Text="Not available" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Device ID" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountCurrentDeviceIdValue" Text="Not available" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Status" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountCurrentDeviceStatusValue" Text="Not available" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Last seen" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountCurrentDeviceLastSeenValue" Text="Not available" Margin="0,4,0,10" TextWrapping="Wrap" />

                                    <TextBlock Text="Other devices on this account" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AccountDevicesEmptyText" Text="Sign in to view this account's devices." Foreground="#94A3B8" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="AccountDevicesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                                            <Border Background="#1E293B" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                                                <TextBlock Text="{Binding BadgeLabel}" Foreground="#BFDBFE" FontSize="11" />
                                                            </Border>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding DetailLabel}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding StatusLabel, StringFormat=Status: {0}}" Foreground="#F8FAFC" Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding LastSeenLabel, StringFormat=Last seen: {0}}" Foreground="#94A3B8" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button Content="Unlink"
                                                                    Padding="12,6"
                                                                    Margin="0,0,8,0"
                                                                    Tag="{Binding DeviceId}"
                                                                    IsEnabled="{Binding CanUnlink}"
                                                                    Click="AccountDeviceUnlinkButton_Click" />
                                                            <Button Content="Revoke"
                                                                    Padding="12,6"
                                                                    Tag="{Binding DeviceId}"
                                                                    IsEnabled="{Binding CanRevoke}"
                                                                    Click="AccountDeviceRevokeButton_Click" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="AccountPrivacySectionPanel" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Privacy &amp; consent" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Account agreement" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountConsentStatusValue" Grid.Row="0" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Agreement version" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountConsentVersionValue" Grid.Row="1" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="This device" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountDeviceConsentStatusValue" Grid.Row="2" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Device version" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountDeviceConsentVersionValue" Grid.Row="3" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture on this device" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountCaptureAuthorizationValue" Grid.Row="4" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Workspace link" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountLinkStatusValue" Grid.Row="5" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Linked since" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountLinkedAtValue" Grid.Row="6" Grid.Column="1" Text="Not linked" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Name="AccountConsentActionHelpText"
                                           Text="Use this button if this PC still needs capture approval."
                                           Margin="0,12,0,8"
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap" />
                                <Button x:Name="AccountConsentActionButton"
                                        Content="Grant consent on this PC"
                                        Padding="12,6"
                                        Width="220"
                                        HorizontalAlignment="Left"
                                        Click="AccountConsentActionButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AccountSignOutSectionPanel" Style="{StaticResource QuietHoverCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Sign out" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Signing out removes the saved sign-in from this PC. It does not uninstall PORTA or remove this device from your account unless you choose that in Devices." Foreground="#CBD5E1" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <Button x:Name="AccountSignOutButton" Content="Sign out on this PC" Padding="12,6" Width="170" HorizontalAlignment="Left" Click="AccountSignOutButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="System" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Use this page for technical truth: service health, local API, snapshot freshness, session heartbeat, input publish, capture health, and recent errors." Foreground="#CBD5E1" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="SystemAdvancedButton"
                                    Content="Jump to Advanced"
                                    Padding="12,6"
                                    Click="SystemAdvancedButton_Click" />
                        </WrapPanel>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Engine health" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Is the backend healthy enough to produce trustworthy state?" Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthEngineStatusValue" Grid.Row="0" Grid.Column="1" Text="Not available" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Service running" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthServiceValue" Grid.Row="1" Grid.Column="1" Text="Not available" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthDatabaseValue" Grid.Row="2" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Snapshot state" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthSnapshotValue" Grid.Row="3" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Policy state" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthPolicyStateValue" Grid.Row="4" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Local API reachable" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthApiValue" Grid.Row="5" Grid.Column="1" Text="Not available" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Last update time" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthLastUpdateValue" Grid.Row="6" Grid.Column="1" Text="Not available" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Last error" Foreground="#CBD5E1" />
                                <TextBlock x:Name="HealthLastErrorValue" Grid.Row="7" Grid.Column="1" Text="None" TextWrapping="Wrap" />
                                </Grid>
