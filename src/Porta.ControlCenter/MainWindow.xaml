
<Window x:Class="Porta.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ari"
        Icon="Assets/PortaAppIcon.png"
        Height="820"
        Width="1280"
        MinHeight="580"
        MinWidth="920"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0C0C14"
        Foreground="#E6E9ED"
        FontFamily="Segoe UI Variable, Segoe UI, Inter">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarItemInfo" Description="Ari" />
    </Window.TaskbarItemInfo>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Surface / border / text -->
        <SolidColorBrush x:Key="PortaSurfaceBaseBrush" Color="#1C1C2E" />
        <SolidColorBrush x:Key="PortaSurfaceElevatedBrush" Color="#1B1F25" />
        <SolidColorBrush x:Key="PortaSurfaceHoverBrush" Color="#1D232A" />
        <SolidColorBrush x:Key="PortaBorderBrush" Color="#252535" />
        <SolidColorBrush x:Key="PortaBorderHoverBrush" Color="#3A3A50" />
        <SolidColorBrush x:Key="PortaTextPrimaryBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="PortaTextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="PortaTextMutedBrush" Color="#475569" />
        <!-- Semantic colours -->
        <SolidColorBrush x:Key="PortaFocusBrush" Color="#16C784" />
        <SolidColorBrush x:Key="PortaWarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="PortaDangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="PortaAccentBrush" Color="#6366F1" />

        <!-- Nav button style — icon + label, green active state with left accent -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBg"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="LeftAccent"
                                           Width="2"
                                           HorizontalAlignment="Left"
                                           Fill="Transparent" />
                                <ContentPresenter Margin="16,9,16,9"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="#0F0F1A" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="NavBg" Property="Background" Value="#1416C784" />
                                <Setter TargetName="LeftAccent" Property="Fill" Value="#16C784" />
                                <Setter Property="Foreground" Value="#16C784" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="active" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBg" Property="Background" Value="#1E16C784" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PortaTextPrimaryBrush}" />
            <Setter Property="Background" Value="#1A1F26" />
            <Setter Property="BorderBrush" Value="{StaticResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#161B22" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1D2127" />
            <Setter Property="BorderBrush" Value="#2A3038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E6E9ED" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QuietHoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PortaSurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietHoverSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietHoverSubCardCompactStyle" TargetType="Border" BasedOn="{StaticResource QuietHoverSubCardStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="RoundedInputChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PortaTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="{StaticResource PortaSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="#12161B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A61E2E" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#821625" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0B0E12" BorderBrush="#20252D" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBarRoot" MouseLeftButtonDown="TitleBarRoot_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ari"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PortaTextPrimaryBrush}" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TitleBarMinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMinimizeButton_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMaximizeButton_Click">
                        <TextBlock x:Name="TitleBarMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarCloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="TitleBarCloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#080810" BorderBrush="#141425" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand area -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                    <TextBlock Text="Ari"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource PortaTextPrimaryBrush}" />
                    <TextBlock x:Name="SidebarDateText"
                               FontSize="11"
                               Foreground="{StaticResource PortaTextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="#141425" Margin="0,0,0,6" />

                <!-- Primary nav -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButtonStyle}" Click="OverviewNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4 5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5zm10 0a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V5zM4 13a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2zm10 0a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-4z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Today" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TimelineNavButton" Style="{StaticResource NavButtonStyle}" Click="TimelineNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4 19L8 13l4 4 4-8 4 4" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="History" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InterventionsNavButton" Style="{StaticResource NavButtonStyle}" Click="InterventionsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M13 3L5 14h7l-1 7 9-11h-7z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Actions" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InputsNavButton" Style="{StaticResource NavButtonStyle}" Click="InputsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7zm10-3a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Tracking" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatesNavButton" Style="{StaticResource NavButtonStyle}" Click="StatesNavButton_Click" Visibility="Collapsed">
                        <TextBlock Text="Advanced" FontSize="13" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Border DockPanel.Dock="Top" Height="1" Background="#141425" Margin="16,6,16,6" />

                <!-- Secondary nav -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M10.325 4.317a1.724 1.724 0 0 0 3.35 0 1.724 1.724 0 0 1 2.573 1.066 1.724 1.724 0 0 0 2.372 2.372 1.724 1.724 0 0 1 1.065 2.572 1.724 1.724 0 0 0 0 3.35 1.724 1.724 0 0 1-1.065 2.573 1.724 1.724 0 0 0-2.372 2.372 1.724 1.724 0 0 1-2.573 1.065 1.724 1.724 0 0 0-3.35 0 1.724 1.724 0 0 1-2.572-1.065 1.724 1.724 0 0 0-2.372-2.372 1.724 1.724 0 0 1-1.066-2.573 1.724 1.724 0 0 0 0-3.35 1.724 1.724 0 0 1 1.066-2.572 1.724 1.724 0 0 0 2.372-2.372 1.724 1.724 0 0 1 2.572-1.066zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AccountNavButton" Style="{StaticResource NavButtonStyle}" Click="AccountNavButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M12 2a10 10 0 1 1 0 20A10 10 0 0 1 12 2zm0 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm0 13c-2.67 0-5-.93-6.3-2.3A9.96 9.96 0 0 1 12 15c2.66 0 5.07 1.07 6.3 2.7A9.96 9.96 0 0 1 12 20z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Account" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="AccountNavUpdateBadgeBorder"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Background="#C1121F"
                                    BorderBrush="#F87171"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="AccountNavUpdateBadgeText"
                                           Text="1"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButtonStyle}" Click="DiagnosticsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M3 12h3l3-7 3 14 2-7h5" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="System" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#080810"
                    BorderBrush="#1A1A2A"
                    BorderThickness="0,0,0,1"
                    MinHeight="48"
                    ClipToBounds="True">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock x:Name="SectionTitleText"
                                   Text="Today"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PortaTextPrimaryBrush}" />
                        <!-- Legacy status pills — kept for code-behind compatibility, not visible -->
                        <WrapPanel Visibility="Collapsed">
                            <Border x:Name="StatusPillBorder" CornerRadius="12" Background="#1D4ED8" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="StatusPillText" Text="Running" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="ConsentBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="ConsentBadgeText" Text="Consent: Needed" />
                            </Border>
                            <Border x:Name="CalibrationBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="CalibrationBadgeText" Text="Learning your pattern: Bootstrapping" />
                            </Border>
                            <Border x:Name="TrustBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="TrustBadgeText" Text="Confidence: Low" />
                            </Border>
                            <Button x:Name="GlobalUpdateButton"
                                    Padding="12,6"
                                    Margin="0,0,10,8"
                                    Visibility="Collapsed"
                                    ToolTip="Open update details"
                                    Click="GlobalUpdateButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GlobalUpdateButtonText"
                                               Text="Update ready"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Border x:Name="GlobalUpdateButtonBadgeBorder"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Background="#C1121F"
                                            BorderBrush="#F87171"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="GlobalUpdateButtonBadgeText"
                                                   Text="1"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Status chip removed — hidden elements kept for code-behind compat -->
                        <Border x:Name="HeaderStatusChipBorder" Visibility="Collapsed">
                            <TextBlock x:Name="HeaderStatusChipText" Text="" />
                        </Border>
                        <!-- Why/Refresh/Versions hidden — moved to contextual page locations -->
                        <Button x:Name="WhyDrawerToggleButton" Content="Why" Padding="12,6" Margin="0,0,10,0" Click="WhyDrawerToggleButton_Click" Visibility="Collapsed" />
                        <Button x:Name="QuickPauseResumeButton" Content="Pause" Padding="10,5" Margin="0,0,0,0" Click="QuickPauseResumeButton_Click" />
                        <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6" Margin="0,0,10,0" Click="RefreshButton_Click" Visibility="Collapsed" />
                        <Grid VerticalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="VersionsButton"
                                    Padding="12,6"
                                    MinWidth="102"
                                    ToolTip="Agent, UI, and schema versions"
                                    Click="VersionsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Versions"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="&#xE70D;"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="VersionsPopup"
                                   PlacementTarget="{Binding ElementName=VersionsButton}"
                                   Placement="Bottom"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Width="236"
                                        Padding="12"
                                        Background="#0F1319"
                                        BorderBrush="#2E3641"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="Versions"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PortaTextSecondaryBrush}"
                                                   Margin="0,0,0,10" />
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Agent"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="AgentVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="UI"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="UiVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Schema"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="SchemaVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPanel"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              IsManipulationEnabled="True"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="OverviewPanel_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <!-- Greeting row hidden — Ari bubble replaces it; state chip removed as redundant with widget -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="TodayGreetingText" Text="Good morning" />
                            <TextBlock x:Name="TodayDateText" />
                            <Border x:Name="TodayStateChipBorder">
                                <TextBlock x:Name="TodayStateChipText" Text="● Focused now" />
                            </Border>
                        </StackPanel>
                        <!-- Ari bubble -->
                        <Border Background="#1216C784"
                                BorderBrush="#3316C784"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="● ARI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#16C784"
                                           Margin="0,0,0,5" />
                                <TextBlock x:Name="TodaySummaryText"
                                           Text="Today keeps work, last focus session, and pressure synced with the widget."
                                           Foreground="#A7F3D0"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <!-- Three metric cards — non-clickable; Work Today has View History link -->
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <!-- Work Today (only card with a link) -->
                            <Border x:Name="NowOverloadCard"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="WORK TODAY"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#475569" Margin="0,0,0,6" />
                                    <TextBlock x:Name="NowOverloadValueText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#F1F5F9" />
                                    <TextBlock x:Name="NowOverloadActiveText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="NowOverloadTrustText" Text="" Margin="0,3,0,0" Visibility="Collapsed"
                                               FontSize="12" Foreground="#475569" />
                                    <Border x:Name="WorkTodayTrack" Height="4" CornerRadius="2" Background="#252535" Margin="0,8,0,6">
                                        <Border x:Name="WorkTodayProgressFill" Background="#3B82F6" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <!-- View History link — bottom-right, only interactive element -->
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="View History →"
                                                   FontSize="11" Foreground="#6366F1"
                                                   Cursor="Hand"
                                                   MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                                   Tag="today-work" />
                                    </DockPanel>
                                    <TextBlock x:Name="NowOverloadSummaryText" Visibility="Collapsed"
                                               Text="" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Focus Score — no link, no click -->
                            <Border x:Name="NowFocusCard"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="5,0,5,0"
                                    BorderBrush="#2216C784">
                                <StackPanel>
                                    <TextBlock Text="FOCUS SCORE"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#475569" Margin="0,0,0,6" />
                                    <TextBlock x:Name="NowFocusStreakValueText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#16C784" />
                                    <TextBlock x:Name="NowDeepWorkStreakText" Text="" Margin="0,5,0,0"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#16C784" Visibility="Collapsed" />
                                    <TextBlock x:Name="NowFocusChoppinessText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#475569" Visibility="Collapsed" />
                                    <Border x:Name="FocusScoreTrack" Height="4" CornerRadius="2" Background="#252535" Margin="0,8,0,0">
                                        <Border x:Name="FocusScoreProgressFill" Background="#16C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <TextBlock x:Name="NowFocusSummaryText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusFootnoteText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusStatusText" Visibility="Collapsed" Text="" Foreground="{StaticResource PortaWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Pressure — no link, no click -->
                            <Border x:Name="NowCalibrationCard"
                                    Style="{StaticResource QuietHoverCardStyle}"
                                    Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRESSURE"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#475569" Margin="0,0,0,6" />
                                    <TextBlock x:Name="NowCalibrationStatusText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#16C784" />
                                    <!-- NowCalibrationProgressText hidden — "Regulation · normal" is developer text -->
                                    <TextBlock x:Name="NowCalibrationProgressText" Text="" Visibility="Collapsed"
                                               FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="NowCalibrationQualityText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#475569" />
                                    <Border x:Name="PressureTrack" Height="4" CornerRadius="2" Background="#252535" Margin="0,8,0,0">
                                        <Border x:Name="PressureProgressFill" Background="#64748B" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <TextBlock x:Name="NowCalibrationColdStartText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="NowCalibrationSummaryText" Visibility="Collapsed" Text="" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowCalibrationTrustCapText" Visibility="Collapsed" Text="Analysis catching up." Foreground="{StaticResource PortaWarningBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <!-- Supporting cards hidden — only 3 metric cards shown -->
                        <StackPanel Visibility="Collapsed">
                            <Border x:Name="CurrentSessionCard">
                                <StackPanel>
                                    <TextBlock x:Name="CurrentSessionValueText" Text="—" />
                                    <TextBlock x:Name="CurrentSessionSubText" Text="" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DistractionsCard">
                                <StackPanel>
                                    <TextBlock x:Name="DistractionsValueText" Text="—" />
                                    <TextBlock x:Name="DistractionsSubText" Text="" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Session timeline -->
                        <TextBlock Text="SESSION TIMELINE — TODAY"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,6,0,10" />
                        <Border Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid x:Name="SessionTimelineBar" Height="22">
                                    <Border Background="#252535" CornerRadius="4" />
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Border CornerRadius="4" Background="#1416C784" BorderBrush="#2216C784" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Focus" Foreground="#16C784" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#148B5CF6" BorderBrush="#228B5CF6" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Distraction" Foreground="#8B5CF6" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#143B82F6" BorderBrush="#223B82F6" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Away" Foreground="#3B82F6" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#14F59E0B" BorderBrush="#22F59E0B" BorderThickness="1" Padding="8,3">
                                        <TextBlock Text="Pressure edge" Foreground="#F59E0B" FontSize="11" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- Quick action buttons -->
                        <WrapPanel Margin="0,0,0,20">
                            <Border CornerRadius="8" Background="#1416C784" BorderBrush="#3516C784" BorderThickness="1"
                                    Padding="10,7" Margin="0,0,10,0" Cursor="Hand"
                                    MouseLeftButtonUp="WhyDrawerToggleButton_Click">
                                <TextBlock Text="Why overload risk? ↗" FontSize="13" FontWeight="Medium" Foreground="#16C784" />
                            </Border>
                            <Border CornerRadius="8" Background="#141C1C2E" BorderBrush="#35252535" BorderThickness="1"
                                    Padding="10,7" Cursor="Hand"
                                    MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp" Tag="today-overload">
                                <TextBlock Text="What should I do now? ↗" FontSize="13" FontWeight="Medium" Foreground="#94A3B8" />
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="NowWaitingDataText"
                                   Text="Waiting for service data"
                                   Foreground="#9AA4B2"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                        <Border x:Name="NowRecoveryBannerBorder"
                                Background="#102019"
                                BorderBrush="#2A3038"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="NowRecoveryDismissButton"
                                        DockPanel.Dock="Right"
                                        Content="Dismiss"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        MinHeight="28"
                                        Click="NowRecoveryDismissButton_Click" />
                                <TextBlock x:Name="NowRecoveryBannerText"
                                           Text=""
                                           Foreground="#7FD1A3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="UpdatedValue" Margin="0,10,0,0" Foreground="#94A3B8" Text="" Visibility="Collapsed" />
                        <TextBlock x:Name="DebugFooterText" Margin="0,6,0,0" Foreground="#F59E0B" FontFamily="Consolas" FontSize="11" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="InputsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              IsManipulationEnabled="True" PanningMode="VerticalOnly">
                    <StackPanel Margin="20,20,20,32">
                        <!-- hidden compat -->
                        <TextBlock x:Name="TrackingCollectionSummaryText" Visibility="Collapsed" Text="" />

                        <!-- Page header -->
                        <TextBlock Text="Tracking" FontSize="22" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,4" />
                        <TextBlock Text="See exactly what Ari monitors and how your data is protected."
                                   FontSize="13" Foreground="#64748B" Margin="0,0,0,24" />

                        <!-- ══ SECTION 1: What Ari observes (open by default) ══ -->
                        <Border x:Name="TrackingNavObserves"
                                Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0" Cursor="Hand"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Observes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#1216C784"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zm11 5a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="What Ari observes" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Keyboard, mouse and app activity signals" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TrackingChevronObserves" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#475569"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentObserves"
                                Background="#13131F" BorderBrush="#252535" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,10,10" Padding="16" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zm4 3h1m3 0h1m3 0h1m3 0h1M6 13h12"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="Keyboard rhythm" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                                            <TextBlock Text="How active typing is — never what you typed" Foreground="#475569" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M12 3c3.3 0 6 2.7 6 6v6c0 3.3-2.7 6-6 6s-6-2.7-6-6V9c0-3.3 2.7-6 6-6zm0 3v5"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="Mouse movement" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                                            <TextBlock Text="Movement, scrolling and pace — never screen content" Foreground="#475569" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M4 4h6v8H4zm10 0h6v4h-6zm0 8h6v8h-6zM4 16h6v4H4z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="App switching" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                                            <TextBlock Text="Which apps are active — identifiers hashed before storage" Foreground="#475569" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="Transparent" Stroke="#16C784" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M6 5h2v14H6zm10 0h2v14h-2z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="Activity gaps" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"/>
                                            <TextBlock Text="When you step away or pause — not why" Foreground="#475569" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <!-- ══ SECTION 2: What Ari never collects ══ -->
                        <Border x:Name="TrackingNavNeverCollects"
                                Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="NeverCollects">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#12EF4444"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M18 6L6 18M6 6l12 12"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="What Ari never collects" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Your messages, screenshots and personal content" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TrackingChevronNeverCollects" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#475569"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentNeverCollects"
                                Background="#13131F" BorderBrush="#252535" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,10,10" Padding="8,0,8,4" Margin="0,-8,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Border BorderBrush="#252535" BorderThickness="0,0,0,1" Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBlock Text="Typed words or message content" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#252535" BorderThickness="0,0,0,1" Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBlock Text="Screenshots or screen recordings" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#252535" BorderThickness="0,0,0,1" Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBlock Text="Clipboard contents" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18 6L6 18M6 6l12 12"/></Canvas></Viewbox>
                                        <TextBlock Text="Microphone or camera data" FontSize="13" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ══ SECTION 3: Tracking quality ══ -->
                        <Border x:Name="TrackingNavQuality"
                                Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Quality">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#126366F1"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#6366F1" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M18 20V10M12 20V4M6 20v-6"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tracking quality" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="How accurately Ari understands your patterns" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TrackingChevronQuality" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#475569"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentQuality"
                                Background="#13131F" BorderBrush="#252535" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,10,10" Padding="16" Margin="0,-8,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <!-- Quality bar — no orange pill -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Signal quality" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TrackingQualityChipText" Grid.Column="1"
                                               Text="" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="6" CornerRadius="3" Background="#252535" Margin="0,0,0,14">
                                    <Border x:Name="TrackingQualityProgressFill" Background="#6366F1" CornerRadius="3"
                                            HorizontalAlignment="Left" Width="60" Height="6"/>
                                </Border>
                                <TextBlock x:Name="TrackingQualityHeadlineText"
                                           Text="Tracking quality is updating."
                                           FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TrackingQualitySummaryText"
                                           Text="Ari needs a little more recent activity before it can describe your patterns clearly."
                                           Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TrackingQualityHelpText"
                                           Text="Best results come from a normal signed-in desktop session with a few seconds of keyboard or mouse activity."
                                           Foreground="#64748B" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Stay in your session" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9"/>
                                            <TextBlock Text="Tracking works best when Ari is attached to your signed-in desktop session." Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0">
                                        <StackPanel>
                                            <TextBlock Text="Give it a few seconds" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9"/>
                                            <TextBlock Text="A short stretch of keyboard or mouse activity helps Ari confirm the current session." Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Keep consent on" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9"/>
                                            <TextBlock Text="If consent is revoked or tracking is paused, Ari stops collecting until you turn it back on." Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- ══ SECTION 4: Privacy control ══ -->
                        <Border x:Name="TrackingNavPrivacy"
                                Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Privacy">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#128B5CF6"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#8B5CF6" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm3-8V7a4 4 0 0 0-8 0v3"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Privacy control" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Consent, privacy mode and active controls" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TrackingChevronPrivacy" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#475569"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentPrivacy"
                                Background="#13131F" BorderBrush="#252535" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,10,10" Padding="16" Margin="0,-8,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Consent" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TrackingConsentValue" Grid.Row="0" Grid.Column="1" Text="Not available" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Privacy mode" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock x:Name="TrackingPrivacyValue" Grid.Row="1" Grid.Column="1" Text="Not available" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Active controls" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock x:Name="TrackingControlsValue" Grid.Row="2" Grid.Column="1" Text="Not available" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Open Settings" Padding="12,7" Margin="0,0,10,0" Click="SettingsNavButton_Click"/>
                                    <Button x:Name="TrackingPauseResumeButton" Content="Pause tracking" Padding="12,7" Margin="0,0,10,0" Click="QuickPauseResumeButton_Click"/>
                                    <Button Content="Revoke consent" Padding="12,7" Click="RevokeConsentFromSettingsButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ══ SECTION 5: Your data ══ -->
                        <Border x:Name="TrackingNavData"
                                Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="TrackingNav_Click" Tag="Data">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#123B82F6"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Transparent" Stroke="#3B82F6" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M4 6h16M4 10h16M4 14h10"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Your data" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Storage, retention and export options" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TrackingChevronData" Grid.Column="2"
                                           Text="+" FontSize="20" FontWeight="Light" Foreground="#475569"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TrackingContentData"
                                Background="#13131F" BorderBrush="#252535" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,10,10" Padding="16" Margin="0,-8,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RetentionWindowValue" Text="Stored on this device: Not available" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBlock x:Name="RetentionSizeValue" Text="Local storage used: Not available" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,16"/>
                                <WrapPanel>
                                    <Button Content="Export Data" Padding="12,7" Margin="0,0,10,0" Click="ExportDataButton_Click"/>
                                    <Button Content="Delete Local Data" Padding="12,7" Click="DeleteLocalDataButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InterventionsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              IsManipulationEnabled="True"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="20,20,20,32">

                        <!-- Period tab selector — same style as History page -->
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border x:Name="ActionsTabDay"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Margin="0,0,24,0"
                                        MouseLeftButtonUp="ActionsTabDay_Click">
                                    <StackPanel>
                                        <TextBlock x:Name="ActionsTabDayText" Text="Day"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                        <Border x:Name="ActionsTabDayLine" Height="2" Background="#6366F1" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ActionsTabWeek"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Margin="0,0,24,0"
                                        MouseLeftButtonUp="ActionsTabWeek_Click">
                                    <StackPanel>
                                        <TextBlock x:Name="ActionsTabWeekText" Text="Week"
                                                   FontSize="13" FontWeight="Medium" Foreground="#475569" />
                                        <Border x:Name="ActionsTabWeekLine" Height="2" Background="Transparent" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ActionsTabTwoWeeks"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ActionsTabTwoWeeks_Click">
                                    <StackPanel>
                                        <TextBlock x:Name="ActionsTabTwoWeeksText" Text="2 Weeks"
                                                   FontSize="13" FontWeight="Medium" Foreground="#475569" />
                                        <Border x:Name="ActionsTabTwoWeeksLine" Height="2" Background="Transparent" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Ari's actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#F1F5F9" VerticalAlignment="Bottom" />
                        </DockPanel>

                        <!-- Three summary cards -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SUGGESTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock x:Name="ActionsCardSuggestionsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ActionsCardSuggestionsRecent" Text="None yet" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" />
                                    <Border x:Name="ActionsCardSuggestionsTrack" Height="3" CornerRadius="2" Background="#252535">
                                        <Border x:Name="ActionsCardSuggestionsBarFill" Background="#6366F1" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="3" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIONS TAKEN" FontSize="10" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock x:Name="ActionsCardActionsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#16C784" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ActionsCardActionsRecent" Text="None yet" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" />
                                    <Border x:Name="ActionsCardActionsTrack" Height="3" CornerRadius="2" Background="#252535">
                                        <Border x:Name="ActionsCardActionsBarFill" Background="#16C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="3" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ALERTS" FontSize="10" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock x:Name="ActionsCardAlertsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ActionsCardAlertsRecent" Text="None yet" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" />
                                    <Border x:Name="ActionsCardAlertsTrack" Height="3" CornerRadius="2" Background="#252535">
                                        <Border x:Name="ActionsCardAlertsBarFill" Background="#F59E0B" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="3" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Unified event feed -->
                        <TextBlock x:Name="ActionsEmptyState"
                                   Text="Ari hasn't taken any actions yet."
                                   FontSize="13" Foreground="#475569"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="ActionsUnifiedFeed" />

                        <!-- LEGACY ELEMENTS — code-behind compat, never visible -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="ActionsSummaryLeadText" Text="" />
                            <TextBlock x:Name="ActionsTotalCountText" Text="0" />
                            <TextBlock x:Name="ActionsLastSeenText" Text="" />
                            <TextBlock x:Name="SuggestionsCountText" Text="0" />
                            <TextBlock x:Name="ChangesCountText" Text="0" />
                            <TextBlock x:Name="ActionsSuggestionsCountChip" Text="" />
                            <TextBlock x:Name="ActionsTotalCountChip" Text="" />
                            <TextBlock x:Name="ActionsLastActionValueText" Text="" />
                            <TextBlock x:Name="ActionsLastActionTimeText" Text="" />
                            <TextBlock x:Name="ActionsActiveSuggestionsText" Text="" />
                            <Button x:Name="ActionsSuggestionsTabButton" Click="ActionsSuggestionsTabButton_Click" />
                            <Button x:Name="ActionsChangesTabButton" Click="ActionsChangesTabButton_Click" />
                            <StackPanel x:Name="SuggestionsTabContent">
                                <TextBlock x:Name="SuggestionsEmptyStateText" Text="" />
                                <StackPanel x:Name="SuggestionsEmptyStatePanel" />
                                <ListView x:Name="SuggestionsListView" SelectionChanged="SuggestionsListView_SelectionChanged"
                                          PreviewMouseWheel="SuggestionsListView_PreviewMouseWheel">
                                    <ListView.ItemTemplate><DataTemplate><Border /></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="ChangesTabContent">
                                <TextBlock x:Name="ChangesEmptyStateText" Text="" />
                                <ListView x:Name="ChangesListView" SelectionChanged="ChangesListView_SelectionChanged"
                                          PreviewMouseWheel="ChangesListView_PreviewMouseWheel">
                                    <ListView.ItemTemplate><DataTemplate><Border /></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="ActionsTimelineStripPanel" Orientation="Horizontal" />
                            <TextBlock x:Name="ActionsTimelineEmptyText" Text="" />
                            <ScrollViewer x:Name="ActionDetailsScrollViewer"
                                          PreviewMouseWheel="ActionDetailsScrollViewer_PreviewMouseWheel">
                                <StackPanel>
                                    <TextBlock x:Name="ActionDrawerTitle" Text="" />
                                    <TextBlock x:Name="ActionDrawerWhen" Text="" />
                                    <TextBlock x:Name="ActionDrawerClassification" Text="" />
                                    <TextBlock x:Name="ActionDrawerDecisionState" Text="" />
                                    <TextBlock x:Name="ActionDrawerExecutionState" Text="" />
                                    <TextBlock x:Name="ActionDrawerCooldown" Text="" />
                                    <TextBlock x:Name="ActionDrawerUndo" Text="" />
                                    <TextBlock x:Name="ActionDrawerShortWhy" Text="" />
                                    <TextBlock x:Name="ActionDrawerRepeat" Text="" />
                                    <TextBlock x:Name="ActionDrawerWhatChanged" Text="" />
                                    <TextBlock x:Name="ActionDrawerWhyJson" Text="" />
                                    <Button x:Name="ActionDrawerUndoButton" Click="ActionDrawerUndoButton_Click" IsEnabled="False" />
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="ActionCategoryBreakFill" />
                            <Border x:Name="ActionCategoryFocusFill" />
                            <Border x:Name="ActionCategoryNotificationsFill" />
                            <Border x:Name="ActionCategoryProtectionFill" />
                            <Border x:Name="ActionCategoryOtherFill" />
                            <TextBlock x:Name="ActionCategoryBreakValue" Text="" />
                            <TextBlock x:Name="ActionCategoryFocusValue" Text="" />
                            <TextBlock x:Name="ActionCategoryNotificationsValue" Text="" />
                            <TextBlock x:Name="ActionCategoryProtectionValue" Text="" />
                            <TextBlock x:Name="ActionCategoryOtherValue" Text="" />
                            <CheckBox x:Name="InterventionNotificationToggle" Click="InterventionCategoryToggle_Click" />
                            <CheckBox x:Name="InterventionFocusModeToggle" Click="InterventionCategoryToggle_Click" />
                            <CheckBox x:Name="InterventionAnimationToggle" Click="InterventionCategoryToggle_Click" />
                            <CheckBox x:Name="InterventionAppRestrictionToggle" Click="InterventionCategoryToggle_Click" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#E2E8F0" />
                        </Style>
                        <Style TargetType="{x:Type CheckBox}">
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="#E2E8F0" />
                            <Setter Property="BorderBrush" Value="#334155" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style TargetType="{x:Type DatePicker}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style x:Key="ReadableSettingsComboItemStyle" TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Padding" Value="6,4" />
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE" />
                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20">

                        <!-- Hidden slider — still drives code-behind logic -->
                        <Slider x:Name="IntensitySlider" Minimum="0" Maximum="2" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="IntensitySlider_ValueChanged"
                                Visibility="Collapsed" />
                        <TextBlock x:Name="IntensityValueText" Visibility="Collapsed" Text="Balanced" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="INTENSITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PortaTextMutedBrush}" Margin="0,0,0,10" />
                                <UniformGrid x:Name="IntensityCardGrid" Columns="3" Margin="0,0,0,10">
                                    <Border x:Name="IntensityLightCard"
                                            CornerRadius="10" Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                            Padding="14" Margin="0,0,6,0" Cursor="Hand"
                                            MouseLeftButtonUp="IntensityCard_Click" Tag="0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="IntensityLightIcon" Fill="Transparent" Stroke="#64748B" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M12 19.5c1-3.5 5-4.5 5-9a6 6 0 0 0-12 0c0 4.5 4 5.5 5 9zm0 0v2.5m-1-2h2" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Light" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                                            <TextBlock Text="Gentle signals only" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="IntensityBalancedCard"
                                            CornerRadius="10" Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                            Padding="14" Margin="0,0,6,0" Cursor="Hand"
                                            MouseLeftButtonUp="IntensityCard_Click" Tag="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="IntensityBalancedIcon" Fill="Transparent" Stroke="#64748B" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M4 10h16M4 14h16M7 7l-3 3 3 3M17 7l3 3-3 3" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Balanced" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                                            <TextBlock Text="Recommended default" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="IntensityDeepCard"
                                            CornerRadius="10" Background="#1C1C2E" BorderBrush="#252535" BorderThickness="1"
                                            Padding="14" Cursor="Hand"
                                            MouseLeftButtonUp="IntensityCard_Click" Tag="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Viewbox Width="22" Height="22" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="IntensityDeepIcon" Fill="Transparent" Stroke="#64748B" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M15.5 5C16.5 5 18 6.5 18 10s-2 5-3.5 5H12m-3.5-10C7.5 5 6 6.5 6 10s2 5 3.5 5H12m0 0v4m0-14v.5" />
                                                </Canvas>
                                            </Viewbox>
