
<Window x:Class="Porta.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:Porta.ControlCenter.Controls"
        Title="Ari"
        Icon="Assets/PortaAppIcon.png"
        Height="820"
        Width="1280"
        MinHeight="580"
        MinWidth="920"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource PortaContentHeaderBrush}"
        Foreground="{DynamicResource PortaTextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Inter"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarItemInfo" Description="Ari" />
    </Window.TaskbarItemInfo>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Step 10 — the card design values, for the Projects and Reports pages. Kept
                     separate on purpose: the Porta* brushes below are a different palette, and
                     redefining them would restyle every page in one unreviewed change. -->
                <ResourceDictionary Source="Themes/ReportTheme.xaml" />
                <!-- Implicit, and app-wide on purpose: a stock Windows scrollbar beside a themed
                     page is what made the themed page look like it came from somewhere else. -->
                <ResourceDictionary Source="Themes/ScrollBarTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <!-- Surface / border / text -->
        <SolidColorBrush x:Key="PortaSurfaceBaseBrush" Color="#1C1C2E" />
        <SolidColorBrush x:Key="PortaSurfaceElevatedBrush" Color="#1B1F25" />
        <SolidColorBrush x:Key="PortaSurfaceHoverBrush" Color="#1D232A" />
        <SolidColorBrush x:Key="PortaBorderBrush" Color="#252535" />
        <SolidColorBrush x:Key="PortaBorderHoverBrush" Color="#3A3A50" />
        <SolidColorBrush x:Key="PortaTextPrimaryBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="PortaTextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="PortaTextMutedBrush" Color="#475569" />
        <SolidColorBrush x:Key="PortaTextBodyBrush" Color="#CBD5E1" />
        <!-- Surface brushes (theme-aware — updated by ApplyTheme) -->
        <SolidColorBrush x:Key="PortaTitleBarBrush" Color="#080809" />
        <SolidColorBrush x:Key="PortaContentHeaderBrush" Color="#0D0D12" />
        <SolidColorBrush x:Key="PortaCardBrush" Color="#0F0F18" />
        <SolidColorBrush x:Key="PortaCardBorderBrush" Color="#252535" />
        <SolidColorBrush x:Key="PortaBubbleBrush" Color="#111119" />
        <SolidColorBrush x:Key="PortaDividerBrush" Color="#1C1C28" />
        <SolidColorBrush x:Key="PortaNavHoverBrush" Color="#0F0F1A" />
        <SolidColorBrush x:Key="PortaNavActiveBrush" Color="#17171F" />
        <SolidColorBrush x:Key="PortaButtonBrush" Color="#1A1F26" />
        <SolidColorBrush x:Key="PortaButtonPressedBrush" Color="#161B22" />
        <!-- Semantic colours -->
        <SolidColorBrush x:Key="PortaFocusBrush" Color="#16C784" />
        <SolidColorBrush x:Key="PortaWarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="PortaDangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="PortaAccentBrush" Color="#6366F1" />

        <!-- Nav button style — icon + label, green active state with left accent -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBg"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="LeftAccent"
                                           Width="2"
                                           HorizontalAlignment="Left"
                                           Fill="Transparent" />
                                <ContentPresenter Margin="16,9,16,9"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PortaNavHoverBrush}" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PortaNavActiveBrush}" />
                                <Setter TargetName="LeftAccent" Property="Fill" Value="#16C784" />
                                <Setter Property="Foreground" Value="#16C784" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="active" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PortaNavActiveBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PortaTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PortaButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PortaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PortaSurfaceHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource PortaBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PortaButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PortaSurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PortaCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PortaTextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QuietHoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PortaDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,0,0,16" />
        </Style>

        <Style x:Key="QuietHoverSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PortaDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,0,8,12" />
        </Style>

        <Style x:Key="QuietHoverSubCardCompactStyle" TargetType="Border" BasedOn="{StaticResource QuietHoverSubCardStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="RoundedInputChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PortaBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PortaTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="{DynamicResource PortaSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonChrome" Property="Background" Value="#12161B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A61E2E" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#821625" />
                </Trigger>
            </Style.Triggers>
        </Style>
    <!-- ReadableSettingsComboItemStyle — used by PauseUntilTimeComboBox -->
    <Style x:Key="ReadableSettingsComboItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="#111827" />
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="Padding" Value="6,4" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#DBEAFE" />
                <Setter Property="Foreground" Value="#1E3A8A" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Toggle switch style for CheckBox — used in Settings Features section -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="#334155" VerticalAlignment="Center">
                        <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#6366F1" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>        <Style x:Key="ClickableAccordionStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PortaDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17171F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource PortaCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PortaTextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PortaSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PortaNavActiveBrush}" />
                                <Setter Property="Foreground" Value="#16C784" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PortaCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PortaTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#252535" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                        Grid.Column="0"
                                        IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}" />
                                    <Path Grid.Column="1"
                                        Data="M0,0 L5,5 L10,0"
                                        Stroke="#94A3B8" StrokeThickness="1.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                Opacity="0"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press" />
                            <Popup x:Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="{DynamicResource PortaCardBrush}"
                                            BorderBrush="{DynamicResource PortaCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#3A3A50" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#16C784" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource PortaTitleBarBrush}" BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBarRoot" MouseLeftButtonDown="TitleBarRoot_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ari"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PortaTextPrimaryBrush}" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TitleBarMinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMinimizeButton_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="TitleBarMaximizeButton_Click">
                        <TextBlock x:Name="TitleBarMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="TitleBarCloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="TitleBarCloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PortaTitleBarBrush}" BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand area -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                    <TextBlock Text="Ari"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource PortaTextPrimaryBrush}" />
                    <TextBlock x:Name="SidebarDateText"
                               FontSize="11"
                               Foreground="{DynamicResource PortaTextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource PortaDividerBrush}" Margin="0,0,0,6" />

                <!-- Primary nav -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButtonStyle}" Click="OverviewNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4 5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5zm10 0a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V5zM4 13a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2zm10 0a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-4z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Today" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TasksNavButton" Style="{StaticResource NavButtonStyle}" Click="TasksNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M13 3L5 14h7l-1 7 9-11h-7z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Tasks" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProjectsNavButton" Style="{StaticResource NavButtonStyle}" Click="ProjectsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7zm10-3a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Projects" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReportsNavButton" Style="{StaticResource NavButtonStyle}" Click="ReportsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm3 9h7m-7 4h7m-7-8h3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Reports" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatesNavButton" Style="{StaticResource NavButtonStyle}" Click="StatesNavButton_Click" Visibility="Collapsed">
                        <TextBlock Text="Advanced" FontSize="13" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M10.325 4.317a1.724 1.724 0 0 0 3.35 0 1.724 1.724 0 0 1 2.573 1.066 1.724 1.724 0 0 0 2.372 2.372 1.724 1.724 0 0 1 1.065 2.572 1.724 1.724 0 0 0 0 3.35 1.724 1.724 0 0 1-1.065 2.573 1.724 1.724 0 0 0-2.372 2.372 1.724 1.724 0 0 1-2.573 1.065 1.724 1.724 0 0 0-3.35 0 1.724 1.724 0 0 1-2.572-1.065 1.724 1.724 0 0 0-2.372-2.372 1.724 1.724 0 0 1-1.066-2.573 1.724 1.724 0 0 0 0-3.35 1.724 1.724 0 0 1 1.066-2.572 1.724 1.724 0 0 0 2.372-2.372 1.724 1.724 0 0 1 2.572-1.066zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource PortaDividerBrush}" Margin="16,6,16,6" />

                <!-- Secondary nav -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="TimelineNavButton" Style="{StaticResource NavButtonStyle}" Click="TimelineNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4 19L8 13l4 4 4-8 4 4" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="History" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AccountNavButton" Style="{StaticResource NavButtonStyle}" Click="AccountNavButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M12 2a10 10 0 1 1 0 20A10 10 0 0 1 12 2zm0 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm0 13c-2.67 0-5-.93-6.3-2.3A9.96 9.96 0 0 1 12 15c2.66 0 5.07 1.07 6.3 2.7A9.96 9.96 0 0 1 12 20z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Account" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="AccountNavUpdateBadgeBorder"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Background="#C1121F"
                                    BorderBrush="#F87171"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="AccountNavUpdateBadgeText"
                                           Text="1"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButtonStyle}" Click="DiagnosticsNavButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M3 12h3l3-7 3 14 2-7h5" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="System" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PortaContentHeaderBrush}"
                    BorderBrush="{DynamicResource PortaDividerBrush}"
                    BorderThickness="0,0,0,1"
                    MinHeight="48"
                    ClipToBounds="True">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock x:Name="SectionTitleText"
                                   Text="Today"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PortaTextPrimaryBrush}" />
                        <!-- Legacy status pills — kept for code-behind compatibility, not visible -->
                        <WrapPanel Visibility="Collapsed">
                            <Border x:Name="StatusPillBorder" CornerRadius="12" Background="#1D4ED8" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="StatusPillText" Text="Running" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="ConsentBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="ConsentBadgeText" Text="Consent: Needed" />
                            </Border>
                            <Border x:Name="CalibrationBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="CalibrationBadgeText" Text="Learning your pattern: Bootstrapping" />
                            </Border>
                            <Border x:Name="TrustBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,8">
                                <TextBlock x:Name="TrustBadgeText" Text="Confidence: Low" />
                            </Border>
                            <Button x:Name="GlobalUpdateButton"
                                    Padding="12,6"
                                    Margin="0,0,10,8"
                                    Visibility="Collapsed"
                                    ToolTip="Open update details"
                                    Click="GlobalUpdateButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GlobalUpdateButtonText"
                                               Text="Update ready"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Border x:Name="GlobalUpdateButtonBadgeBorder"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Background="#C1121F"
                                            BorderBrush="#F87171"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="GlobalUpdateButtonBadgeText"
                                                   Text="1"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                                                    </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Status chip removed — hidden elements kept for code-behind compat -->
                        <Border x:Name="HeaderStatusChipBorder" Visibility="Collapsed">
                            <TextBlock x:Name="HeaderStatusChipText" Text="" />
                        </Border>
                        <!-- Why/Refresh/Versions hidden — moved to contextual page locations -->
                        <Button x:Name="WhyDrawerToggleButton" Content="Why" Padding="12,6" Margin="0,0,10,0" Click="WhyDrawerToggleButton_Click" Visibility="Collapsed" />
                        <Button x:Name="QuickPauseResumeButton" Content="Pause" Padding="10,5" Margin="0,0,0,0" Click="QuickPauseResumeButton_Click" />
                        <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6" Margin="0,0,10,0" Click="RefreshButton_Click" Visibility="Collapsed" />
                        <Grid VerticalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="VersionsButton"
                                    Padding="12,6"
                                    MinWidth="102"
                                    ToolTip="Agent, UI, and schema versions"
                                    Click="VersionsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Versions"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="&#xE70D;"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="VersionsPopup"
                                   PlacementTarget="{Binding ElementName=VersionsButton}"
                                   Placement="Bottom"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Width="236"
                                        Padding="12"
                                        Background="{DynamicResource PortaBubbleBrush}"
                                        BorderBrush="#2E3641"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="Versions"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PortaTextSecondaryBrush}"
                                                   Margin="0,0,0,10" />
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Agent"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="AgentVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="UI"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="UiVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Schema"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                                <TextBlock x:Name="SchemaVersionText"
                                                           Text="Not available"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPanel"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              IsManipulationEnabled="True"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="OverviewPanel_PreviewMouseWheel">
                    <StackPanel Margin="20,24,20,0">
                        <!-- Greeting row hidden — Ari bubble replaces it; state chip removed as redundant with widget -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="TodayGreetingText" Text="Good morning" />
                            <TextBlock x:Name="TodayDateText" />
                            <Border x:Name="TodayStateChipBorder">
                                <TextBlock x:Name="TodayStateChipText" Text="● Focused now" />
                            </Border>
                        </StackPanel>
                        <!-- Ari bubble -->
                        <Border Background="{DynamicResource PortaBubbleBrush}"
                                BorderBrush="{DynamicResource PortaDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="● ARI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#16C784"
                                           Margin="0,0,0,5" />
                                <TextBlock x:Name="TodaySummaryText"
                                           Text="Today keeps work, last focus session, and pressure synced with the widget."
                                           Foreground="{DynamicResource PortaTextSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <!-- Three metric cards — non-clickable; Work Today has View History link -->
                        <UniformGrid Columns="3" Margin="0,0,0,30">
                            <!-- Work Today (only card with a link) -->
                            <Border x:Name="NowOverloadCard"
                                    Background="{DynamicResource PortaCardBrush}"
                                    BorderBrush="{DynamicResource PortaCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14,16,14"
                                    Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="WORK TODAY"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="NowOverloadValueText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PortaTextPrimaryBrush}" />
                                    <TextBlock x:Name="NowOverloadActiveText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                    <TextBlock x:Name="NowOverloadTrustText" Text="" Margin="0,3,0,0" Visibility="Collapsed"
                                               FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                    <Border x:Name="WorkTodayTrack" Height="4" CornerRadius="2" Background="{DynamicResource PortaDividerBrush}" Margin="0,8,0,6">
                                        <Border x:Name="WorkTodayProgressFill" Background="#475569" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <!-- View History link — bottom-right, only interactive element -->
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="View History →"
                                                   FontSize="11" Foreground="{DynamicResource PortaTextSecondaryBrush}"
                                                   Cursor="Hand"
                                                   MouseLeftButtonUp="NowDetailCard_MouseLeftButtonUp"
                                                   Tag="today-work" />
                                    </DockPanel>
                                    <TextBlock x:Name="NowOverloadSummaryText" Visibility="Collapsed"
                                               Text="" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Focus Score — no link, no click -->
                            <Border x:Name="NowFocusCard"
                                    Background="{DynamicResource PortaCardBrush}"
                                    BorderBrush="#6616C784"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14,16,14"
                                    Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="FOCUS SCORE"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#16C784" Margin="0,0,0,6" />
                                    <TextBlock x:Name="NowFocusStreakValueText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#16C784" />
                                    <TextBlock x:Name="NowDeepWorkStreakText" Text="" Margin="0,5,0,0"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#16C784" Visibility="Collapsed" />
                                    <TextBlock x:Name="NowFocusChoppinessText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Visibility="Collapsed" />
                                    <Border x:Name="FocusScoreTrack" Height="4" CornerRadius="2" Background="{DynamicResource PortaDividerBrush}" Margin="0,8,0,0">
                                        <Border x:Name="FocusScoreProgressFill" Background="#16C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <TextBlock x:Name="NowFocusSummaryText" Visibility="Collapsed" Text="" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusFootnoteText" Visibility="Collapsed" Text="" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusStatusText" Visibility="Collapsed" Text="" Foreground="{DynamicResource PortaWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Pressure — no link, no click -->
                            <Border x:Name="NowCalibrationCard"
                                    Background="{DynamicResource PortaCardBrush}"
                                    BorderBrush="#66F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14,16,14"
                                    Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRESSURE"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#F59E0B" Margin="0,0,0,6" />
                                    <TextBlock x:Name="NowCalibrationStatusText" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="#16C784" />
                                    <!-- NowCalibrationProgressText hidden — "Regulation · normal" is developer text -->
                                    <TextBlock x:Name="NowCalibrationProgressText" Text="" Visibility="Collapsed"
                                               FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                    <TextBlock x:Name="NowCalibrationQualityText" Text="" Margin="0,4,0,0"
                                               FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                    <Border x:Name="PressureTrack" Height="4" CornerRadius="2" Background="{DynamicResource PortaDividerBrush}" Margin="0,8,0,0">
                                        <Border x:Name="PressureProgressFill" Background="#94A3B8" CornerRadius="2" HorizontalAlignment="Left" Width="0" Height="4" />
                                    </Border>
                                    <TextBlock x:Name="NowCalibrationColdStartText" Visibility="Collapsed" Text="" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                    <TextBlock x:Name="NowCalibrationSummaryText" Visibility="Collapsed" Text="" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowCalibrationTrustCapText" Visibility="Collapsed" Text="Analysis catching up." Foreground="{DynamicResource PortaWarningBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <!-- Task attribution (2026-09-01) — real work Ari could not place on a task.
                             One line, collapsed when there is none. It exists because the only
                             VISIBLE effect of the attribution change is that a task's hours are
                             lower than expected, and without this the honest answer and a bug look
                             identical. Asking about it is a separate piece of work. -->
                        <TextBlock x:Name="TodayUnassignedText"
                                   Text=""
                                   FontSize="13"
                                   Margin="0,-16,0,26"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PortaTextSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <!-- Supporting cards hidden — only 3 metric cards shown -->
                        <StackPanel Visibility="Collapsed">
                            <Border x:Name="CurrentSessionCard">
                                <StackPanel>
                                    <TextBlock x:Name="CurrentSessionValueText" Text="—" />
                                    <TextBlock x:Name="CurrentSessionSubText" Text="" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DistractionsCard">
                                <StackPanel>
                                    <TextBlock x:Name="DistractionsValueText" Text="—" />
                                    <TextBlock x:Name="DistractionsSubText" Text="" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Session timeline -->
                        <TextBlock Text="SESSION TIMELINE — TODAY"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PortaTextSecondaryBrush}"
                                   Margin="0,0,0,16" />
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="0,0,0,20">
                            <StackPanel>
                                <Grid x:Name="SessionTimelineBar" Height="22">
                                    <Border Background="{DynamicResource PortaCardBorderBrush}" CornerRadius="4" />
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Border CornerRadius="4" Background="#1416C784" BorderBrush="#2216C784" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Focus" Foreground="#16C784" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#148B5CF6" BorderBrush="#228B5CF6" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Distraction" Foreground="#8B5CF6" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Background="#143B82F6" BorderBrush="#223B82F6" BorderThickness="1" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Away" Foreground="#3B82F6" FontSize="11" />
                                    </Border>
                                                                    </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- Quick action buttons -->
                        <WrapPanel Margin="0,24,0,24">
                            <Border CornerRadius="6" Background="Transparent" BorderBrush="#334155" BorderThickness="1"
                                    Padding="10,7" Margin="0,0,10,0" Cursor="Hand"
                                    MouseLeftButtonUp="WhyDrawerToggleButton_Click">
                                <TextBlock Text="What's pushing my pressure? ↗" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextSecondaryBrush}" /></Border>
                        </WrapPanel>
                        <TextBlock x:Name="NowWaitingDataText"
                                   Text="Waiting for service data"
                                   Foreground="#9AA4B2"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                        <Border x:Name="NowRecoveryBannerBorder"
                                Background="#102019"
                                BorderBrush="{DynamicResource PortaCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="NowRecoveryDismissButton"
                                        DockPanel.Dock="Right"
                                        Content="Dismiss"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        MinHeight="28"
                                        Click="NowRecoveryDismissButton_Click" />
                                <TextBlock x:Name="NowRecoveryBannerText"
                                           Text=""
                                           Foreground="#7FD1A3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="UpdatedValue" Margin="0,10,0,0" Foreground="{DynamicResource PortaTextSecondaryBrush}" Text="" Visibility="Collapsed" />
                        <TextBlock x:Name="DebugFooterText" Margin="0,6,0,0" Foreground="#F59E0B" FontFamily="Consolas" FontSize="11" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <!-- Phase 3.1 (2026-08-18) — Tasks. A SHELL this session, deliberately.
                     The nav is being made final now so it is only learned once; the page behind
                     this entry is built in its own session. An honest empty state beats a
                     half-built list that has to be relearned. -->
                <ScrollViewer x:Name="TasksPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              IsManipulationEnabled="True" PanningMode="VerticalOnly"
                              Background="#0E1013">
                    <StackPanel x:Name="TasksPageHost" Margin="40,30,40,40" />
                </ScrollViewer>
                <ScrollViewer x:Name="ReportsPageV2Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              IsManipulationEnabled="True" PanningMode="VerticalOnly"
                              Background="#0E1013">
                    <StackPanel x:Name="ReportsPageHost" Margin="40,30,40,40" />
                </ScrollViewer>

                <!-- Phase 3.2 (2026-08-18) — Projects, promoted out of Settings.
                     A project is the ENGAGEMENT: who it is for, whether it is running, when it
                     started, when it finished, who its reports go to, and how often. The rows and
                     every field editor inside them are built in MainWindow.Projects.cs, because a
                     project's shape is data and repeating it in markup would mean two places to
                     change. Everything on this page is LOCAL. -->
                <ScrollViewer x:Name="ProjectsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              IsManipulationEnabled="True" PanningMode="VerticalOnly"
                              Background="#0E1013">
                    <StackPanel x:Name="ProjectsPageHost" Margin="40,30,40,40" />
                </ScrollViewer>


                <!-- Phase 3.1 (2026-08-18) — Reports, promoted out of Settings. The send flow
                     is unchanged; only where it lives has changed. The Drafts / Ready / Sent /
                     Archived history is a separate session and is deliberately not started. -->
                <ScrollViewer x:Name="ReportsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              IsManipulationEnabled="True" PanningMode="VerticalOnly">
                    <StackPanel Margin="20,20,20,32">
                            <!-- Step 10 — the Reports page. The DRAFT is local and derived: rebuilt
                                 on every request, never stored. The stored thing is the snapshot
                                 taken when a report is actually sent.

                                 Sending is BUILT (phase C/D). The draft leads to SEND TO, which
                                 leads to the confirm screen, where the Send button lives. It sits
                                 there and not here on purpose: the address is chosen on one screen
                                 and checked on the next, because a send cannot be undone. -->
                                <TextBlock Text="Reports" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="A client's account of the work: measured hours, per project, over a range of days. Nothing here is sent anywhere yet - this is the draft, so you can see whether it tells the truth before it can ever leave the machine." FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                                <Border Style="{StaticResource RpPanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="PROJECT AND RANGE" Style="{StaticResource RpSectionLabel}" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <!-- An explicit ItemTemplate, not DisplayMemberPath: the picker
                                                 otherwise falls back to the record's ToString() and prints
                                                 the whole object. It must not depend on one code path
                                                 having run first. -->
                                            <ComboBox x:Name="ReportProjectPicker" Grid.Column="0" Style="{StaticResource RpComboBox}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- AriDatePicker, not DatePicker: "8/12/2026" means two different
                                                 days depending on where the reader lives, and this range ends
                                                 up on a document about which days were worked. -->
                                            <ctl:AriDatePicker x:Name="ReportFromPicker" Grid.Column="1" Style="{StaticResource RpDatePicker}" Width="150" Margin="0,0,8,0" VerticalAlignment="Center" SelectedDateChanged="ReportRangeChanged" />
                                            <ctl:AriDatePicker x:Name="ReportToPicker" Grid.Column="2" Style="{StaticResource RpDatePicker}" Width="150" Margin="0,0,8,0" VerticalAlignment="Center" SelectedDateChanged="ReportRangeChanged" />
                                            <Button x:Name="ReportBuildButton" Grid.Column="3" Content="Build draft" Style="{StaticResource RpPrimaryButton}" VerticalAlignment="Center" Click="ReportBuildButton_Click" />
                                        </Grid>
                                        <TextBlock x:Name="ReportStatusText" Style="{StaticResource RpMeta}" />
                                        <!-- Two different ranges on one screen, with nothing saying
                                             which one the figures belong to, is the exact ambiguity
                                             this document cannot carry. -->
                                        <TextBlock x:Name="ReportStaleText" Style="{StaticResource RpMeta}" Margin="0,6,0,0" Visibility="Collapsed"
                                                   Text="These dates have changed since the draft below was built, so the figures still belong to the old range. Press Build draft again." />
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ReportDraftPanel" Visibility="Collapsed">

                                    <!-- The report itself sits on the card colour, one shade below
                                         the panels around it, so it reads as the document rather
                                         than as another section of settings. -->
                                    <Border Background="{StaticResource RpCard}"
                                            BorderBrush="{StaticResource RpHairline}"
                                            BorderThickness="0.5"
                                            CornerRadius="{StaticResource RpCornerOuter}"
                                            Padding="20" Margin="0,0,0,14">
                                        <StackPanel>
                                            <!-- Item 4 (Chat 8 decision, 2026-08-25) — the name the client sees is edited HERE,
                                                 on the screen where it is read. It used to be a read-only headline that told you
                                                 to go and fix it on the Projects page: the single biggest piece of text a client
                                                 reads, corrected on a different screen from the one you are checking it on.
                                                 Label above the input, plain question, sentence case — the locked rule. -->
                                            <TextBlock Text="What should your client call this project?" Style="{StaticResource RpBody}" Margin="0,0,0,1" />
                                            <TextBlock Text="The biggest text on the page they receive." Style="{StaticResource RpMeta}" Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,2">
                                                <TextBox x:Name="ReportClientNameBox" FontSize="22" FontWeight="Medium"
                                                         Style="{StaticResource RpInlineEditBox}"
                                                         Foreground="{StaticResource RpTextPrimary}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="ReportClientNamePlaceholder" Text="Name this project for your client"
                                                           FontSize="22" FontStyle="Italic" Foreground="{StaticResource RpTextMuted}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"
                                                           Visibility="Collapsed" TextWrapping="Wrap" />
                                            </Grid>
                                            <!-- The private name stays visible and stays private. It is how you tell which
                                                 project this is; it has never left the machine and still does not. -->
                                            <TextBlock x:Name="ReportLocalNameText" Style="{StaticResource RpMeta}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ReportRangeText" Style="{StaticResource RpBody}" Margin="0,0,0,2" />
                                            <!-- Everything below the name is measured. Said once, quietly, so the absence of an
                                                 edit affordance reads as deliberate rather than as something not built yet. -->
                                            <TextBlock Text="Dates and hours are measured. They are never editable."
                                                       Style="{StaticResource RpMeta}" Margin="0,0,0,18" />

                                            <Border Background="{StaticResource RpPanel}"
                                                    BorderBrush="{StaticResource RpHairline}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="{StaticResource RpCornerInner}"
                                                    Padding="16,14" Margin="0,0,0,18">
                                                <UniformGrid Columns="3">
                                                    <StackPanel>
                                                        <TextBlock x:Name="ReportHoursValue" Style="{StaticResource RpFigure}" />
                                                        <TextBlock Text="HOURS" Style="{StaticResource RpSectionLabel}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock x:Name="ReportDaysValue" Style="{StaticResource RpFigure}" />
                                                        <TextBlock Text="DAYS WORKED" Style="{StaticResource RpSectionLabel}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock x:Name="ReportDoneValue" Style="{StaticResource RpFigure}" />
                                                        <TextBlock Text="COMPLETED" Style="{StaticResource RpSectionLabel}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Border>

                                            <Border Background="{StaticResource RpPanel}"
                                                    BorderBrush="{StaticResource RpHairline}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="{StaticResource RpCornerInner}"
                                                    Padding="16,14" Margin="0,0,0,18">
                                                <StackPanel>
                                                    <TextBlock Text="HOURS BY DAY" Style="{StaticResource RpSectionLabel}" />
                                                    <StackPanel x:Name="ReportDaysChart" Orientation="Horizontal" Height="92" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="ReportFloorNote" Style="{StaticResource RpMeta}" Margin="0,8,0,0" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{StaticResource RpPanel}"
                                                    BorderBrush="{StaticResource RpHairline}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="{StaticResource RpCornerInner}"
                                                    Padding="16,14">
                                                <StackPanel>
                                                    <TextBlock Text="THE WORK" Style="{StaticResource RpSectionLabel}" />
                                                    <StackPanel x:Name="ReportLinesList" />

                                                    <!-- An empty state that leaves the user stuck is a
                                                         dead end. It says what to do next, and where. -->
                                                    <StackPanel x:Name="ReportLinesEmptyText" Visibility="Collapsed">
                                                        <TextBlock Text="No measured hours for this project yet." FontSize="13" FontWeight="Medium" Foreground="{StaticResource RpTextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock Text="Hours arrive here once a task is tagged to this project. Tag one on the morning card when you name the day's work, or from “+ task” on the widget — then work on it as usual and it will show up." Style="{StaticResource RpBody}" Margin="0,6,0,0" />
                                                        <TextBlock Text="Nothing is counted until a task carries the project, so an untagged day is not lost — it simply belongs to no project." Style="{StaticResource RpMeta}" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Phase 1.4 / 2b — Ari's draft, editable. It appears already
                                         written; the user edits or replaces it; whatever is here at
                                         send time is what goes out. Empty is valid and omits the
                                         section on the client's page. -->
                                    <Border Style="{StaticResource RpPanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="SUMMARY" Style="{StaticResource RpSectionLabel}" />
                                            <TextBox x:Name="ReportSummaryBox"
                                                     Style="{StaticResource RpTextBox}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="86"
                                                     VerticalScrollBarVisibility="Auto" />
                                            <TextBlock x:Name="ReportSummaryNote" Style="{StaticResource RpMeta}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- CONDITION 2 (Yadin, 2026-08-17). Both of these can embarrass
                                         someone if they go out unread, and a blocked reason often
                                         names the recipient. Shown in the order the client reads
                                         them, before anything can be sent. -->
                                    <Border x:Name="ReportClientSeesPanel" Style="{StaticResource RpPanelBorder}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="WHAT THE CLIENT WILL READ" Style="{StaticResource RpSectionLabel}" />
                                            <StackPanel x:Name="ReportClientSeesList" />
                                            <TextBlock Text="Collected earlier, going out now. Change any of it on the task before you send." Style="{StaticResource RpMeta}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RpPanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="BEFORE THIS CAN BE SENT" Style="{StaticResource RpSectionLabel}" />
                                            <TextBlock x:Name="ReportReadinessText" FontSize="12" Foreground="{StaticResource RpTextPrimary}" TextWrapping="Wrap" />
                                            <!-- Set in RenderReadiness. It was hardcoded to "sending
                                                 is not built yet" and stayed that way after sending
                                                 was built, so the page told the user the feature did
                                                 not exist while it did. Never hardcode state here. -->
                                            <TextBlock x:Name="ReportReadinessNote" Style="{StaticResource RpMeta}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Time is recorded automatically while the work was actively in progress. Breaks and time away are not included." Style="{StaticResource RpMeta}" Margin="2,0,0,0" />

                                    <!-- Phase C — who it goes to. Deliberately a step BEFORE the
                                         confirm screen rather than a Send button that fires: the
                                         address is chosen here, checked there. -->
                                    <Border Style="{StaticResource RpPanelBorder}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SEND TO" Style="{StaticResource RpSectionLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- RpComboBoxEditable, NOT RpComboBox: the shared
                                                     style has no PART_EditableTextBox, so
                                                     IsEditable there is inert and the field can
                                                     never take a caret. -->
                                                <ComboBox x:Name="ReportRecipientPicker" Grid.Column="0" Style="{StaticResource RpComboBoxEditable}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <Button x:Name="ReportSendToButton" Grid.Column="1" Content="Continue" Style="{StaticResource RpPrimaryButton}" VerticalAlignment="Center" Click="ReportSendToButton_Click" />
                                            </Grid>
                                            <TextBlock x:Name="ReportRecipientNote" Style="{StaticResource RpMeta}" Margin="0,8,0,0" Text="Type a client's email, or pick one you've sent to before. Nothing is sent until you confirm." />
                                            <!-- Phase 2b — the link, so it can go through WhatsApp
                                                 or Slack without an email at all. Only ever visible
                                                 after a send has actually produced one. -->
                                            <StackPanel x:Name="ReportLinkRow" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                                <Button x:Name="ReportCopyLinkButton" Content="Copy link" Style="{StaticResource RpQuietButton}" Click="ReportCopyLinkButton_Click" />
                                                <TextBlock x:Name="ReportLinkText" Style="{StaticResource RpMeta}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- §6b — the confirm step. The last thing the user sees before a
                                     client does, so all three addresses are here in full and each is
                                     editable in place. Sending to a wrong address cannot be undone,
                                     which is the whole reason this screen exists. -->
                                <StackPanel x:Name="ReportConfirmPanel" Visibility="Collapsed">
                                    <Border Background="{StaticResource RpCard}"
                                            BorderBrush="{StaticResource RpHairline}"
                                            BorderThickness="0.5"
                                            CornerRadius="{StaticResource RpCornerOuter}"
                                            Padding="20" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Send this report" FontSize="18" FontWeight="Medium" Foreground="{StaticResource RpTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock x:Name="ReportConfirmSubtitle" Style="{StaticResource RpBody}" Margin="0,0,0,18" />

                                            <!-- THE EMAIL. A list of labelled values, not a form of
                                                 boxes: at rest each one reads as text and the field
                                                 appears on click. Same lesson as the project rows. -->
                                            <Border Background="{StaticResource RpPanel}"
                                                    BorderBrush="{StaticResource RpHairline}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="{StaticResource RpCornerInner}"
                                                    Padding="16,14" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="THE EMAIL" Style="{StaticResource RpSectionLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From name" FontSize="12" Foreground="{StaticResource RpTextSecond}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                        <TextBox x:Name="ConfirmFromNameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource RpInlineEditBox}" Margin="0,0,0,2" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="From" FontSize="12" Foreground="{StaticResource RpTextSecond}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                        <!-- Deliberately not a field: it is the
                                                             product's address, not the user's. -->
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,2">
                                                            <TextBlock Text="reports@useporta.com" FontSize="13" Foreground="{StaticResource RpTextSecond}" VerticalAlignment="Center" />
                                                            <TextBlock Text="fixed" Style="{StaticResource RpMeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Reply-to" FontSize="12" Foreground="{StaticResource RpTextSecond}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                        <TextBox x:Name="ConfirmReplyToBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource RpInlineEditBox}" Margin="0,0,0,2" />

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="To" FontSize="12" Foreground="{StaticResource RpTextSecond}" VerticalAlignment="Center" />
                                                        <TextBox x:Name="ConfirmToBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource RpInlineEditBox}" />
                                                    </Grid>

                                                    <!-- Set in OpenReportConfirmAsync: it says something
                                                         different when Ari could not read the account's
                                                         name and email, because then these two boxes
                                                         arrive blank and the send is refused until
                                                         they are filled in. -->
                                                    <TextBlock x:Name="ConfirmSenderNote" Style="{StaticResource RpMeta}" Margin="6,12,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- What they receive, so the envelope and the document
                                                 are checked on the same screen. -->
                                            <Border Background="{StaticResource RpPanel}"
                                                    BorderBrush="{StaticResource RpHairline}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="{StaticResource RpCornerInner}"
                                                    Padding="16,14">
                                                <StackPanel>
                                                    <TextBlock Text="WHAT THEY RECEIVE" Style="{StaticResource RpSectionLabel}" />
                                                    <TextBlock x:Name="ConfirmDocumentHeadline" FontSize="14" FontWeight="Medium" Foreground="{StaticResource RpTextPrimary}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="ConfirmDocumentRange" Style="{StaticResource RpBody}" Margin="0,3,0,0" />
                                                    <TextBlock x:Name="ConfirmDocumentFigures" FontSize="13" Foreground="{StaticResource RpTextPrimary}" Margin="0,8,0,0" Typography.NumeralAlignment="Tabular" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- The refusal. Structure and words rather than a new colour:
                                         the agreed palette has no error red, and inventing one here
                                         would be the fourth thing green drifted into. -->
                                    <Border x:Name="ConfirmRefusalPanel" Style="{StaticResource RpPanelBorder}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="CAN'T SEND YET" Style="{StaticResource RpSectionLabel}" />
                                            <TextBlock x:Name="ConfirmRefusalText" FontSize="13" Foreground="{StaticResource RpTextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ConfirmRefusalHelp" Style="{StaticResource RpMeta}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Only ever shown when the browser refused to open. It wraps on
                                         its own row rather than sharing the button row, where a long
                                         path squeezed the buttons off the edge. -->
                                    <TextBlock x:Name="ConfirmPreviewPathText"
                                               Style="{StaticResource RpMeta}"
                                               Margin="2,8,2,0"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ConfirmCancelButton" Grid.Column="0" Content="Back to the draft" Style="{StaticResource RpQuietButton}" Click="ConfirmCancelButton_Click" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="ConfirmSendNote" Style="{StaticResource RpMeta}" VerticalAlignment="Center" Margin="0,0,12,0" TextAlignment="Right" />
                                            <Button x:Name="ConfirmPreviewButton" Content="Preview what they receive" Style="{StaticResource RpQuietButton}" Click="ConfirmPreviewButton_Click" />
                                        </StackPanel>
                                        <Button x:Name="ConfirmSendButton" Grid.Column="2" Content="Send report" Style="{StaticResource RpPrimaryButton}" Click="ConfirmSendButton_Click" />
                                    </Grid>
                                </StackPanel>
                    </StackPanel>
                </ScrollViewer>


                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource PortaTitleBarBrush}" BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="12,20,12,12">
                            <TextBlock Text="Settings" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}" Margin="4,0,0,20" />
                            <Border x:Name="SettingsNavIntensity" Background="#17171F" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Intensity" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#E2E8F0" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12 19.5c1-3.5 5-4.5 5-9a6 6 0 0 0-12 0c0 4.5 4 5.5 5 9zm0 0v2.5m-1-2h2" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavIntensityText" Text="Intensity" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavPrivacy" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Privacy" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12 2l7 4v6c0 5-3.5 9-7 10C8.5 21 5 17 5 12V6l7-4z" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavPrivacyText" Text="Privacy" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavCollection" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Collection" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6 4h4v16H6zm8 0h4v16h-4z" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavCollectionText" Text="Collection" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavCalibration" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Calibration" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3 12h4l3 8 4-16 3 8h4" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavCalibrationText" Text="Calibration" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavFeatures" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Features" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5 12h2m10 0h2M12 5v2m0 10v2M7.05 7.05l1.41 1.41m7.08 7.08l1.41 1.41M7.05 16.95l1.41-1.41M15.54 8.46l1.41-1.41" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavFeaturesText" Text="Features" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavActions" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Actions" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M13 3L5 14h7l-1 7 9-11h-7z" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavActionsText" Text="Actions" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavTracking" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Tracking" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7zm10-3a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavTrackingText" Text="Tracking" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsNavAppearance" Background="Transparent" CornerRadius="8" Cursor="Hand" Padding="10,8" Margin="0,0,0,2" Tag="Appearance" MouseLeftButtonUp="SettingsSubNav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="#94A3B8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12 3a9 9 0 1 0 0 18A9 9 0 0 0 12 3zm0 2a7 7 0 0 1 0 14V5z" /></Canvas></Viewbox>
                                    <TextBlock x:Name="SettingsNavAppearanceText" Text="Appearance" FontSize="13" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="SettingsContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PortaContentHeaderBrush}">
                        <StackPanel Margin="20,20,20,28">
                            <Slider x:Name="IntensitySlider" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="IntensitySlider_ValueChanged" Visibility="Collapsed" />
