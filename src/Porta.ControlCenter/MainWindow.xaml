                                        <TextBlock x:Name="AccountConsentStatusValue" Grid.Row="0" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Agreement version" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,8" />
                                        <TextBlock x:Name="AccountConsentVersionValue" Grid.Row="1" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="This device" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,8" />
                                        <TextBlock x:Name="AccountDeviceConsentStatusValue" Grid.Row="2" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Device version" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,8" />
                                        <TextBlock x:Name="AccountDeviceConsentVersionValue" Grid.Row="3" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture on this device" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,8" />
                                        <TextBlock x:Name="AccountCaptureAuthorizationValue" Grid.Row="4" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Workspace link" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,8" />
                                        <TextBlock x:Name="AccountLinkStatusValue" Grid.Row="5" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Linked since" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                        <TextBlock x:Name="AccountLinkedAtValue" Grid.Row="6" Grid.Column="1" Text="Not linked" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="AccountConsentActionHelpText" Text="Use this button if this PC still needs capture approval." Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
                                            <Button x:Name="AccountConsentActionButton" Content="Grant consent on this PC" Padding="12,6" Width="220" HorizontalAlignment="Left" Click="AccountConsentActionButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="AccountSignOutSectionPanel" Background="Transparent" BorderBrush="#7F1D1D" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                        <TextBlock Text="SIGN OUT" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,12" />
                                        <TextBlock x:Name="AccountSignOutNotSignedInText" Text="You are not currently signed in on this PC. There is nothing to sign out of." Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Visibility="Visible" />
                                        <StackPanel x:Name="AccountSignOutSignedInContent" Visibility="Collapsed">
                                            <Border Background="{DynamicResource PortaCardBrush}" BorderBrush="{DynamicResource PortaCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,10" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="#1F1A33" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="AccountSignOutAvatarInitial" Text="A" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="AccountSignOutNameLabel" Text="" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextPrimaryBrush}" />
                                                        <TextBlock x:Name="AccountSignOutEmailLabel" Text="" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Signing out removes the saved sign-in from this PC. It does not uninstall PORTA or remove this device from your account — manage devices separately in the Devices section." Foreground="{DynamicResource PortaTextBodyBrush}" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="12" />
                                            <Button x:Name="AccountSignOutButton" Content="Sign out on this PC" Padding="12,6" Width="170" HorizontalAlignment="Left" Foreground="#F87171" BorderBrush="#7F1D1D" Click="AccountSignOutButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

<ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- Top bar: Refresh right-aligned, chip and advanced button hidden but preserved -->
                        <DockPanel Margin="0,0,0,14">
                            <Button x:Name="SystemRefreshButton" DockPanel.Dock="Right" Content="Refresh"
                                    Padding="10,5" FontSize="12" Click="RefreshButton_Click" VerticalAlignment="Center" />
                            <Border x:Name="SystemHealthChipBorder" Visibility="Collapsed" DockPanel.Dock="Right"
                                    CornerRadius="100" Background="#14F59E0B" BorderBrush="#22F59E0B"
                                    BorderThickness="1" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SystemHealthChipText" Text="Stale"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" />
                            </Border>
                        </DockPanel>
                        <Button x:Name="SystemAdvancedButton" Visibility="Collapsed"
                                Content="Jump to Advanced" Padding="12,6"
                                Click="SystemAdvancedButton_Click" />

                        <!-- Row 1: Engine Health (left) | Session Truth (right) -->
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ENGINE HEALTH card -->
                            <Border Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" x:Name="HealthEngineBadge"
                                                Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="HealthEngineBadgeText" Text="Healthy"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="HealthEngineDot" Width="7" Height="7"
                                                    CornerRadius="3.5" Background="Transparent" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock Text="ENGINE HEALTH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Service" Foreground="{DynamicResource PortaTextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
