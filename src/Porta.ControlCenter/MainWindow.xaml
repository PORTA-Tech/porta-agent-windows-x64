                                    <TextBlock Grid.Row="1" Text="Average focus %" /><TextBlock x:Name="TodayAvgFocusValue" Grid.Row="1" HorizontalAlignment="Right" Text="0%" />
                                    <TextBlock Grid.Row="2" Text="Peak overload %" /><TextBlock x:Name="TodayPeakOverloadValue" Grid.Row="2" HorizontalAlignment="Right" Text="0%" />
                                    <TextBlock Grid.Row="3" Text="Idle fragmentation" /><TextBlock x:Name="TodayIdleFragmentationValue" Grid.Row="3" HorizontalAlignment="Right" Text="0.00" />
                                    <TextBlock Grid.Row="4" Text="Most volatile hour" /><TextBlock x:Name="TodayMostVolatileHourValue" Grid.Row="4" HorizontalAlignment="Right" Text="Not available" />
                                </Grid>
                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TodayHourlyChartPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="UpdatedValue" Margin="0,10,0,0" Foreground="#94A3B8" Text="Last refresh: Not available" />
                        <TextBlock x:Name="DebugFooterText" Margin="0,6,0,0" Foreground="#F59E0B" FontFamily="Consolas" FontSize="11" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="InputsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="What I Track" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Patterns only. Never content." Foreground="#CBD5E1" Margin="0,0,0,12" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Collected (patterns only)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="Keyboard timing" FontWeight="SemiBold" />
                                            <TextBlock Text="No keystroke content" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Mouse movement patterns" FontWeight="SemiBold" />
                                            <TextBlock Text="Motion/scroll behavior only" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="App switching" FontWeight="SemiBold" />
                                            <TextBlock Text="Identifiers are hashed" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Idle time" FontWeight="SemiBold" />
                                            <TextBlock Text="Activity gaps only" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Never collected" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="- Keystroke content" Margin="0,0,0,6" />
                                <TextBlock Text="- Screen content" Margin="0,0,0,6" />
                                <TextBlock Text="- Clipboard" Margin="0,0,0,6" />
                                <TextBlock Text="- Microphone / camera" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Live activity (last 60 seconds)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Keyboard activity" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="LiveKeyboardMeter" Height="10" Minimum="0" Maximum="100" Value="0" Margin="8,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LiveKeyboardValue" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mouse activity" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="LiveMouseMeter" Height="10" Minimum="0" Maximum="100" Value="0" Margin="8,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LiveMouseValue" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="App switches" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="LiveSwitchMeter" Height="10" Minimum="0" Maximum="100" Value="0" Margin="8,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LiveSwitchValue" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Idle seconds" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="LiveIdleMeter" Height="10" Minimum="0" Maximum="100" Value="0" Margin="8,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="LiveIdleValue" Text="0s" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="LiveQualityValue" Text="Quality score: Not available" Margin="0,4,0,0" />
                                <TextBlock x:Name="LivePartialValue" Text="Partial data: Not available" Margin="0,4,0,0" />
                                <TextBlock x:Name="LiveMissingChannelsValue" Text="Missing: Not available" Margin="0,4,0,0" Foreground="#94A3B8" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Your data" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock x:Name="RetentionWindowValue" Text="Retention window: Not available" />
                                <TextBlock x:Name="RetentionSizeValue" Text="Local data size: Not available" Margin="0,6,0,10" />
                                <WrapPanel>
                                    <Button Content="Export Data" Padding="12,6" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                                    <Button Content="Delete Local Data" Padding="12,6" Click="DeleteLocalDataButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InterventionsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="None">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Actions" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="What PORTA did, why it happened, and whether undo is available." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="#1E3A8A" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="SuggestionsCountText" Text="Suggestions: 0" Foreground="#DBEAFE" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#14532D" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="ChangesCountText" Text="Changes: 0" Foreground="#DCFCE7" FontWeight="SemiBold" />
                                </Border>
                            </WrapPanel>

                            <!-- Keep these hidden toggles for existing settings/undo wiring. -->
                            <StackPanel Visibility="Collapsed">
                                <CheckBox x:Name="InterventionNotificationToggle" Content="Allow notification reduction (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionFocusModeToggle" Content="Allow focus mode nudge (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionAnimationToggle" Content="Allow animation reduction (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionAppRestrictionToggle" Content="Allow temporary app restriction (auto)" Click="InterventionCategoryToggle_Click" />
                            </StackPanel>

                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="ActionsSuggestionsTabButton" Content="Suggestions" Padding="12,6" Margin="0,0,8,0" Click="ActionsSuggestionsTabButton_Click" />
                                <Button x:Name="ActionsChangesTabButton" Content="Changes" Padding="12,6" Click="ActionsChangesTabButton_Click" />
                            </WrapPanel>
                            <Border Style="{StaticResource QuietHoverCardStyle}" Padding="10" Height="540">
                                <Grid>
                                    <Grid x:Name="SuggestionsTabContent" Margin="4">
                                        <TextBlock x:Name="SuggestionsEmptyStateText"
                                                   Text="No suggestions yet."
                                                   Foreground="#CBD5E1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <ListView x:Name="SuggestionsListView"
                                                  SelectionChanged="SuggestionsListView_SelectionChanged"
                                                  Background="#0B1220"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#1F2937">
                                            <ListView.Resources>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#111827" />
                                                    <Setter Property="BorderBrush" Value="#1F2937" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#171B20" />
                                                            <Setter Property="BorderBrush" Value="#303743" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1B222B" />
                                                            <Setter Property="BorderBrush" Value="#3B4655" />
                                                            <Setter Property="Foreground" Value="#E6E9ED" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="{x:Type ScrollBar}">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Background" Value="#0F172A" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                <Grid Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
                                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                          Background="Transparent"
                                                                                          BorderThickness="0"
                                                                                          Opacity="0" />
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.Thumb>
                                                                            <Thumb x:Name="ScrollThumb"
                                                                                   Background="#526079"
                                                                                   BorderBrush="#64748B"
                                                                                   BorderThickness="1" />
                                                                        </Track.Thumb>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                          Background="Transparent"
                                                                                          BorderThickness="0"
                                                                                          Opacity="0" />
                                                                        </Track.IncreaseRepeatButton>
                                                                    </Track>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ScrollThumb" Property="Background" Value="#64748B" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Background}"
                                                            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                                <Border Grid.Column="1" Background="#151B23" BorderBrush="#2B3441" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                                                    <TextBlock Text="{Binding Time}" Foreground="#CBD5E1" FontSize="11" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Why}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Classification}" Foreground="#FDE68A" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                                                            <TextBlock Text="{Binding Decision}" Foreground="#93C5FD" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding Execution}" Foreground="#93C5FD" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                    <Grid x:Name="ChangesTabContent" Margin="4" Visibility="Collapsed">
                                        <TextBlock x:Name="ChangesEmptyStateText"
                                                   Text="No system changes are enabled in this version."
                                                   Foreground="#CBD5E1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <ListView x:Name="ChangesListView"
                                                  SelectionChanged="ChangesListView_SelectionChanged"
                                                  PreviewMouseWheel="ChangesListView_PreviewMouseWheel"
                                                  Background="#0B1220"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#1F2937"
                                                  ScrollViewer.CanContentScroll="False">
                                            <ListView.Resources>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#111827" />
                                                    <Setter Property="BorderBrush" Value="#1F2937" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#171B20" />
                                                            <Setter Property="BorderBrush" Value="#303743" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1B222B" />
                                                            <Setter Property="BorderBrush" Value="#3B4655" />
                                                            <Setter Property="Foreground" Value="#E6E9ED" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Background}"
                                                            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding WhatChanged}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding Undo}" Foreground="#D1FAE5" FontSize="11" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Why}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                            <TextBlock Text="{Binding Classification}" Foreground="#FDE68A" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding Decision}" Foreground="#93C5FD" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2" />
                                                            <TextBlock Text="{Binding Execution}" Foreground="#93C5FD" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                                                            <TextBlock Text="{Binding When}" Foreground="#94A3B8" FontSize="11" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}" Height="540" VerticalAlignment="Top">
                            <ScrollViewer x:Name="ActionDetailsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          IsManipulationEnabled="True"
                                          PanningMode="VerticalOnly">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="10" />
                                        <Setter Property="Background" Value="#0F172A" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Grid Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb x:Name="ScrollThumb"
                                                                       Background="#526079"
                                                                       BorderBrush="#64748B"
                                                                       BorderThickness="1" />
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ScrollThumb" Property="Background" Value="#64748B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ActionDrawerTitle" Text="Select an action event" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="ActionDrawerWhen" Text="When: Not available" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerClassification" Text="Type: Not available" Margin="0,0,0,6" Foreground="#FDE68A" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ActionDrawerDecisionState" Text="Decision: Not available" Margin="0,0,0,6" Foreground="#93C5FD" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ActionDrawerExecutionState" Text="Execution: Not available" Margin="0,0,0,6" Foreground="#93C5FD" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ActionDrawerCooldown" Text="Cooldown remaining: Not available" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerUndo" Text="Undo: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerShortWhy" Text="Why: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#E2E8F0" MaxHeight="58" />
                                            <TextBlock x:Name="ActionDrawerRepeat" Text="" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerWhatChanged" Text="What changed: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#E2E8F0" MaxHeight="58" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Technical details (why_json)" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Disabled" Height="190">
                                            <TextBlock x:Name="ActionDrawerWhyJson" Text="Not available" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                        </ScrollViewer>
                                    </Border>
                                    <Button x:Name="ActionDrawerUndoButton" Content="Undo change" Padding="12,6" Margin="0,10,0,0" Click="ActionDrawerUndoButton_Click" IsEnabled="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#E2E8F0" />
                        </Style>
                        <Style TargetType="{x:Type CheckBox}">
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="#E2E8F0" />
                            <Setter Property="BorderBrush" Value="#334155" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style TargetType="{x:Type DatePicker}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style x:Key="ReadableSettingsComboItemStyle" TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Padding" Value="6,4" />
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE" />
                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20">
                        <TextBlock Text="Controls" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Adjust behavior without overwhelming settings." Foreground="#CBD5E1" Margin="0,0,0,12" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="A) Main controls" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <TextBlock Text="Intensity" />
                                <Slider x:Name="IntensitySlider" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="IntensitySlider_ValueChanged" Margin="0,4,0,0" />
                                <TextBlock x:Name="IntensityValueText" Text="Balanced" Margin="0,6,0,10" />
                                <TextBlock Text="Privacy mode" />
                                <Border Style="{StaticResource RoundedInputChromeStyle}" Width="240" Margin="0,4,0,0">
                                    <ComboBox x:Name="PrivacyLevelComboBox"
                                              SelectionChanged="PrivacyLevelComboBox_SelectionChanged"
                                              ItemContainerStyle="{StaticResource ReadableSettingsComboItemStyle}"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <ComboBoxItem Content="Minimal" Foreground="#111827" Background="#F8FAFC" />
                                        <ComboBoxItem Content="Standard" Foreground="#111827" Background="#F8FAFC" />
                                        <ComboBoxItem Content="Detailed" Foreground="#111827" Background="#F8FAFC" />
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="B) Collection controls" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Pause now" Padding="12,6" Margin="0,0,10,0" Click="PauseButton_Click" />
                                    <Button Content="Revoke consent" Padding="12,6" Click="RevokeConsentFromSettingsButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="Pause until" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Width="160" Margin="0,0,8,0">
                                        <DatePicker x:Name="PauseUntilDatePicker" Background="Transparent" BorderThickness="0" />
                                    </Border>
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Width="110" Margin="0,0,8,0">
                                        <ComboBox x:Name="PauseUntilTimeComboBox"
                                                  ItemContainerStyle="{StaticResource ReadableSettingsComboItemStyle}"
                                                  Foreground="#111827"
                                                  Background="Transparent"
                                                  BorderThickness="0" />
                                    </Border>
                                    <Button Content="Pause until selected time" Padding="12,6" Click="PauseUntilSelectedButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="C) Calibration controls" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <Button Content="Recalibrate baseline" Padding="12,6" Width="180" HorizontalAlignment="Left" Click="RecalibrateBaselineButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="D) Safety toggles" FontSize="16" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,8">
                                    <CheckBox x:Name="SettingsSuggestionsOnlyToggle" Content="Suggestions only (no system changes)" Click="SettingsSuggestionsOnlyToggle_Click" Margin="0" />
                                </Border>
                                <TextBlock Text="Categories" Foreground="#94A3B8" Margin="0,0,0,6" />
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,6">
                                    <CheckBox x:Name="SettingsNotificationToggle" Content="Notification reduction" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,6">
                                    <CheckBox x:Name="SettingsFocusModeToggle" Content="Focus mode nudge" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,0,0,6">
                                    <CheckBox x:Name="SettingsAnimationToggle" Content="Animation reduction" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                    <CheckBox x:Name="SettingsAppRestrictionToggle" Content="Temporary app restriction" Click="SettingsCategoryToggle_Click" Margin="0" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Apply controls" Padding="12,6" Margin="0,0,10,0" Click="SaveSettingsButton_Click" />
                            <Button Content="Resume now" Padding="12,6" Click="ResumeFromSettingsButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SettingsStatusText" Text="Settings status: Not available" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="StatesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="How It Decides" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Engine flow in plain language." Foreground="#CBD5E1" Margin="0,0,0,12" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="1) Signals" FontSize="16" FontWeight="SemiBold" />
                                    <Border x:Name="SignalsStatusPill" Background="#334155" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                        <TextBlock x:Name="SignalsStatusText" Text="Blocked" Foreground="#E2E8F0" FontSize="11" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="What it means: PORTA reads activity patterns from keyboard, mouse, app switches, and idle time." TextWrapping="Wrap" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                <TextBlock x:Name="SignalsBlockersText" Text="What can block it: Not available" TextWrapping="Wrap" Foreground="#FCD34D" Margin="0,0,0,4" />
                                <TextBlock x:Name="SignalsCurrentText" Text="Current status: Not available" TextWrapping="Wrap" Foreground="#93C5FD" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="v" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,8" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="2) Calibration" FontSize="16" FontWeight="SemiBold" />
                                    <Border x:Name="CalibrationStatusPill" Background="#334155" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                        <TextBlock x:Name="CalibrationStatusText" Text="Blocked" Foreground="#E2E8F0" FontSize="11" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="What it means: PORTA learns your normal pattern and sets a stable baseline." TextWrapping="Wrap" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                <TextBlock x:Name="CalibrationBlockersText" Text="What can block it: Not available" TextWrapping="Wrap" Foreground="#FCD34D" Margin="0,0,0,4" />
                                <TextBlock x:Name="CalibrationCurrentText" Text="Current status: Not available" TextWrapping="Wrap" Foreground="#93C5FD" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="v" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,8" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="3) Smoothing" FontSize="16" FontWeight="SemiBold" />
                                    <Border x:Name="SmoothingStatusPill" Background="#334155" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                        <TextBlock x:Name="SmoothingStatusText" Text="Blocked" Foreground="#E2E8F0" FontSize="11" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="What it means: PORTA smooths raw input signals to prevent one-off spikes." TextWrapping="Wrap" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                <TextBlock x:Name="SmoothingBlockersText" Text="What can block it: Not available" TextWrapping="Wrap" Foreground="#FCD34D" Margin="0,0,0,4" />
                                <TextBlock x:Name="SmoothingCurrentText" Text="Current status: Not available" TextWrapping="Wrap" Foreground="#93C5FD" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="v" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,8" />

                        <Border Style="{StaticResource QuietHoverCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="4) Decisions" FontSize="16" FontWeight="SemiBold" />
                                    <Border x:Name="DecisionsStatusPill" Background="#334155" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                        <TextBlock x:Name="DecisionsStatusText" Text="Blocked" Foreground="#E2E8F0" FontSize="11" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="What it means: PORTA combines overload + focus streak + policy rules to decide whether to suggest an action." TextWrapping="Wrap" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                <TextBlock x:Name="DecisionsBlockersText" Text="What can block it: Not available" TextWrapping="Wrap" Foreground="#FCD34D" Margin="0,0,0,4" />
                                <TextBlock x:Name="DecisionsCurrentText" Text="Current status: Not available" TextWrapping="Wrap" Foreground="#93C5FD" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TimelinePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="HistoryRange1hButton" Content="Last 1h" Padding="10,4" Margin="0,0,8,0" Click="HistoryRange1hButton_Click" />
                                <Button x:Name="HistoryRange4hButton" Content="Last 4h" Padding="10,4" Margin="0,0,8,0" Click="HistoryRange4hButton_Click" />
                                <Button x:Name="HistoryRangeTodayButton" Content="Today" Padding="10,4" Margin="0,0,14,0" Click="HistoryRangeTodayButton_Click" />
                                <CheckBox x:Name="HistoryExplainModeCheckBox" Content="Explain mode" VerticalAlignment="Center" Foreground="#E5E7EB" Checked="HistoryExplainModeCheckBox_Changed" Unchecked="HistoryExplainModeCheckBox_Changed" />
                            </WrapPanel>

                            <TextBlock Text="Overload" FontWeight="SemiBold" />
                            <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineOverloadScrollViewer" Height="56" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineOverloadTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Trust level" FontWeight="SemiBold" />
                            <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineTrustScrollViewer" Height="56" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineTrustTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Focus streak" FontWeight="SemiBold" />
                            <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineFocusScrollViewer" Height="72" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineFocusTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Overload active windows" FontWeight="SemiBold" />
                            <Border Style="{StaticResource QuietHoverSubCardStyle}" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineOverloadActiveScrollViewer" Height="24" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineOverloadActiveOverlayPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Border>

                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource QuietHoverCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="TimelineDetailTimestamp" Text="Timestamp: Not available" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailOverload" Text="Overload: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailTrust" Text="Trust level: Not available" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailFocus" Text="Focus streak: Not available" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailClassification" Text="Type: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FDE68A" />
                                <TextBlock x:Name="TimelineDetailExecution" Text="Decision/Execution: Not available" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#93C5FD" />
                                <TextBlock x:Name="TimelineDetailWhyHeader" Text="Why: Not available" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#93C5FD" />
                                <TextBlock x:Name="TimelineDetailWhyFiv" Text="Clarity/Pressure/Jitter: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailWhyReasons" Text="Top reasons: Not available" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailWhyQuality" Text="Quality: Not available | Agreement: Not available" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailStabilization" Text="Stabilization: Not available" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFFFFF" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Account" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Open one section at a time so your account, workspace, device, and consent details stay easy to scan." Foreground="#CBD5E1" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Access" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                    <Button x:Name="AccountRefreshButton" Content="Refresh account" Padding="12,6" DockPanel.Dock="Right" Click="AccountRefreshButton_Click" />
                                </DockPanel>
                                <TextBlock x:Name="AccountStatusText" Text="Sign in to view your account, workspace, and devices." Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <StackPanel x:Name="AccountSignedOutPanel">
                                    <TextBlock Text="Sign in to view your workspace access and devices." FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,8" />
                                    <TextBlock Text="Email or user ID" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,4">
                                        <TextBox x:Name="AccountUserIdTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                    </Border>
                                    <TextBlock x:Name="AccountUserIdHelpText" Text="Use the email or user ID your workspace gave you." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <TextBlock Text="Password" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,4">
                                        <PasswordBox x:Name="AccountPasswordBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                    </Border>
                                    <TextBlock x:Name="AccountPasswordHelpText" Text="Use the password set for your workspace account." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <CheckBox x:Name="AccountRememberSignInCheckBox" Content="Remember on this PC" IsChecked="True" Foreground="#E6E9ED" VerticalAlignment="Center" />
                                        <Button x:Name="AccountForgetRememberedSignInButton"
                                                Content="Forget saved sign-in"
                                                Margin="12,0,0,0"
                                                Padding="10,4"
                                                MinHeight="30"
                                                Click="AccountForgetRememberedSignInButton_Click"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="AccountRememberedSignInHelpText" Text="Keep this checked if you want PORTA to remember this email and password on this Windows account only." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <Button x:Name="AccountSignInButton" Content="Sign in" Padding="12,6" Width="140" HorizontalAlignment="Left" Click="AccountSignInButton_Click" />

                                    <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Need an account?" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6" />
                                            <TextBlock x:Name="AccountCreateHelpText" Text="Use your existing account, or create one here if your workspace allows self-service sign-up." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                                            <StackPanel x:Name="AccountRegistrationPanel">
                                                <TextBlock Text="Display name" Margin="0,0,0,4" />
                                                <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                    <TextBox x:Name="AccountRegisterDisplayNameTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                </Border>
                                                <TextBlock x:Name="AccountCreateDisplayNameHelpText" Text="Use the name you want to see in your account and on linked devices." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBlock Text="Email or user ID" Margin="0,0,0,4" />
                                                <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                    <TextBox x:Name="AccountRegisterUserIdTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                </Border>
                                                <TextBlock x:Name="AccountCreateUserIdHelpText" Text="This becomes how you sign in later. Most people use their work email." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBlock Text="Password" Margin="0,0,0,4" />
                                                <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                    <PasswordBox x:Name="AccountRegisterPasswordBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                </Border>
                                                <TextBlock x:Name="AccountCreatePasswordHelpText" Text="Create the password you want to use when you sign in on this PC." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <StackPanel x:Name="AccountSignupCodePanel" Visibility="Collapsed">
                                                    <TextBlock Text="Sign-up code" Margin="0,0,0,4" />
                                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                                        <TextBox x:Name="AccountRegisterSignupCodeTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                                    </Border>
                                                    <TextBlock x:Name="AccountSignupCodeHelpText" Text="Only fill this if your admin gave you a sign-up code." Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button x:Name="AccountCreateAccountButton" Content="Create account" Padding="12,6" Width="150" HorizontalAlignment="Left" Click="AccountCreateAccountButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="AccountSignedInPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource QuietHoverSubCardCompactStyle}">
                                        <TextBlock x:Name="AccountSignedInSummaryText" Text="Use the menu below to open your profile, workspace, subscription, devices, or privacy." TextWrapping="Wrap" Foreground="#CBD5E1" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AccountSummarySectionPanel" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Signed in as" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountSignedInAsValue" Grid.Row="0" Grid.Column="1" Text="Not signed in" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountEmailValue" Grid.Row="1" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Signed in until" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountSessionExpiryValue" Grid.Row="2" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />
                                </Grid>
                                <Border Style="{StaticResource QuietHoverSubCardCompactStyle}" Margin="0,12,0,0">
                                    <TextBlock Text="This section shows who is signed in on this PC. Open Workspace or Devices to change how this machine uses your account." TextWrapping="Wrap" Foreground="#CBD5E1" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,0,12">
                            <WrapPanel>
                                <Button x:Name="AccountSummaryMenuButton" Content="Signed in as" Margin="0,0,8,8" Tag="summary" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountManageMenuButton" Content="Manage account" Margin="0,0,8,8" Tag="manage" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountWorkspaceMenuButton" Content="Workspace" Margin="0,0,8,8" Tag="workspace" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountSubscriptionMenuButton" Content="Subscription" Margin="0,0,8,8" Tag="subscription" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountDevicesMenuButton" Content="Devices" Margin="0,0,8,8" Tag="devices" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountPrivacyMenuButton" Content="Privacy &amp; consent" Margin="0,0,8,8" Tag="privacy" Click="AccountSectionMenuButton_Click" />
                                <Button x:Name="AccountSignOutMenuButton" Content="Sign out" Margin="0,0,0,8" Tag="signout" Click="AccountSectionMenuButton_Click" />
                            </WrapPanel>
                        </Border>

                        <Grid x:Name="AccountPrimarySectionsGrid" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccountManageSectionPanel" Grid.Column="0" Style="{StaticResource QuietHoverCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Manage account" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="Display name" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource RoundedInputChromeStyle}" Margin="0,0,0,8">
                                        <TextBox x:Name="AccountDisplayNameTextBox" Background="Transparent" BorderThickness="0" Padding="8,6" Foreground="#111827" />
                                    </Border>
                                    <TextBlock Text="Email" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="AccountReadOnlyEmailValue" Text="Not available" Margin="0,4,0,10" TextWrapping="Wrap" />
                                    <Button x:Name="AccountSaveProfileButton" Content="Save display name" Padding="12,6" HorizontalAlignment="Left" Click="AccountSaveProfileButton_Click" />
                                    <TextBlock x:Name="AccountProfileStatusText" Text="Sign in to change your display name." Margin="0,8,0,0" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

