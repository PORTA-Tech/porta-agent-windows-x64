                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource PortaCardBrush}" BorderBrush="{DynamicResource PortaCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextPrimaryBrush}" DockPanel.Dock="Left" FontSize="13" />
                                                                        <Border Background="{DynamicResource PortaBubbleBrush}" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right"><TextBlock Text="{Binding BadgeLabel}" Foreground="{DynamicResource PortaTextSecondaryBrush}" FontSize="11" /></Border>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding DetailLabel}" Foreground="{DynamicResource PortaTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12" />
                                                                    <TextBlock Text="{Binding StatusLabel, StringFormat=Status: {0}}" Foreground="{DynamicResource PortaTextPrimaryBrush}" Margin="0,0,0,2" FontSize="12" />
                                                                    <TextBlock Text="{Binding LastSeenLabel, StringFormat=Last seen: {0}}" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,8" FontSize="12" />
                                                                    <WrapPanel>
                                                                        <Button Content="Unlink" Padding="12,6" Margin="0,0,8,0" Tag="{Binding DeviceId}" IsEnabled="{Binding CanUnlink}" Click="AccountDeviceUnlinkButton_Click" />
                                                                        <Button Content="Revoke" Padding="12,6" Tag="{Binding DeviceId}" IsEnabled="{Binding CanRevoke}" Click="AccountDeviceRevokeButton_Click" />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="AccountPrivacySectionPanel" Background="Transparent" BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,0,0,16" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="PRIVACY &amp; CONSENT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
