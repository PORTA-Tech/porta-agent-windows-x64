
<Window x:Class="Porta.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PORTA Control Center"
        Height="750"
        Width="1100"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#E2E8F0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="PORTA" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />
                <Button x:Name="OverviewNavButton" Content="Now" Margin="0,0,0,8" Padding="10,8" Click="OverviewNavButton_Click" />
                <Button x:Name="TimelineNavButton" Content="History" Margin="0,0,0,8" Padding="10,8" Click="TimelineNavButton_Click" />
                <Button x:Name="InterventionsNavButton" Content="Actions" Margin="0,0,0,8" Padding="10,8" Click="InterventionsNavButton_Click" />
                <Button x:Name="InputsNavButton" Content="What I Track" Margin="0,0,0,8" Padding="10,8" Click="InputsNavButton_Click" />
                <Button x:Name="StatesNavButton" Content="How It Decides" Margin="0,0,0,8" Padding="10,8" Click="StatesNavButton_Click" />
                <Button x:Name="SettingsNavButton" Content="Controls" Margin="0,0,0,8" Padding="10,8" Click="SettingsNavButton_Click" />
                <Button x:Name="DiagnosticsNavButton" Content="Health" Margin="0,0,0,0" Padding="10,8" Click="DiagnosticsNavButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B1220" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False" Margin="16,10">
                    <TextBlock x:Name="SectionTitleText" Text="Now" DockPanel.Dock="Left" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Border x:Name="StatusPillBorder" CornerRadius="12" Background="#1D4ED8" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="StatusPillText" Text="Running" FontWeight="Bold" />
                    </Border>
                    <Border x:Name="ConsentBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="ConsentBadgeText" Text="Consent: Needed" />
                    </Border>
                    <Border x:Name="CalibrationBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="CalibrationBadgeText" Text="Calibration: Calibrating" />
                    </Border>
                    <Border x:Name="TrustBadgeBorder" CornerRadius="12" Background="#334155" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TrustBadgeText" Text="Trust: Low" />
                    </Border>
                    <TextBlock x:Name="TopBarHintText" Text="" VerticalAlignment="Center" Foreground="#FB923C" Margin="0,0,16,0" Visibility="Collapsed" />
                    <Button x:Name="QuickPauseResumeButton" Content="Pause" Padding="12,6" Margin="0,0,10,0" Click="QuickPauseResumeButton_Click" />
                    <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6" Margin="0,0,10,0" Click="RefreshButton_Click" />
                    <Menu Background="Transparent" Foreground="#E2E8F0" VerticalAlignment="Center">
                        <MenuItem Header="Versions">
                            <MenuItem x:Name="AgentVersionMenuItem" Header="Agent: n/a" IsEnabled="False" />
                            <MenuItem x:Name="UiVersionMenuItem" Header="UI: n/a" IsEnabled="False" />
                            <MenuItem x:Name="SchemaVersionMenuItem" Header="Schema: n/a" IsEnabled="False" />
                        </MenuItem>
                    </Menu>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#111827" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Overload" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowOverloadValueText" Text="Overload: n/a" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="NowOverloadActiveText" Text="Active: n/a" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowOverloadTrustText" Text="Trust level: n/a" Margin="0,4,0,8" />
                                    <Expander Header="Why?" Margin="0,4,0,0" Foreground="#E2E8F0">
                                        <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Signals behind overload" FontSize="12" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBlock x:Name="NowOverloadFivText" Text="Explain not available (backend field missing)." TextWrapping="Wrap" Foreground="#E2E8F0" />
                                                <TextBlock x:Name="NowOverloadTopReasonsText" Text="Top reasons: n/a" TextWrapping="Wrap" Foreground="#CBD5E1" Margin="0,8,0,0" />
                                                <TextBlock x:Name="NowOverloadQualityAgreementText" Text="Quality: n/a | Agreement: n/a" Foreground="#CBD5E1" Margin="0,8,0,0" />
                                                <TextBlock Text="Turns ON after 2 min above 80%" Margin="0,8,0,0" Foreground="#93C5FD" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#111827" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Focus streak" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowFocusStreakValueText" Text="Focused time: n/a" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="NowFocusChoppinessText" Text="Choppiness: n/a" Margin="0,8,0,0" />
                                    <TextBlock x:Name="NowFocusFootnoteText" Text="Resets after 2+ minutes away." Margin="0,8,0,0" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowFocusStatusText" Text="" Margin="0,6,0,0" Foreground="#F59E0B" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#111827" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Calibration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowCalibrationStatusText" Text="Calibrating..." FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="NowCalibrationProgressText" Text="Progress: n/a" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowCalibrationQualityText" Text="Recent data quality: n/a (last 2 min)" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCalibrationColdStartText" Text="Cold start: n/a" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NowCalibrationTrustCapText" Text="Trust is capped until calibration completes." Foreground="#FB923C" Margin="0,8,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#111827" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Data quality" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowDataQualityScoreText" Text="Quality score: n/a" FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="NowDataQualityPartialText" Text="Partial data: n/a" Margin="0,6,0,0" />
                                    <TextBlock x:Name="NowDataQualityMissingText" Text="" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#111827" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Last action" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowLastActionTitleText" Text="No actions recently" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NowLastActionTimeText" Text="Time: n/a" Margin="0,6,0,8" />
                                    <Button x:Name="NowOpenActionsButton" Content="Open Actions" Padding="10,6" Width="130" Click="NowOpenActionsButton_Click" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#111827" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="What PORTA is doing" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="NowWhatPortaDoingText" Text="n/a" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,0,0,12" Visibility="Collapsed">
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="FocusCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Focus" /><TextBlock x:Name="FocusCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="FocusCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="FocusCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="OverloadCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Overload" /><TextBlock x:Name="OverloadCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="OverloadCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="OverloadCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="FatigueCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Fatigue" /><TextBlock x:Name="FatigueCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="FatigueCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="FatigueCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,0,8,8" BorderBrush="#1F2937" BorderThickness="1" Width="200">
                                <StackPanel><Border x:Name="StabilityCardBand" Height="4" Background="#475569" Margin="0,0,0,6" /><TextBlock Text="Stability" /><TextBlock x:Name="StabilityCardValue" FontSize="24" Text="0.00" /><TextBlock x:Name="StabilityCardConfidence" Text="Confidence: 0%" /><TextBlock x:Name="StabilityCardTrend" Text="Trend: Stable" /></StackPanel>
                            </Border>
                        </WrapPanel>
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel x:Name="RecentActionsPanel"><TextBlock Text="No recent actions yet." /></StackPanel>
                        </Border>
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Total interventions" /><TextBlock x:Name="TodayInterventionsValue" Grid.Row="0" HorizontalAlignment="Right" Text="0" />
                                    <TextBlock Grid.Row="1" Text="Average focus %" /><TextBlock x:Name="TodayAvgFocusValue" Grid.Row="1" HorizontalAlignment="Right" Text="0%" />
                                    <TextBlock Grid.Row="2" Text="Peak overload %" /><TextBlock x:Name="TodayPeakOverloadValue" Grid.Row="2" HorizontalAlignment="Right" Text="0%" />
                                    <TextBlock Grid.Row="3" Text="Idle fragmentation" /><TextBlock x:Name="TodayIdleFragmentationValue" Grid.Row="3" HorizontalAlignment="Right" Text="0.00" />
                                    <TextBlock Grid.Row="4" Text="Most volatile hour" /><TextBlock x:Name="TodayMostVolatileHourValue" Grid.Row="4" HorizontalAlignment="Right" Text="n/a" />
                                </Grid>
                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TodayHourlyChartPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="UpdatedValue" Margin="0,10,0,0" Foreground="#94A3B8" Text="Last refresh: n/a" />
                        <TextBlock x:Name="DebugFooterText" Margin="0,6,0,0" Foreground="#F59E0B" FontFamily="Consolas" FontSize="11" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="InputsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Inputs" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Keystroke timing intervals" /><TextBlock x:Name="InputTypingValue" Grid.Row="0" Grid.Column="1" Text="0.00" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mouse acceleration index" /><TextBlock x:Name="InputMouseValue" Grid.Row="1" Grid.Column="1" Text="0.00" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scroll velocity index" /><TextBlock x:Name="InputScrollValue" Grid.Row="2" Grid.Column="1" Text="0.00" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Focus switch frequency" /><TextBlock x:Name="InputFocusSwitchValue" Grid.Row="3" Grid.Column="1" Text="0.00" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Idle fragmentation" /><TextBlock x:Name="InputIdleFragmentationValue" Grid.Row="4" Grid.Column="1" Text="0.00" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Notification reaction latency" /><TextBlock x:Name="InputNotificationLatencyValue" Grid.Row="5" Grid.Column="1" Text="0.00" />
                            </Grid>
                        </Border>
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="RetentionWindowValue" Text="Retention window: Unknown" />
                                <TextBlock x:Name="RetentionSizeValue" Text="Local data size: Unknown" Margin="0,6,0,10" />
                                <WrapPanel>
                                    <Button Content="Export Data" Padding="12,6" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                                    <Button Content="Delete Local Data" Padding="12,6" Click="DeleteLocalDataButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InterventionsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="None">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Actions" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="What PORTA did, why it happened, and whether undo is available." Foreground="#CBD5E1" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="#1E3A8A" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="SuggestionsCountText" Text="Suggestions: 0" Foreground="#DBEAFE" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#14532D" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="ChangesCountText" Text="Changes: 0" Foreground="#DCFCE7" FontWeight="SemiBold" />
                                </Border>
                            </WrapPanel>

                            <!-- Keep these hidden toggles for existing settings/undo wiring. -->
                            <StackPanel Visibility="Collapsed">
                                <CheckBox x:Name="InterventionNotificationToggle" Content="Allow notification reduction (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionFocusModeToggle" Content="Allow focus mode nudge (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionAnimationToggle" Content="Allow animation reduction (auto)" Click="InterventionCategoryToggle_Click" />
                                <CheckBox x:Name="InterventionAppRestrictionToggle" Content="Allow temporary app restriction (auto)" Click="InterventionCategoryToggle_Click" />
                            </StackPanel>

                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="ActionsSuggestionsTabButton" Content="Suggestions" Padding="12,6" Margin="0,0,8,0" Click="ActionsSuggestionsTabButton_Click" />
                                <Button x:Name="ActionsChangesTabButton" Content="Changes" Padding="12,6" Click="ActionsChangesTabButton_Click" />
                            </WrapPanel>
                            <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="10" Height="540">
                                <Grid>
                                    <Grid x:Name="SuggestionsTabContent" Margin="4">
                                        <TextBlock x:Name="SuggestionsEmptyStateText"
                                                   Text="No suggestions yet."
                                                   Foreground="#CBD5E1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <ListView x:Name="SuggestionsListView"
                                                  SelectionChanged="SuggestionsListView_SelectionChanged"
                                                  Background="#0B1220"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#1F2937">
                                            <ListView.Resources>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#111827" />
                                                    <Setter Property="BorderBrush" Value="#1F2937" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E293B" />
                                                            <Setter Property="BorderBrush" Value="#334155" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1D4ED8" />
                                                            <Setter Property="BorderBrush" Value="#60A5FA" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="{x:Type ScrollBar}">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Background" Value="#0F172A" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                <Grid Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
                                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                          Background="Transparent"
                                                                                          BorderThickness="0"
                                                                                          Opacity="0" />
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.Thumb>
                                                                            <Thumb x:Name="ScrollThumb"
                                                                                   Background="#526079"
                                                                                   BorderBrush="#64748B"
                                                                                   BorderThickness="1" />
                                                                        </Track.Thumb>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                          Background="Transparent"
                                                                                          BorderThickness="0"
                                                                                          Opacity="0" />
                                                                        </Track.IncreaseRepeatButton>
                                                                    </Track>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ScrollThumb" Property="Background" Value="#64748B" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Background}"
                                                            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="8,2">
                                                                    <TextBlock Text="{Binding Time}" Foreground="#CBD5E1" FontSize="11" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Why}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                    <Grid x:Name="ChangesTabContent" Margin="4" Visibility="Collapsed">
                                        <TextBlock x:Name="ChangesEmptyStateText"
                                                   Text="No system changes are enabled in this version."
                                                   Foreground="#CBD5E1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <ListView x:Name="ChangesListView"
                                                  SelectionChanged="ChangesListView_SelectionChanged"
                                                  PreviewMouseWheel="ChangesListView_PreviewMouseWheel"
                                                  Background="#0B1220"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#1F2937"
                                                  ScrollViewer.CanContentScroll="False">
                                            <ListView.Resources>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#111827" />
                                                    <Setter Property="BorderBrush" Value="#1F2937" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E293B" />
                                                            <Setter Property="BorderBrush" Value="#334155" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1D4ED8" />
                                                            <Setter Property="BorderBrush" Value="#60A5FA" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Background}"
                                                            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding WhatChanged}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding Undo}" Foreground="#D1FAE5" FontSize="11" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Why}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                            <TextBlock Text="{Binding When}" Foreground="#94A3B8" FontSize="11" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0B1220" CornerRadius="10" Padding="12" BorderBrush="#1F2937" BorderThickness="1" Height="540" VerticalAlignment="Top">
                            <ScrollViewer x:Name="ActionDetailsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          IsManipulationEnabled="True"
                                          PanningMode="VerticalOnly">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="10" />
                                        <Setter Property="Background" Value="#0F172A" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Grid Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb x:Name="ScrollThumb"
                                                                       Background="#526079"
                                                                       BorderBrush="#64748B"
                                                                       BorderThickness="1" />
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ScrollThumb" Property="Background" Value="#64748B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ActionDrawerTitle" Text="Select an action event" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="ActionDrawerWhen" Text="When: n/a" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerCooldown" Text="Cooldown remaining: n/a" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerUndo" Text="Undo: n/a" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="ActionDrawerShortWhy" Text="Why: n/a" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#E2E8F0" MaxHeight="58" />
                                            <TextBlock x:Name="ActionDrawerRepeat" Text="" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                                            <TextBlock x:Name="ActionDrawerWhatChanged" Text="What changed: n/a" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#E2E8F0" MaxHeight="58" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Technical details (why_json)" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,4" />
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Disabled" Height="190">
                                            <TextBlock x:Name="ActionDrawerWhyJson" Text="n/a" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                        </ScrollViewer>
                                    </Border>
                                    <Button x:Name="ActionDrawerUndoButton" Content="Undo change" Padding="12,6" Margin="0,10,0,0" Click="ActionDrawerUndoButton_Click" IsEnabled="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Regulation intensity" />
                        <Slider x:Name="IntensitySlider" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="IntensitySlider_ValueChanged" Margin="0,4,0,0" />
                        <TextBlock x:Name="IntensityValueText" Text="Balanced" Margin="0,6,0,12" />
                        <TextBlock Text="Privacy level" />
                        <ComboBox x:Name="PrivacyLevelComboBox" Width="220" SelectionChanged="PrivacyLevelComboBox_SelectionChanged" Margin="0,4,0,12">
                            <ComboBoxItem Content="Minimal" />
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Detailed" />
                        </ComboBox>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Pause until tomorrow" Padding="12,6" Margin="0,0,10,0" Click="PauseUntilTomorrowButton_Click" />
                            <Button Content="Resume now" Padding="12,6" Click="ResumeFromSettingsButton_Click" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <DatePicker x:Name="PauseUntilDatePicker" Width="170" Margin="0,0,10,0" />
                            <Button Content="Pause until selected 08:00" Padding="12,6" Click="PauseUntilSelectedButton_Click" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Save Settings" Padding="12,6" Margin="0,0,10,0" Click="SaveSettingsButton_Click" />
                            <Button Content="Revoke Consent" Padding="12,6" Margin="0,0,10,0" Click="RevokeConsentFromSettingsButton_Click" />
                            <Button Content="Recalibrate Baseline" Padding="12,6" Click="RecalibrateBaselineButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SettingsStatusText" Text="Settings status: n/a" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="StatesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="States" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Focus - Definition: sustained goal-oriented behavior." FontWeight="SemiBold" />
                        <TextBlock x:Name="FocusStateConfidence" Text="Confidence: n/a" />
                        <TextBlock x:Name="FocusStateContributors" Text="Contributors: n/a" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Overload - Definition: demand exceeds capacity." FontWeight="SemiBold" />
                        <TextBlock x:Name="OverloadStateConfidence" Text="Confidence: n/a" />
                        <TextBlock x:Name="OverloadStateContributors" Text="Contributors: n/a" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Fatigue - Definition: fatigue-related decline probability." FontWeight="SemiBold" />
                        <TextBlock x:Name="FatigueStateConfidence" Text="Confidence: n/a" />
                        <TextBlock x:Name="FatigueStateContributors" Text="Contributors: n/a" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Stability - Definition: transition smoothness probability." FontWeight="SemiBold" />
                        <TextBlock x:Name="StabilityStateConfidence" Text="Confidence: n/a" />
                        <TextBlock x:Name="StabilityStateContributors" Text="Contributors: n/a" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TimelinePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="HistoryRange1hButton" Content="Last 1h" Padding="10,4" Margin="0,0,8,0" Click="HistoryRange1hButton_Click" />
                                <Button x:Name="HistoryRange4hButton" Content="Last 4h" Padding="10,4" Margin="0,0,8,0" Click="HistoryRange4hButton_Click" />
                                <Button x:Name="HistoryRangeTodayButton" Content="Today" Padding="10,4" Margin="0,0,14,0" Click="HistoryRangeTodayButton_Click" />
                                <CheckBox x:Name="HistoryExplainModeCheckBox" Content="Explain mode" VerticalAlignment="Center" Foreground="#E5E7EB" Checked="HistoryExplainModeCheckBox_Changed" Unchecked="HistoryExplainModeCheckBox_Changed" />
                            </WrapPanel>

                            <TextBlock Text="Overload" FontWeight="SemiBold" />
                            <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineOverloadScrollViewer" Height="56" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineOverloadTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Trust level" FontWeight="SemiBold" />
                            <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineTrustScrollViewer" Height="56" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineTrustTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Focus streak" FontWeight="SemiBold" />
                            <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineFocusScrollViewer" Height="72" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineFocusTrackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Overload active windows" FontWeight="SemiBold" />
                            <Border Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer x:Name="TimelineOverloadActiveScrollViewer" Height="24" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelineOverloadActiveOverlayPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Border>

                        </StackPanel>
                        <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TimelineDetailTimestamp" Text="Timestamp: n/a" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailOverload" Text="Overload: n/a" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailTrust" Text="Trust level: n/a" Margin="0,0,0,6" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailFocus" Text="Focus streak: n/a" Margin="0,0,0,10" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TimelineDetailWhyHeader" Text="Why: n/a" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#93C5FD" />
                                <TextBlock x:Name="TimelineDetailWhyFiv" Text="Clarity/Pressure/Jitter: n/a" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailWhyReasons" Text="Top reasons: n/a" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailWhyQuality" Text="Quality: n/a | Agreement: n/a" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TimelineDetailStabilization" Text="Stabilization: n/a" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFFFFF" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Diagnostics Truth Panel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border Background="#111827" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Service running" /><TextBlock x:Name="ServiceRunningValue" Grid.Row="0" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tray running" /><TextBlock x:Name="TrayRunningValue" Grid.Row="1" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Consent active" /><TextBlock x:Name="ConsentActiveValue" Grid.Row="2" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Backend connected" /><TextBlock x:Name="BackendConnectedValue" Grid.Row="3" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Focus strength" /><TextBlock x:Name="FocusStrengthValue" Grid.Row="4" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Overload likelihood" /><TextBlock x:Name="OverloadValue" Grid.Row="5" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Last action" /><TextBlock x:Name="LastActionValue" Grid.Row="6" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Last event timestamp" /><TextBlock x:Name="LastEventValue" Grid.Row="7" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Current policy version" /><TextBlock x:Name="PolicyVersionValue" Grid.Row="8" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Schema version" /><TextBlock x:Name="SchemaVersionValue" Grid.Row="9" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Agent version" /><TextBlock x:Name="AgentVersionValue" Grid.Row="10" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Local API reachable" /><TextBlock x:Name="ApiReachableValue" Grid.Row="11" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Local API port" /><TextBlock x:Name="ApiPortValue" Grid.Row="12" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="Consent version" /><TextBlock x:Name="ConsentVersionValue" Grid.Row="13" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="Consent timestamp" /><TextBlock x:Name="ConsentTimestampValue" Grid.Row="14" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="Disclosure hash" /><TextBlock x:Name="ConsentHashValue" Grid.Row="15" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="Last error" /><TextBlock x:Name="LastErrorValue" Grid.Row="16" Grid.Column="1" Text="None" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="Snapshot confidence" /><TextBlock x:Name="SnapshotConfidenceValue" Grid.Row="17" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="Overload active" /><TextBlock x:Name="OverloadActiveValue" Grid.Row="18" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="Sustained attention (s)" /><TextBlock x:Name="SustainedAttentionValue" Grid.Row="19" Grid.Column="1" Text="Unknown" />
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="Idle fragmentation index" /><TextBlock x:Name="IdleFragmentationValue" Grid.Row="20" Grid.Column="1" Text="Unknown" />
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Restart Service" Padding="12,6" Margin="0,0,10,0" Click="RestartServiceButton_Click" />
                            <Button Content="Export Bundle" Padding="12,6" Margin="0,0,10,0" Click="ExportBundleButton_Click" />
                            <Button Content="Open Logs Folder" Padding="12,6" Margin="0,0,10,0" Click="OpenLogsFolderButton_Click" />
                            <Button Content="Copy Diagnostics Summary" Padding="12,6" Click="CopyDiagnosticsSummaryButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border x:Name="ConsentOverlay" Grid.ColumnSpan="2" Background="#CC020617" Visibility="Collapsed">
            <Grid>
                <Border Width="820" Padding="24" CornerRadius="12" Background="#111827" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PORTA Needs Consent" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Collection, inference, and regulation are OFF until you click I Agree." Foreground="#FCA5A5" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Collected (aggregated only)" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="- Keystroke timing intervals (events/min)" />
                                    <TextBlock Text="- Mouse acceleration index" />
                                    <TextBlock Text="- Scroll velocity index" />
                                    <TextBlock Text="- Focus switch frequency" />
                                    <TextBlock Text="- Idle fragmentation" />
                                    <TextBlock Text="- Notification reaction latency" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Never Collected" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="- Typed text" />
                                    <TextBlock Text="- Clipboard content" />
                                    <TextBlock Text="- Screenshots" />
                                    <TextBlock Text="- Files and file contents" />
                                    <TextBlock Text="- Messages" />
                                    <TextBlock Text="- Network content" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Retention window: 90 days local SQLite (configurable in later settings)." Margin="0,0,0,14" />
                        <WrapPanel>
                            <Button Content="I Agree" Padding="14,8" Margin="0,0,10,0" Click="AgreeConsentButton_Click" />
                            <Button Content="Pause" Padding="12,8" Margin="0,0,10,0" Click="PauseButton_Click" />
                            <Button Content="Revoke" Padding="12,8" Margin="0,0,10,0" Click="RevokeConsentButton_Click" />
                            <Button Content="Export Data" Padding="12,8" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                            <Button Content="Delete Local Data" Padding="12,8" Click="DeleteLocalDataButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
