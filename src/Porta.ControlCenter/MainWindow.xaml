                                    <TextBlock x:Name="HealthStateModesValue" Grid.Row="4" Grid.Column="1" Text="Not available" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Explicit warning" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="HealthStateWarningValue" Grid.Row="5" Grid.Column="1" Text="State truth unavailable." TextWrapping="Wrap" />
                                </Grid>
