                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Operating system" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" />
                                            <TextBlock x:Name="AccountCurrentDeviceOsValue" Grid.Row="1" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PORTA version" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" />
                                            <TextBlock x:Name="AccountCurrentDeviceVersionValue" Grid.Row="2" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Device ID" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" />
                                            <TextBlock x:Name="AccountCurrentDeviceIdValue" Grid.Row="3" Grid.Column="1" Text="Not available" FontSize="12" Foreground="{DynamicResource PortaTextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
