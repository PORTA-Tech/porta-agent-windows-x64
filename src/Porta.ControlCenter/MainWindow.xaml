                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <TextBlock x:Name="OnboardingCurrentSystemText"
                                                   Text="System check: waiting for the service, desktop session, and current tracking status."
                                                   Foreground="#CBD5E1"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />
                                        <TextBlock x:Name="OnboardingCurrentGuidanceText"
                                                   Text="If tracking quality looks limited, Ari keeps trying to recover in the background. Open Tracking to review quality, or System if recovery stays stuck."
                                                   Foreground="#FCA5A5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#1B1F25"
                                    BorderBrush="#262B33"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="If tracking quality looks limited"
                                               Foreground="#FCA5A5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <TextBlock Text="- Keep using the keyboard or mouse for a few seconds while Ari retries."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="- Open Tracking to review consent, privacy, and what improves tracking quality."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="- If Today still stays at zero, open System and check the Service, Desktop session, and Last error cards."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="- If the desktop session does not recover, sign out and back in to Windows."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <WrapPanel>
                                <Button Content="Open System"
                                        Padding="14,8"
                                        Margin="0,0,10,0"
                                        Click="OnboardingOpenSystemButton_Click" />
                                <Button Content="Got it"
                                        Padding="14,8"
                                        Click="OnboardingDismissButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="UpdateOverlay"
              Grid.Row="1"
              Grid.Column="1"
              Background="Transparent"
              Visibility="Collapsed"
              Panel.ZIndex="180"
              IsHitTestVisible="False">
            <Border Width="420"
                    MaxWidth="420"
                    MaxHeight="340"
                    Padding="18"
                    CornerRadius="12"
                    Background="#F4111825"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,74,16,0"
                    IsHitTestVisible="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="UpdateOverlayTitleText" Text="Ari update ready" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateOverlayVersionText" Text="Current version Not available" Foreground="#93C5FD" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateOverlaySummaryText" Text="A newer Windows build is available for this machine." Foreground="#E5E7EB" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateOverlayStatusText" Text="App updates are checked automatically when a release is published." Foreground="#94A3B8" Margin="0,0,0,14" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="UpdateOverlayInstallButton"
                                    Content="Download and install"
                                    Padding="14,8"
                                    Margin="0,0,8,8"
                                    Click="AccountInstallUpdateButton_Click" />
                            <Button x:Name="UpdateOverlayLaterButton"
                                    Content="Later"
                                    Padding="12,8"
                                    Margin="0,0,0,8"
                                    Click="AccountDismissUpdateButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="ConsentOverlay"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#CC020617"
                Visibility="Collapsed">
            <Grid>
                <Border Width="820" Padding="24" CornerRadius="12" Background="#111827" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PORTA Needs Consent" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Collection, inference, and regulation are OFF until you click I Agree." Foreground="#FCA5A5" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Collected (aggregated only)" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="- Keystroke timing intervals (events/min)" />
                                    <TextBlock Text="- Mouse acceleration index" />
                                    <TextBlock Text="- Scroll velocity index" />
                                    <TextBlock Text="- Focus switch frequency" />
                                    <TextBlock Text="- Idle fragmentation" />
                                    <TextBlock Text="- Notification reaction latency" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Never Collected" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="- Typed text" />
                                    <TextBlock Text="- Clipboard content" />
                                    <TextBlock Text="- Screenshots" />
                                    <TextBlock Text="- Files and file contents" />
                                    <TextBlock Text="- Messages" />
                                    <TextBlock Text="- Network content" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Retention window: 90 days local SQLite (configurable in later settings)." Margin="0,0,0,14" />
                        <WrapPanel>
                            <Button Content="I Agree" Padding="14,8" Margin="0,0,10,0" Click="AgreeConsentButton_Click" />
                            <Button Content="Pause" Padding="12,8" Margin="0,0,10,0" Click="PauseButton_Click" />
                            <Button Content="Revoke" Padding="12,8" Margin="0,0,10,0" Click="RevokeConsentButton_Click" />
                            <Button Content="Export Data" Padding="12,8" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                            <Button Content="Delete Local Data" Padding="12,8" Click="DeleteLocalDataButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>


