                                            Margin="10,0,0,0"
                                            Background="#C1121F"
                                            BorderBrush="#F87171"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBox Style="{StaticResource SelectableText}" x:Name="GlobalUpdateButtonBadgeText"
                                                   Text="1"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                                                    </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
