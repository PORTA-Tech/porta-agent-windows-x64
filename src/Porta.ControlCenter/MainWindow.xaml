                                            <Viewbox Width="36" Height="36" Margin="0,0,0,14" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="Transparent" Stroke="#1E293B" StrokeThickness="1.2" Data="M20 12V22H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Subscription management coming soon" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PortaTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="260" Text="Plan details, billing, and usage limits will appear here. For now, your access is managed directly by your workspace admin." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AccountDevicesSectionPanel" Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource PortaDividerBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,0,0,16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="THIS DEVICE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PortaTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#0F3025" BorderBrush="#1A6040" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="● Running" FontSize="11" FontWeight="SemiBold" Foreground="#16C784" />
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
