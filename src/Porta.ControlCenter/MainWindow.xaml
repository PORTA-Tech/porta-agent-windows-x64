                            <TextBlock Text="Policy status" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="WhyDrawerPolicyText" Text="Not available" Foreground="#E6E9ED" TextWrapping="Wrap" />
                            <TextBlock x:Name="WhyDrawerCooldownText" Text="Cooldowns: Not available" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1F25" BorderBrush="#262B33" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Latest action states" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="WhyDrawerActionStateText" Text="Not available" Foreground="#E6E9ED" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1F25" BorderBrush="#262B33" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Structured explanation" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="WhyDrawerContributorsSummaryText" Text="Contributors JSON: Not available" Foreground="#CBD5E1" TextWrapping="Wrap" />
                            <TextBlock x:Name="WhyDrawerWhySummaryText" Text="Why JSON: Not available" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="ConsentOverlay" Grid.ColumnSpan="2" Background="#CC020617" Visibility="Collapsed">
            <Grid>
                <Border Width="820" Padding="24" CornerRadius="12" Background="#111827" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PORTA Needs Consent" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Collection, inference, and regulation are OFF until you click I Agree." Foreground="#FCA5A5" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Collected (aggregated only)" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="- Keystroke timing intervals (events/min)" />
                                    <TextBlock Text="- Mouse acceleration index" />
                                    <TextBlock Text="- Scroll velocity index" />
                                    <TextBlock Text="- Focus switch frequency" />
                                    <TextBlock Text="- Idle fragmentation" />
                                    <TextBlock Text="- Notification reaction latency" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Never Collected" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="- Typed text" />
                                    <TextBlock Text="- Clipboard content" />
                                    <TextBlock Text="- Screenshots" />
                                    <TextBlock Text="- Files and file contents" />
                                    <TextBlock Text="- Messages" />
                                    <TextBlock Text="- Network content" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Retention window: 90 days local SQLite (configurable in later settings)." Margin="0,0,0,14" />
                        <WrapPanel>
                            <Button Content="I Agree" Padding="14,8" Margin="0,0,10,0" Click="AgreeConsentButton_Click" />
                            <Button Content="Pause" Padding="12,8" Margin="0,0,10,0" Click="PauseButton_Click" />
                            <Button Content="Revoke" Padding="12,8" Margin="0,0,10,0" Click="RevokeConsentButton_Click" />
                            <Button Content="Export Data" Padding="12,8" Margin="0,0,10,0" Click="ExportDataButton_Click" />
                            <Button Content="Delete Local Data" Padding="12,8" Click="DeleteLocalDataButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>


