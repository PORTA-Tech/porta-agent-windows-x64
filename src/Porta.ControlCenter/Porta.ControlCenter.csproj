<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.2.26</Version>
    <AssemblyVersion>1.2.26.0</AssemblyVersion>
    <FileVersion>1.2.26.0</FileVersion>
    <InformationalVersion>1.2.26</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\PortaAppIcon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Porta.Agent.Common\Porta.Agent.Common.csproj" />
    <ProjectReference Include="..\Porta.Agent.LocalApi\Porta.Agent.LocalApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PortaAppIcon.png" />
    <Resource Include="Assets\PortaSymbolWhite.png" />
  </ItemGroup>

</Project>
