<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>AriAgentInstaller</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.2</ProductVersion>
    <UpgradeCode>3f3d99ec-79c5-4721-b45e-7fb15be6dd62</UpgradeCode>
    <AriBackendUrlDefault Condition="'$(AriBackendUrlDefault)' == ''">https://porta-control-plane.onrender.com</AriBackendUrlDefault>
    <AriExeSource Condition="'$(AriExeSource)' == ''">$(MSBuildProjectDirectory)\payload\ari.exe</AriExeSource>
    <UserAgentExeSource Condition="'$(UserAgentExeSource)' == ''">$(MSBuildProjectDirectory)\payload\Porta.UserAgent.exe</UserAgentExeSource>
    <ControlCenterExeSource Condition="'$(ControlCenterExeSource)' == ''">$(MSBuildProjectDirectory)\payload\Porta.ControlCenter.exe</ControlCenterExeSource>
    <SharedPayloadSourceDir Condition="'$(SharedPayloadSourceDir)' == ''">$(MSBuildProjectDirectory)\payload\SharedFiles</SharedPayloadSourceDir>
    <DefineConstants>ProductVersion=$(ProductVersion);UpgradeCode=$(UpgradeCode);AriBackendUrlDefault=$(AriBackendUrlDefault);AriExeSource=$(AriExeSource);UserAgentExeSource=$(UserAgentExeSource);ControlCenterExeSource=$(ControlCenterExeSource);SharedPayloadSourceDir=$(SharedPayloadSourceDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <Target Name="EnsurePayloadHarvestDirectories" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(SharedPayloadSourceDir)" />
  </Target>

  <ItemGroup>
    <HarvestDirectory Include="$(SharedPayloadSourceDir)">
      <ComponentGroupName>SharedPayloadComponentGroup</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
      <PreprocessorVariable>SharedPayloadSourceDir</PreprocessorVariable>
    </HarvestDirectory>
    <BindPath Include="$(SharedPayloadSourceDir)" />
  </ItemGroup>
</Project>
