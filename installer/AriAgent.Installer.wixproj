<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>AriAgentInstaller</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <UpgradeCode>3f3d99ec-79c5-4721-b45e-7fb15be6dd62</UpgradeCode>
    <AriBackendUrlDefault Condition="'$(AriBackendUrlDefault)' == ''">https://porta-control-plane.onrender.com</AriBackendUrlDefault>
    <AriExeSource Condition="'$(AriExeSource)' == ''">$(MSBuildProjectDirectory)\payload\ari.exe</AriExeSource>
    <AriTrayExeSource Condition="'$(AriTrayExeSource)' == ''">$(MSBuildProjectDirectory)\payload\AriTray.exe</AriTrayExeSource>
    <DefineConstants>ProductVersion=$(ProductVersion);UpgradeCode=$(UpgradeCode);AriBackendUrlDefault=$(AriBackendUrlDefault);AriExeSource=$(AriExeSource);AriTrayExeSource=$(AriTrayExeSource)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
