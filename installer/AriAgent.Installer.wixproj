<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>AriAgentInstaller</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.2.2</ProductVersion>
    <UpgradeCode>3f3d99ec-79c5-4721-b45e-7fb15be6dd62</UpgradeCode>
    <AriBackendUrlDefault Condition="'$(AriBackendUrlDefault)' == ''">https://porta-control-plane.onrender.com</AriBackendUrlDefault>
    <AriExeSource Condition="'$(AriExeSource)' == ''">$(MSBuildProjectDirectory)\payload\ari.exe</AriExeSource>
    <UserAgentExeSource Condition="'$(UserAgentExeSource)' == ''">$(MSBuildProjectDirectory)\payload\Porta.UserAgent.exe</UserAgentExeSource>
    <ControlCenterExeSource Condition="'$(ControlCenterExeSource)' == ''">$(MSBuildProjectDirectory)\payload\Porta.ControlCenter.exe</ControlCenterExeSource>
    <DefineConstants>ProductVersion=$(ProductVersion);UpgradeCode=$(UpgradeCode);AriBackendUrlDefault=$(AriBackendUrlDefault);AriExeSource=$(AriExeSource);UserAgentExeSource=$(UserAgentExeSource);ControlCenterExeSource=$(ControlCenterExeSource)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <!--
    The HarvestDirectory for payload\SharedFiles was removed in 1.2.126, along with the
    ComponentGroupRef in Product.wxs and the WixToolset.Heat package reference that only
    existed to serve it. See the comment in Product.wxs for why: the directory had been a
    fossil since single-file publish was adopted, and the three exes carry everything they
    need. build-1296.ps1 asserts that publish still emits no loose files, so this cannot
    regress silently if someone turns PublishSingleFile off.
  -->
</Project>
