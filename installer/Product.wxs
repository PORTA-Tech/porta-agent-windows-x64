<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Ari Agent"
           Manufacturer="PORTA"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Language="1033">
    <SummaryInformation Description="Ari Agent Windows Service Installer" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer Ari Agent version is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="PORTA_BACKEND_URL" Value="$(var.AriBackendUrlDefault)" />
    <Property Id="WixUnelevatedShellExecTarget" Value="[#ControlCenterExeFile]" />

    <util:CloseApplication Id="CloseUserAgent"
                           Target="Porta.UserAgent.exe"
                           Description="Closing the Ari desktop widget before upgrade."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="10"
                           TerminateProcess="0" />

    <util:CloseApplication Id="CloseControlCenter"
                           Target="Porta.ControlCenter.exe"
                           Description="Closing PORTA Control Center before upgrade."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="10"
                           TerminateProcess="0" />

    <!-- Disable SCM recovery for AriAgent before stopping it.
         Without this, the SCM auto-restarts ari.exe after the stop-timeout force-kill,
         re-locking the file before InstallFiles can replace it.
         WixQuietExec runs the sc.exe command elevated and deferred, before StopServices.
         ServiceConfig on the new component re-enables recovery after install. -->
    <SetProperty Id="WixQuietExecCmdLine"
                 Value='"[System64Folder]sc.exe" failure AriAgent reset= 0 actions= none'
                 Before="CM_DisableAriRecovery"
                 Sequence="execute" />
    <CustomAction Id="CM_DisableAriRecovery"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- After service stop, kill any orphaned ari.exe process so InstallFiles can replace it. -->
    <util:CloseApplication Id="CloseAriAgentProcess"
                           Target="ari.exe"
                           Description="Terminating Ari Agent process before file replacement."
                           CloseMessage="no"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="15"
                           TerminateProcess="5" />



    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Ari">
        <Component Id="AriExeComponent" Guid="0364a772-0f3d-4440-a3df-89fcfd474226">
          <File Id="AriExeFile"
                Name="ari.exe"
                Source="$(var.AriExeSource)"
                KeyPath="yes"
                Checksum="yes" />

          <ServiceInstall Id="AriAgentServiceInstall"
                          Name="AriAgent"
                          DisplayName="Ari Agent"
                          Description="PORTA Ari Agent Windows Service"
                          Start="auto"
                          Type="ownProcess"
                          ErrorControl="normal"
                          Vital="yes" />

          <ServiceControl Id="AriAgentServiceControl"
                          Name="AriAgent"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />

          <Environment Id="AriBackendUrlEnvironment"
                       Name="PORTA_BACKEND_URL"
                       Value="[PORTA_BACKEND_URL]"
                       Action="set"
                       Part="all"
                       System="yes" />

          <RegistryValue Root="HKLM"
                         Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                         Name="PORTA_BACKEND_URL"
                         Type="string"
                         Value="[PORTA_BACKEND_URL]" />

          <util:ServiceConfig ServiceName="AriAgent"
                              FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="15"
                              ResetPeriodInDays="1" />
        </Component>

        <Component Id="UserAgentExeComponent" Guid="1a2578a3-148d-4e63-bb5d-4042d3f6db8b">
          <File Id="UserAgentExeFile"
                Name="Porta.UserAgent.exe"
                Source="$(var.UserAgentExeSource)"
                KeyPath="yes"
                Checksum="yes" />
        </Component>

        <Component Id="UserAgentStartupEntryComponent" Guid="48f29402-8a6c-4bde-a4c6-30e1f4d9a453">
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="PORTA User Agent"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]Porta.UserAgent.exe&quot; --startup-source=run-key"
                         KeyPath="yes" />
        </Component>

        <Component Id="ControlCenterExeComponent" Guid="6e130eaf-0f3a-4ca3-89f3-a4ea63f2b383">
          <File Id="ControlCenterExeFile"
                Name="Porta.ControlCenter.exe"
                Source="$(var.ControlCenterExeSource)"
                KeyPath="yes"
                Checksum="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AriProgramMenuFolder" Name="PORTA">
        <Component Id="ControlCenterShortcutComponent" Guid="793eb375-d584-408c-a9c9-fea663f1ac94">
          <Shortcut Id="ControlCenterShortcut"
                    Name="PORTA Control Center"
                    Description="Open PORTA Control Center. Ari keeps running in the background."
                    Target="[INSTALLFOLDER]Porta.ControlCenter.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAriProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\PORTA\AriAgent"
                         Name="MenuShortcutsInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="150d2e79-b80d-4697-b0a5-0d3571fc2b3d">
        <Shortcut Id="DesktopControlCenterShortcut"
                  Name="PORTA"
                  Description="Open PORTA. Ari keeps running in the background."
                  Target="[INSTALLFOLDER]Porta.ControlCenter.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\PORTA\AriAgent"
                       Name="DesktopShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <CustomAction Id="LaunchControlCenterAfterInstall"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixUnelevatedShellExec"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Disable SCM recovery before stopping the service, so a stop-timeout force-kill
           does not trigger an auto-restart that re-locks ari.exe before InstallFiles runs. -->
      <Custom Action="CM_DisableAriRecovery" Before="StopServices" />
      <Custom Action="LaunchControlCenterAfterInstall"
              After="InstallFinalize"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND UILevel &gt;= 5" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="Ari Agent" Level="1">
      <ComponentRef Id="AriExeComponent" />
      <ComponentRef Id="UserAgentExeComponent" />
      <ComponentRef Id="UserAgentStartupEntryComponent" />
      <ComponentRef Id="ControlCenterExeComponent" />
      <ComponentRef Id="ControlCenterShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentGroupRef Id="SharedPayloadComponentGroup" />
    </Feature>
  </Package>
</Wix>
