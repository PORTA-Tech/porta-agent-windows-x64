<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Ari Agent"
           Manufacturer="PORTA"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Language="1033">
    <SummaryInformation Description="Ari Agent Installer" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer Ari Agent version is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="PORTA_BACKEND_URL" Value="$(var.AriBackendUrlDefault)" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Ari">
        <Component Id="AriExeComponent" Guid="0364a772-0f3d-4440-a3df-89fcfd474226">
          <File Id="AriExeFile"
                Name="ari.exe"
                Source="$(var.AriExeSource)"
                KeyPath="yes"
                Checksum="yes" />
          <File Id="AriServiceConfigFile"
                Name="appsettings.json"
                Source="$(var.AriServiceConfigSource)"
                Checksum="yes" />

          <ServiceInstall Id="AriAgentServiceInstall"
                          Name="AriAgent"
                          DisplayName="Ari Agent"
                          Description="PORTA Ari Agent Windows Service"
                          Start="auto"
                          Type="ownProcess"
                          ErrorControl="normal"
                          Vital="yes" />

          <ServiceControl Id="AriAgentServiceControl"
                          Name="AriAgent"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />

          <Environment Id="AriBackendUrlEnvironment"
                       Name="PORTA_BACKEND_URL"
                       Value="[PORTA_BACKEND_URL]"
                       Action="set"
                       Part="all"
                       System="yes" />

          <RegistryValue Root="HKLM"
                         Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                         Name="PORTA_BACKEND_URL"
                         Type="string"
                         Value="[PORTA_BACKEND_URL]" />

          <util:ServiceConfig ServiceName="AriAgent"
                              FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="15"
                              ResetPeriodInDays="1" />
        </Component>

        <Component Id="AriTrayExeComponent" Guid="2fb53371-1182-4e4f-8d8d-818a86ff0d8b">
          <File Id="AriTrayExeFile"
                Name="AriTray.exe"
                Source="$(var.AriTrayExeSource)"
                KeyPath="yes"
                Checksum="yes" />
        </Component>

        <Component Id="AriControlCenterExeComponent" Guid="e4c48a31-8a8a-4e7b-9f1d-8e7eb126e4d2">
          <File Id="AriControlCenterExeFile"
                Name="Porta.ControlCenter.exe"
                Source="$(var.AriControlCenterExeSource)"
                KeyPath="yes"
                Checksum="yes" />
        </Component>

        <Component Id="AriStartupRunKeyComponent" Guid="b86845f4-121d-4680-972c-a791b2cd1254">
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="PORTA Tray"
                         Type="string"
                         Value="[INSTALLFOLDER]AriTray.exe"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AriProgramMenuFolder" Name="PORTA">
        <Component Id="AriStartMenuShortcutComponent" Guid="d3783879-1f23-4203-8a5b-a6f40148a788">
          <Shortcut Id="AriStartMenuShortcut"
                    Name="PORTA Control Center"
                    Description="Open PORTA Control Center"
                    Target="[INSTALLFOLDER]Porta.ControlCenter.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAriProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\PORTA\AriAgent"
                         Name="StartMenuShortcutInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="AriDesktopShortcutComponent" Guid="080d7d7e-e962-4a2b-bfd3-d07b5b3378cd">
        <Shortcut Id="AriDesktopShortcut"
                  Name="Ari Agent"
                  Description="Launch Ari Agent user interface"
                  Target="[INSTALLFOLDER]AriTray.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\PORTA\AriAgent"
                       Name="DesktopShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <CustomAction Id="LaunchAriTrayAfterInstall"
                  FileRef="AriTrayExeFile"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait"
                  Impersonate="yes" />
    <CustomAction Id="LaunchPortaControlCenterAfterInstall"
                  FileRef="AriControlCenterExeFile"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="LaunchAriTrayAfterInstall"
              After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE AND UILevel >= 5" />
      <Custom Action="LaunchPortaControlCenterAfterInstall"
              After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE AND UILevel >= 5" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />

    <Feature Id="MainFeature" Title="Ari Agent" Level="1">
      <ComponentRef Id="AriExeComponent" />
      <ComponentRef Id="AriTrayExeComponent" />
      <ComponentRef Id="AriControlCenterExeComponent" />
      <ComponentRef Id="AriStartupRunKeyComponent" />
      <ComponentRef Id="AriStartMenuShortcutComponent" />
      <ComponentRef Id="AriDesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
