<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Ari Agent"
           Manufacturer="PORTA"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Language="1033">
    <SummaryInformation Description="Ari Agent Windows Service Installer" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer Ari Agent version is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="PORTA_BACKEND_URL" Value="$(var.AriBackendUrlDefault)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Ari">
        <Component Id="AriExeComponent" Guid="0364a772-0f3d-4440-a3df-89fcfd474226">
          <File Id="AriExeFile"
                Name="ari.exe"
                Source="$(var.AriExeSource)"
                KeyPath="yes"
                Checksum="yes" />

          <ServiceInstall Id="AriAgentServiceInstall"
                          Name="AriAgent"
                          DisplayName="Ari Agent"
                          Description="PORTA Ari Agent Windows Service"
                          Start="auto"
                          Type="ownProcess"
                          ErrorControl="normal"
                          Vital="yes" />

          <ServiceControl Id="AriAgentServiceControl"
                          Name="AriAgent"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />

          <Environment Id="AriBackendUrlEnvironment"
                       Name="PORTA_BACKEND_URL"
                       Value="[PORTA_BACKEND_URL]"
                       Action="set"
                       Part="all"
                       System="yes" />

          <RegistryValue Root="HKLM"
                         Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                         Name="PORTA_BACKEND_URL"
                         Type="string"
                         Value="[PORTA_BACKEND_URL]" />

          <util:ServiceConfig ServiceName="AriAgent"
                              FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="15"
                              ResetPeriodInDays="1" />
        </Component>

        <Component Id="AriTrayExeComponent" Guid="39fe7047-c950-42cb-9816-4d24d698fa34">
          <File Id="AriTrayExeFile"
                Name="AriTray.exe"
                Source="$(var.AriTrayExeSource)"
                KeyPath="yes"
                Checksum="yes" />
        </Component>

        <Component Id="ControlCenterExeComponent" Guid="6e130eaf-0f3a-4ca3-89f3-a4ea63f2b383">
          <File Id="ControlCenterExeFile"
                Name="Porta.ControlCenter.exe"
                Source="$(var.ControlCenterExeSource)"
                KeyPath="yes"
                Checksum="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AriProgramMenuFolder" Name="PORTA">
        <Component Id="ControlCenterShortcutComponent" Guid="793eb375-d584-408c-a9c9-fea663f1ac94">
          <Shortcut Id="ControlCenterShortcut"
                    Name="PORTA Control Center"
                    Description="Open PORTA Control Center"
                    Target="[INSTALLFOLDER]Porta.ControlCenter.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="TrayShortcut"
                    Name="PORTA Tray"
                    Description="Open PORTA Tray"
                    Target="[INSTALLFOLDER]AriTray.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAriProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM"
                         Key="Software\PORTA\AriAgent"
                         Name="MenuShortcutsInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Ari Agent" Level="1">
      <ComponentRef Id="AriExeComponent" />
      <ComponentRef Id="AriTrayExeComponent" />
      <ComponentRef Id="ControlCenterExeComponent" />
      <ComponentRef Id="ControlCenterShortcutComponent" />
    </Feature>
  </Package>
</Wix>
